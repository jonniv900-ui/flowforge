      "Code": "Imports System\nImports System.Drawing\nImports System.Text.RegularExpressions\nImports System.Windows.Forms\n\nPublic Class StatisticsForm\n    Inherits Form\n\n    Private info As Label\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Estatísticas do documento\"\n        Me.Width = 420\n        Me.Height = 330\n        Me.FormBorderStyle = FormBorderStyle.FixedDialog\n        Me.StartPosition = FormStartPosition.CenterParent\n        Me.MaximizeBox = False\n        Me.MinimizeBox = False\n\n        info = New Label()\n        info.Location = New Point(24, 22)\n        info.Size = New Size(350, 220)\n        info.Font = New Font(\"Segoe UI\", 11.0F)\n        Me.Controls.Add(info)\n\n        Dim closeBtn As New Button()\n        closeBtn.Text = \"Fechar\"\n        closeBtn.DialogResult = DialogResult.OK\n        closeBtn.Location = New Point(292, 250)\n        Me.Controls.Add(closeBtn)\n    End Sub\n\n    Public Sub LoadStatistics(text As String)\n        Dim words As Integer = Regex.Matches(text, \"\\b[\\p{L}\\p{N}]+\\b\").Count\n        Dim lines As Integer = If(text.Length = 0, 0, text.Split(New String() {Environment.NewLine}, StringSplitOptions.None).Length)\n        Dim paragraphs As Integer = Regex.Matches(text.Trim(), \"(\\r?\\n\\s*){2,}\").Count + If(text.Trim().Length > 0, 1, 0)\n        Dim charsNoSpaces As Integer = Regex.Replace(text, \"\\s\", \"\").Length\n        Dim readingMinutes As Double = words / 200.0\n\n        info.Text =\n            \"Palavras: \" & words.ToString() & Environment.NewLine &\n            \"Caracteres: \" & text.Length.ToString() & Environment.NewLine &\n            \"Caracteres sem espaços: \" & charsNoSpaces.ToString() & Environment.NewLine &\n            \"Linhas: \" & lines.ToString() & Environment.NewLine &\n            \"Parágrafos: \" & paragraphs.ToString() & Environment.NewLine &\n            \"Tempo estimado de leitura: \" & readingMinutes.ToString(\"0.0\") & \" min\"\n    End Sub\nEnd Class\n"
