      "Controls": [],
      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPublic Class FindReplaceForm\n    Inherits Form\n\n    Private target As RichTextBox\n    Private findText As TextBox\n    Private replaceText As TextBox\n    Private replaceLabel As Label\n    Private replaceButton As Button\n    Private replaceAllButton As Button\n    Private caseBox As CheckBox\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Localizar e substituir\"\n        Me.FormBorderStyle = FormBorderStyle.FixedToolWindow\n        Me.Width = 470\n        Me.Height = 230\n        Me.StartPosition = FormStartPosition.CenterParent\n\n        Dim l1 As New Label()\n        l1.Text = \"Localizar:\"\n        l1.Location = New Point(12, 18)\n        l1.AutoSize = True\n        Me.Controls.Add(l1)\n\n        findText = New TextBox()\n        findText.Location = New Point(100, 15)\n        findText.Width = 335\n        Me.Controls.Add(findText)\n\n        replaceLabel = New Label()\n        replaceLabel.Text = \"Substituir:\"\n        replaceLabel.Location = New Point(12, 55)\n        replaceLabel.AutoSize = True\n        Me.Controls.Add(replaceLabel)\n\n        replaceText = New TextBox()\n        replaceText.Location = New Point(100, 52)\n        replaceText.Width = 335\n        Me.Controls.Add(replaceText)\n\n        caseBox = New CheckBox()\n        caseBox.Text = \"Diferenciar maiúsculas/minúsculas\"\n        caseBox.Location = New Point(100, 85)\n        caseBox.Width = 260\n        Me.Controls.Add(caseBox)\n\n        Dim nextButton As New Button()\n        nextButton.Text = \"Localizar próxima\"\n        nextButton.Location = New Point(100, 122)\n        nextButton.Width = 120\n        AddHandler nextButton.Click, AddressOf FindNext\n        Me.Controls.Add(nextButton)\n\n        replaceButton = New Button()\n        replaceButton.Text = \"Substituir\"\n        replaceButton.Location = New Point(225, 122)\n        replaceButton.Width = 100\n        AddHandler replaceButton.Click, AddressOf ReplaceOne\n        Me.Controls.Add(replaceButton)\n\n        replaceAllButton = New Button()\n        replaceAllButton.Text = \"Substituir tudo\"\n        replaceAllButton.Location = New Point(330, 122)\n        replaceAllButton.Width = 105\n        AddHandler replaceAllButton.Click, AddressOf ReplaceAll\n        Me.Controls.Add(replaceAllButton)\n    End Sub\n\n    Public Sub SetEditor(value As RichTextBox)\n        target = value\n    End Sub\n\n    Public Sub SetReplaceMode(value As Boolean)\n        replaceLabel.Visible = value\n        replaceText.Visible = value\n        replaceButton.Visible = value\n        replaceAllButton.Visible = value\n        Me.Text = If(value, \"Substituir\", \"Localizar\")\n    End Sub\n\n    Private Function Comparison() As StringComparison\n        Return If(caseBox.Checked, StringComparison.CurrentCulture, StringComparison.CurrentCultureIgnoreCase)\n    End Function\n\n    Private Sub FindNext(sender As Object, e As EventArgs)\n        If target Is Nothing OrElse findText.Text.Length = 0 Then Return\n        Dim start As Integer = target.SelectionStart + target.SelectionLength\n        Dim index As Integer = target.Text.IndexOf(findText.Text, start, Comparison())\n        If index < 0 AndAlso start > 0 Then index = target.Text.IndexOf(findText.Text, 0, Comparison())\n        If index >= 0 Then\n            target.Select(index, findText.Text.Length)\n            target.ScrollToCaret()\n            target.Focus()\n        Else\n            MessageBox.Show(\"Texto não encontrado.\", \"Localizar\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n        End If\n    End Sub\n\n    Private Sub ReplaceOne(sender As Object, e As EventArgs)\n        If target Is Nothing Then Return\n        If String.Equals(target.SelectedText, findText.Text, Comparison()) Then\n            target.SelectedText = replaceText.Text\n        End If\n        FindNext(sender, e)\n    End Sub\n\n    Private Sub ReplaceAll(sender As Object, e As EventArgs)\n        If target Is Nothing OrElse findText.Text.Length = 0 Then Return\n        Dim source As String = target.Text\n        Dim count As Integer = 0\n        Dim pos As Integer = 0\n        Dim result As New System.Text.StringBuilder()\n\n        While pos < source.Length\n            Dim found As Integer = source.IndexOf(findText.Text, pos, Comparison())\n            If found < 0 Then\n                result.Append(source.Substring(pos))\n                Exit While\n            End If\n            result.Append(source.Substring(pos, found - pos))\n            result.Append(replaceText.Text)\n            pos = found + findText.Text.Length\n            count += 1\n        End While\n\n        If pos = source.Length Then\n            ' Nada adicional precisa ser copiado.\n        End If\n\n        target.Text = result.ToString()\n        MessageBox.Show(count.ToString() & \" ocorrência(s) substituída(s).\", \"Substituir\")\n    End Sub\nEnd Class\n"
    },
