      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPublic Class SymbolsForm\n    Inherits Form\n\n    Public Property SelectedSymbol As String = String.Empty\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Inserir símbolo\"\n        Me.Width = 500\n        Me.Height = 350\n        Me.StartPosition = FormStartPosition.CenterParent\n\n        Dim list As New ListBox()\n        list.Dock = DockStyle.Fill\n        list.Font = New Font(\"Segoe UI Symbol\", 18.0F)\n        list.MultiColumn = True\n        list.ColumnWidth = 70\n\n        Dim symbols As String() = {\n            \"©\", \"®\", \"™\", \"€\", \"£\", \"¥\", \"¢\", \"§\", \"¶\", \"°\",\n            \"±\", \"×\", \"÷\", \"≈\", \"≠\", \"≤\", \"≥\", \"∞\", \"√\", \"π\",\n            \"α\", \"β\", \"γ\", \"δ\", \"Ω\", \"µ\", \"→\", \"←\", \"↑\", \"↓\",\n            \"✓\", \"✗\", \"★\", \"☆\", \"♥\", \"♦\", \"♣\", \"♠\", \"♪\", \"♫\",\n            \"¼\", \"½\", \"¾\", \"²\", \"³\", \"…\", \"–\", \"—\", \"«\", \"»\"\n        }\n\n        For Each s As String In symbols\n            list.Items.Add(s)\n        Next\n\n        AddHandler list.DoubleClick,\n            Sub(sender As Object, e As EventArgs)\n                If list.SelectedItem Is Nothing Then Return\n                SelectedSymbol = list.SelectedItem.ToString()\n                Me.DialogResult = DialogResult.OK\n                Me.Close()\n            End Sub\n\n        Me.Controls.Add(list)\n\n        Dim bottom As New Panel()\n        bottom.Dock = DockStyle.Bottom\n        bottom.Height = 45\n\n        Dim insertBtn As New Button()\n        insertBtn.Text = \"Inserir\"\n        insertBtn.Location = New Point(315, 8)\n        AddHandler insertBtn.Click,\n            Sub(sender As Object, e As EventArgs)\n                If list.SelectedItem Is Nothing Then Return\n                SelectedSymbol = list.SelectedItem.ToString()\n                Me.DialogResult = DialogResult.OK\n            End Sub\n        bottom.Controls.Add(insertBtn)\n\n        Dim cancelBtn As New Button()\n        cancelBtn.Text = \"Cancelar\"\n        cancelBtn.DialogResult = DialogResult.Cancel\n        cancelBtn.Location = New Point(395, 8)\n        bottom.Controls.Add(cancelBtn)\n\n        Me.Controls.Add(bottom)\n        bottom.BringToFront()\n    End Sub\nEnd Class\n"
    },
