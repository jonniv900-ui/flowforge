      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPublic Class HelpForm\n    Inherits Form\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Ajuda - FlowWriter\"\n        Me.Width = 700\n        Me.Height = 540\n        Me.StartPosition = FormStartPosition.CenterParent\n\n        Dim tabs As New TabControl()\n        tabs.Dock = DockStyle.Fill\n\n        tabs.TabPages.Add(MakePage(\"Primeiros passos\",\n            \"NOVO, ABRIR E SALVAR\" & Environment.NewLine & Environment.NewLine &\n            \"Use Ctrl+N para iniciar um documento, Ctrl+O para abrir e Ctrl+S para salvar.\" &\n            Environment.NewLine & Environment.NewLine &\n            \"RTF preserva fontes, estilos, cores e alinhamento. TXT salva somente o texto.\"))\n\n        tabs.TabPages.Add(MakePage(\"Formatação\",\n            \"Selecione o texto e use a barra de ferramentas ou o menu Formatar.\" &\n            Environment.NewLine & Environment.NewLine &\n            \"Há fonte, tamanho, negrito, itálico, sublinhado, tachado, cores, realce, alinhamento e marcadores.\"))\n\n        tabs.TabPages.Add(MakePage(\"Pesquisa\",\n            \"Ctrl+F abre Localizar. Ctrl+H abre Localizar e Substituir.\" &\n            Environment.NewLine & Environment.NewLine &\n            \"Ctrl+G permite ir diretamente a uma linha do documento.\"))\n\n        tabs.TabPages.Add(MakePage(\"Impressão\",\n            \"Arquivo > Configurar página define margens e papel.\" &\n            Environment.NewLine & Environment.NewLine &\n            \"Use Visualizar impressão antes de imprimir o documento.\"))\n\n        tabs.TabPages.Add(MakePage(\"Atalhos\",\n            \"Ctrl+N  Novo\" & Environment.NewLine &\n            \"Ctrl+O  Abrir\" & Environment.NewLine &\n            \"Ctrl+S  Salvar\" & Environment.NewLine &\n            \"Ctrl+P  Imprimir\" & Environment.NewLine &\n            \"Ctrl+F  Localizar\" & Environment.NewLine &\n            \"Ctrl+H  Substituir\" & Environment.NewLine &\n            \"Ctrl+G  Ir para linha\" & Environment.NewLine &\n            \"Ctrl+B/I/U  Estilos\" & Environment.NewLine &\n            \"F5  Data e hora\" & Environment.NewLine &\n            \"F11  Tela cheia\"))\n\n        Me.Controls.Add(tabs)\n    End Sub\n\n    Private Function MakePage(title As String, content As String) As TabPage\n        Dim page As New TabPage(title)\n        Dim box As New TextBox()\n        box.Multiline = True\n        box.ReadOnly = True\n        box.BorderStyle = BorderStyle.None\n        box.Dock = DockStyle.Fill\n        box.ScrollBars = ScrollBars.Vertical\n        box.Font = New Font(\"Segoe UI\", 11.0F)\n        box.BackColor = Color.White\n        box.Text = content\n        page.Padding = New Padding(18)\n        page.Controls.Add(box)\n        Return page\n    End Function\nEnd Class\n"
    },
