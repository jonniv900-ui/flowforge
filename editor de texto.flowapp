      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPublic Class AboutForm\n    Inherits Form\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Sobre o FlowWriter\"\n        Me.Width = 480\n        Me.Height = 330\n        Me.FormBorderStyle = FormBorderStyle.FixedDialog\n        Me.StartPosition = FormStartPosition.CenterParent\n        Me.MaximizeBox = False\n        Me.MinimizeBox = False\n\n        Dim title As New Label()\n        title.Text = \"FlowWriter\"\n        title.Font = New Font(\"Segoe UI\", 25.0F, FontStyle.Bold)\n        title.Location = New Point(30, 25)\n        title.Size = New Size(400, 50)\n        Me.Controls.Add(title)\n\n        Dim text As New Label()\n        text.Text =\n            \"Editor de texto completo criado no FlowForge.\" & Environment.NewLine &\n            \"Versão 1.0.0\" & Environment.NewLine & Environment.NewLine &\n            \"Suporte a RTF e TXT, formatação, pesquisa, substituição,\" & Environment.NewLine &\n            \"estatísticas, símbolos, impressão e múltiplos formulários.\" & Environment.NewLine & Environment.NewLine &\n            \"2026 Wtec\"\n        text.Font = New Font(\"Segoe UI\", 10.5F)\n        text.Location = New Point(34, 90)\n        text.Size = New Size(400, 145)\n        Me.Controls.Add(text)\n\n        Dim ok As New Button()\n        ok.Text = \"OK\"\n        ok.DialogResult = DialogResult.OK\n        ok.Location = New Point(350, 245)\n        Me.Controls.Add(ok)\n        Me.AcceptButton = ok\n    End Sub\nEnd Class\n"
    }
