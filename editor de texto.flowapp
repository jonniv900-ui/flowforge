      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPublic Class GoToLineForm\n    Inherits Form\n\n    Private number As NumericUpDown\n    Public Property MaximumLine As Integer\n        Get\n            Return CInt(number.Maximum)\n        End Get\n        Set(value As Integer)\n            number.Maximum = Math.Max(1, value)\n        End Set\n    End Property\n\n    Public ReadOnly Property SelectedLine As Integer\n        Get\n            Return CInt(number.Value)\n        End Get\n    End Property\n\n    Private Sub BuildRuntimeInterface() Handles MyBase.Load\n        Me.Text = \"Ir para linha\"\n        Me.FormBorderStyle = FormBorderStyle.FixedDialog\n        Me.Width = 300\n        Me.Height = 150\n        Me.StartPosition = FormStartPosition.CenterParent\n        Me.MaximizeBox = False\n        Me.MinimizeBox = False\n\n        Dim label As New Label()\n        label.Text = \"Número da linha:\"\n        label.Location = New Point(15, 18)\n        label.AutoSize = True\n        Me.Controls.Add(label)\n\n        number = New NumericUpDown()\n        number.Location = New Point(18, 45)\n        number.Width = 250\n        number.Minimum = 1\n        number.Maximum = 1\n        Me.Controls.Add(number)\n\n        Dim ok As New Button()\n        ok.Text = \"OK\"\n        ok.DialogResult = DialogResult.OK\n        ok.Location = New Point(112, 78)\n        Me.Controls.Add(ok)\n\n        Dim cancelBtn As New Button()\n        cancelBtn.Text = \"Cancelar\"\n        cancelBtn.DialogResult = DialogResult.Cancel\n        cancelBtn.Location = New Point(193, 78)\n        Me.Controls.Add(cancelBtn)\n\n        Me.AcceptButton = ok\n        Me.CancelButton = cancelBtn\n    End Sub\nEnd Class\n"
