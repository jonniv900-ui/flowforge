  "AssemblyDescription": "Jogo da Forca com pacote de palavras integrado",
  "AssemblyProduct": "JogoDaForcaVB",
  "AssemblyTitle": "JogoDaForcaVB",
  "AssemblyTrademark": "",
  "AssemblyVersion": "1.0.0.0",
  "FileVersion": "1.0.0.0",
  "Forms": [
    {
      "Code": "Imports System\nImports System.Collections.Generic\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private palavras As New System.Collections.Generic.Dictionary(Of String, String) From {\n        {\"COMPUTADOR\", \"Hardware e processamento\"},\n        {\"PROGRAMACAO\", \"Logica e desenvolvimento de software\"},\n        {\"PYTHON\", \"Linguagem de programacao de alto nivel\"},\n        {\"BASICO\", \"Linguagem classica e inicial\"},\n        {\"TECLADO\", \"Periferico de entrada com teclas\"},\n        {\"MONITOR\", \"Tela de video ou exibicao\"},\n        {\"INTERNET\", \"Rede mundial de computadores\"},\n        {\"ENGENHARIA\", \"Aplicacao de ciencias e matematica\"},\n        {\"ALGORITMO\", \"Sequencia de passos lógicos\"},\n        {\"HARDWARE\", \"Partes fisicas do computador\"}\n    }\n\n    Private palavraAtual As String = \"\"\n    Private dicaAtual As String = \"\"\n    Private letrasAdivinhadas As List(Of Char)\n    Private letrasErradas As List(Of Char)\n    Private erros As Integer = 0\n    Private maxErros As Integer = 6\n    Private rand As New Random()\n\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\n        SortearNovaPalavra()\n    End Sub\n\n    Private Sub SortearNovaPalavra()\n        Dim chaves As New List(Of String)(palavras.Keys)\n        palavraAtual = chaves(rand.Next(chaves.Count))\n        dicaAtual = palavras(palavraAtual)\n\n        letrasAdivinhadas = New List(Of Char)()\n        letrasErradas = New List(Of Char)()\n        erros = 0\n\n        lblDicaTitulo.Text = \"Dica: \" & dicaAtual\n        lblErros.Text = \"Erros: \" & erros & \" / \" & maxErros\n        lblLetrasErradas.Text = \"\"\n        txtLetra.Text = \"\"\n        txtLetra.Enabled = True\n        btnTentar.Enabled = True\n\n        AtualizarDisplay()\n    End Sub\n\n    Private Sub AtualizarDisplay()\n        Dim display As String = \"\"\n        For Each c As Char In palavraAtual\n            If letrasAdivinhadas.Contains(c) Then\n                display &= c & \" \"\n            Else\n                display &= \"_ \"\n            End If\n        Next\n        lblPalavraSecreta.Text = display.Trim()\n    End Sub\n\n    Private Sub btnTentar_Click(sender As Object, e As System.EventArgs) Handles btnTentar.Click\n        If txtLetra.Text.Length = 0 Then Return\n\n        Dim letra As Char = Char.ToUpper(txtLetra.Text(0))\n        txtLetra.Text = \"\"\n        txtLetra.Focus()\n\n        If Not Char.IsLetter(letra) Then Return\n\n        If letrasAdivinhadas.Contains(letra) OrElse letrasErradas.Contains(letra) Then\n            MessageBox.Show(\"Voce ja tentou esta letra!\", \"Aviso\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n            Return\n        End If\n\n        If palavraAtual.Contains(letra) Then\n            letrasAdivinhadas.Add(letra)\n            AtualizarDisplay()\n\n            ' Verifica se venceu\n            Dim ganhou As Boolean = True\n            For Each c As Char In palavraAtual\n                If Not letrasAdivinhadas.Contains(c) Then\n                    ganhou = False\n                    Exit For\n                End If\n            Next\n\n            If ganhou Then\n                MessageBox.Show(\"Parabens! Voce acertou a palavra: \" & palavraAtual, \"Vitoria\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n                txtLetra.Enabled = False\n                btnTentar.Enabled = False\n            End If\n        Else\n            letrasErradas.Add(letra)\n            erros += 1\n            lblErros.Text = \"Erros: \" & erros & \" / \" & maxErros\n            \n            Dim errStr As String = \"\"\n            For Each l As Char In letrasErradas\n                errStr &= l & \" \"\n            Next\n            lblLetrasErradas.Text = errStr.Trim()\n\n            If erros >= maxErros Then\n                MessageBox.Show(\"Fim de jogo! A palavra correta era: \" & palavraAtual, \"Derrota\", MessageBoxButtons.OK, MessageBoxIcon.Error)\n                lblPalavraSecreta.Text = String.Join(\" \", palavraAtual.ToCharArray())\n                txtLetra.Enabled = False\n                btnTentar.Enabled = False\n            End If\n        End If\n    End Sub\n\n    Private Sub btnNovoJogo_Click(sender As Object, e As System.EventArgs) Handles btnNovoJogo.Click\n        SortearNovaPalavra()\n    End Sub\n\nEnd Class",
