{"Name":"Calculadora","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Calculadora"},{"Key":"ClientSize","Value":"320, 430"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"FixedSingle"},{"Key":"BackColor","Value":"White"},{"Key":"Font","Value":"Segoe UI, 9pt"},{"Key":"MaximizeBox","Value":"False"},{"Key":"MinimizeBox","Value":"True"},{"Key":"KeyPreview","Value":"False"}],"Controls":[{"TypeName":"TextBox","Name":"TextBoxVisor","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TextBoxVisor"},{"Key":"Location","Value":"20, 20"},{"Key":"Size","Value":"280, 50"},{"Key":"Font","Value":"Segoe UI, 20pt"},{"Key":"TextAlign","Value":"Right"},{"Key":"ReadOnly","Value":"True"},{"Key":"TabStop","Value":"False"},{"Key":"BackColor","Value":"White"}],"Items":[]},{"TypeName":"Button","Name":"Btn7","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn7"},{"Key":"Location","Value":"20, 90"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"7"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn8","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn8"},{"Key":"Location","Value":"90, 90"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"8"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn9","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn9"},{"Key":"Location","Value":"160, 90"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"9"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"BtnDividir","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnDividir"},{"Key":"Location","Value":"230, 90"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"/"},{"Key":"Font","Value":"Segoe UI, 14pt"},{"Key":"BackColor","Value":"Gainsboro"}],"Items":[]},{"TypeName":"Button","Name":"Btn4","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn4"},{"Key":"Location","Value":"20, 160"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"4"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn5","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn5"},{"Key":"Location","Value":"90, 160"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"5"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn6","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn6"},{"Key":"Location","Value":"160, 160"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"6"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"BtnMultiplicar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnMultiplicar"},{"Key":"Location","Value":"230, 160"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"*"},{"Key":"Font","Value":"Segoe UI, 14pt"},{"Key":"BackColor","Value":"Gainsboro"}],"Items":[]},{"TypeName":"Button","Name":"Btn1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn1"},{"Key":"Location","Value":"20, 230"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"1"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn2","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn2"},{"Key":"Location","Value":"90, 230"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"2"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"Btn3","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn3"},{"Key":"Location","Value":"160, 230"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"3"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"BtnSubtrair","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnSubtrair"},{"Key":"Location","Value":"230, 230"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"-"},{"Key":"Font","Value":"Segoe UI, 14pt"},{"Key":"BackColor","Value":"Gainsboro"}],"Items":[]},{"TypeName":"Button","Name":"Btn0","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"Btn0"},{"Key":"Location","Value":"20, 300"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"0"},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"BtnPonto","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnPonto"},{"Key":"Location","Value":"90, 300"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"."},{"Key":"Font","Value":"Segoe UI, 14pt"}],"Items":[]},{"TypeName":"Button","Name":"BtnIgual","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnIgual"},{"Key":"Location","Value":"160, 300"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"="},{"Key":"Font","Value":"Segoe UI, 14pt"},{"Key":"BackColor","Value":"MediumSeaGreen"},{"Key":"ForeColor","Value":"White"}],"Items":[]},{"TypeName":"Button","Name":"BtnSomar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnSomar"},{"Key":"Location","Value":"230, 300"},{"Key":"Size","Value":"60, 60"},{"Key":"Text","Value":"+"},{"Key":"Font","Value":"Segoe UI, 14pt"},{"Key":"BackColor","Value":"Gainsboro"}],"Items":[]},{"TypeName":"Button","Name":"BtnLimpar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BtnLimpar"},{"Key":"Location","Value":"20, 370"},{"Key":"Size","Value":"270, 40"},{"Key":"Text","Value":"C"},{"Key":"Font","Value":"Segoe UI, 12pt, style=Bold"},{"Key":"BackColor","Value":"IndianRed"},{"Key":"ForeColor","Value":"White"}],"Items":[]}],"Code":"Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    ' Guarda o primeiro numero digitado, antes de escolher a operacao\n    Private valorAnterior As Double\n    ' Guarda qual operacao foi escolhida: \"+\", \"-\", \"*\" ou \"/\"\n    Private operacaoAtual As String = \"\"\n    ' Indica se o proximo digito deve comecar um numero novo no visor\n    Private comecarNumeroNovo As Boolean = True\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        TextBoxVisor.Text = \"0\"\n    End Sub\n\n    ' Um unico evento cuida de todos os botoes numericos (0 a 9).\n    ' Repare na lista de \"Handles\": varios controles podem compartilhar o mesmo Sub.\n    Private Sub Numero_Click(sender As Object, e As EventArgs) Handles Btn0.Click, Btn1.Click, Btn2.Click, Btn3.Click, Btn4.Click, Btn5.Click, Btn6.Click, Btn7.Click, Btn8.Click, Btn9.Click\n        Dim botao As Button = DirectCast(sender, Button)\n        If comecarNumeroNovo OrElse TextBoxVisor.Text = \"0\" Then\n            TextBoxVisor.Text = botao.Text\n            comecarNumeroNovo = False\n        Else\n            TextBoxVisor.Text &= botao.Text\n        End If\n    End Sub\n\n    Private Sub BtnPonto_Click() Handles BtnPonto.Click\n        If Not TextBoxVisor.Text.Contains(\".\") Then\n            TextBoxVisor.Text &= \".\"\n            comecarNumeroNovo = False\n        End If\n    End Sub\n\n    ' Um unico evento cuida dos quatro operadores.\n    Private Sub Operacao_Click(sender As Object, e As EventArgs) Handles BtnSomar.Click, BtnSubtrair.Click, BtnMultiplicar.Click, BtnDividir.Click\n        Dim botao As Button = DirectCast(sender, Button)\n        valorAnterior = Double.Parse(TextBoxVisor.Text)\n        operacaoAtual = botao.Text\n        comecarNumeroNovo = True\n    End Sub\n\n    Private Sub BtnIgual_Click() Handles BtnIgual.Click\n        If operacaoAtual = \"\" Then Return\n\n        Dim valorAtual As Double = Double.Parse(TextBoxVisor.Text)\n        Dim resultado As Double\n\n        Select Case operacaoAtual\n            Case \"+\"\n                resultado = valorAnterior + valorAtual\n            Case \"-\"\n                resultado = valorAnterior - valorAtual\n            Case \"*\"\n                resultado = valorAnterior * valorAtual\n            Case \"/\"\n                If valorAtual = 0 Then\n                    MessageBox.Show(\"Nao e possivel dividir por zero.\", \"Erro\", MessageBoxButtons.OK, MessageBoxIcon.Warning)\n                    Return\n                End If\n                resultado = valorAnterior / valorAtual\n        End Select\n\n        TextBoxVisor.Text = resultado.ToString()\n        operacaoAtual = \"\"\n        comecarNumeroNovo = True\n    End Sub\n\n    Private Sub BtnLimpar_Click() Handles BtnLimpar.Click\n        TextBoxVisor.Text = \"0\"\n        valorAnterior = 0\n        operacaoAtual = \"\"\n        comecarNumeroNovo = True\n    End Sub\n\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"","AssemblyDescription":"","AssemblyCompany":"","AssemblyProduct":"","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}