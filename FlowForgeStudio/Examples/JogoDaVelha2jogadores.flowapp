  "AssemblyCopyright": "Copyright © 2026",
  "AssemblyDescription": "Jogo da Velha clássico em Windows Forms",
  "AssemblyProduct": "JogoDaVelhaVB",
  "AssemblyTitle": "JogoDaVelhaVB",
  "AssemblyTrademark": "",
  "AssemblyVersion": "1.0.0.0",
  "FileVersion": "1.0.0.0",
  "Forms": [
    {
      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private isPlayerX As Boolean = True\n    Private moveCount As Integer = 0\n    Private buttons(2, 2) As Button\n\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\n        buttons(0, 0) = btn00\n        buttons(0, 1) = btn01\n        buttons(0, 2) = btn02\n        buttons(1, 0) = btn10\n        buttons(1, 1) = btn11\n        buttons(1, 2) = btn12\n        buttons(2, 0) = btn20\n        buttons(2, 1) = btn21\n        buttons(2, 2) = btn22\n    End Sub\n\n    Private Sub Cell_Click(sender As Object, e As System.EventArgs) Handles btn00.Click, btn01.Click, btn02.Click, btn10.Click, btn11.Click, btn12.Click, btn20.Click, btn21.Click, btn22.Click\n        Dim btn As Button = CType(sender, Button)\n        \n        If btn.Text <> \"\" Then Return\n\n        If isPlayerX Then\n            btn.Text = \"X\"\n            btn.ForeColor = Color.Blue\n            lblStatus.Text = \"Vez do Jogador: O\"\n        Else\n            btn.Text = \"O\"\n            btn.ForeColor = Color.Red\n            lblStatus.Text = \"Vez do Jogador: X\"\n        End If\n\n        moveCount += 1\n        \n        If CheckWinner() Then\n            Dim vencedor As String = If(isPlayerX, \"X\", \"O\")\n            MessageBox.Show(\"Jogador \" & vencedor & \" venceu!\", \"Fim de Jogo\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n            DisableAllButtons()\n            Return\n        End If\n\n        If moveCount = 9 Then\n            MessageBox.Show(\"Empate!\", \"Fim de Jogo\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n            Return\n        End If\n\n        isPlayerX = Not isPlayerX\n    End Sub\n\n    Private Function CheckWinner() As Boolean\n        ' Linhas\n        For i As Integer = 0 To 2\n            If buttons(i, 0).Text <> \"\" AndAlso buttons(i, 0).Text = buttons(i, 1).Text AndAlso buttons(i, 1).Text = buttons(i, 2).Text Then\n                Return True\n            End If\n        Next\n\n        ' Colunas\n        For j As Integer = 0 To 2\n            If buttons(0, j).Text <> \"\" AndAlso buttons(0, j).Text = buttons(1, j).Text AndAlso buttons(1, j).Text = buttons(2, j).Text Then\n                Return True\n            End If\n        Next\n\n        ' Diagonais\n        If buttons(0, 0).Text <> \"\" AndAlso buttons(0, 0).Text = buttons(1, 1).Text AndAlso buttons(1, 1).Text = buttons(2, 2).Text Then\n            Return True\n        End If\n\n        If buttons(0, 2).Text <> \"\" AndAlso buttons(0, 2).Text = buttons(1, 1).Text AndAlso buttons(1, 1).Text = buttons(2, 0).Text Then\n            Return True\n        End If\n\n        Return False\n    End Function\n\n    Private Sub btnReiniciar_Click(sender As Object, e As System.EventArgs) Handles btnReiniciar.Click\n        For i As Integer = 0 To 2\n            For j As Integer = 0 To 2\n                buttons(i, j).Text = \"\"\n                buttons(i, j).Enabled = True\n            Next\n        Next\n        isPlayerX = True\n        moveCount = 0\n        lblStatus.Text = \"Vez do Jogador: X\"\n    End Sub\n\n    Private Sub DisableAllButtons()\n        For i As Integer = 0 To 2\n            For j As Integer = 0 To 2\n                buttons(i, j).Enabled = False\n            Next\n        Next\n    End Sub\n\nEnd Class",
