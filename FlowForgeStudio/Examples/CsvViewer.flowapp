{"Name":"CsvViewer","Version":"1.0.1","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Leitor de CSV"},{"Key":"ClientSize","Value":"800, 520"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"MinimumSize","Value":"640, 420"}],"Controls":[{"TypeName":"Button","Name":"btnAbrir","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnAbrir"},{"Key":"Location","Value":"12, 12"},{"Key":"Size","Value":"105, 30"},{"Key":"Text","Value":"Abrir CSV"}]},{"TypeName":"Label","Name":"lblSep","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblSep"},{"Key":"Location","Value":"130, 20"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Separador:"}]},{"TypeName":"ComboBox","Name":"cmbSeparador","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"cmbSeparador"},{"Key":"Location","Value":"200, 15"},{"Key":"Size","Value":"100, 24"},{"Key":"DropDownStyle","Value":"DropDownList"}]},{"TypeName":"Label","Name":"lblInfo","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblInfo"},{"Key":"Location","Value":"320, 20"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Nenhum arquivo"}]},{"TypeName":"DataGridView","Name":"gridCsv","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"gridCsv"},{"Key":"Location","Value":"12, 52"},{"Key":"Size","Value":"776, 456"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"},{"Key":"AllowUserToAddRows","Value":"False"},{"Key":"ReadOnly","Value":"True"},{"Key":"AutoSizeColumnsMode","Value":"DisplayedCells"}]}],"Code":"Imports System\r\nImports System.Collections.Generic\r\nImports System.IO\r\nImports System.Text\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load\r\n        cmbSeparador.Items.Clear()\r\n        cmbSeparador.Items.AddRange(New Object() {\"Vírgula (,)\", \"Ponto e vírgula (;)\", \"Tabulação\"})\r\n        cmbSeparador.SelectedIndex = 1\r\n    End Sub\r\n\r\n    Private Sub btnAbrir_Click(sender As Object, e As EventArgs) Handles btnAbrir.Click\r\n        Using dialogo As New OpenFileDialog()\r\n            dialogo.Filter = \"Arquivos CSV|*.csv;*.txt|Todos os arquivos|*.*\"\r\n            If dialogo.ShowDialog() <> DialogResult.OK Then Return\r\n            Try\r\n                CarregarArquivo(dialogo.FileName)\r\n            Catch ex As Exception\r\n                MessageBox.Show(ex.Message, \"Leitor de CSV\", MessageBoxButtons.OK, MessageBoxIcon.Error)\r\n            End Try\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub CarregarArquivo(filePath As String)\r\n        Dim separador As Char\r\n        Select Case cmbSeparador.SelectedIndex\r\n            Case 0\r\n                separador = \",\"c\r\n            Case 2\r\n                separador = Convert.ToChar(9)\r\n            Case Else\r\n                separador = \";\"c\r\n        End Select\r\n\r\n        Dim linhas As String() = File.ReadAllLines(filePath, Encoding.Default)\r\n        gridCsv.Columns.Clear()\r\n        gridCsv.Rows.Clear()\r\n        If linhas.Length = 0 Then\r\n            lblInfo.Text = \"Arquivo vazio\"\r\n            Return\r\n        End If\r\n\r\n        Dim cabecalho As String() = SepararLinha(linhas(0), separador)\r\n        For indice As Integer = 0 To cabecalho.Length - 1\r\n            gridCsv.Columns.Add(\"Coluna\" & indice.ToString(), cabecalho(indice))\r\n        Next\r\n\r\n        For indice As Integer = 1 To linhas.Length - 1\r\n            Dim campos As String() = SepararLinha(linhas(indice), separador)\r\n            Dim valores(gridCsv.Columns.Count - 1) As Object\r\n            For coluna As Integer = 0 To valores.Length - 1\r\n                If coluna < campos.Length Then valores(coluna) = campos(coluna) Else valores(coluna) = \"\"\r\n            Next\r\n            gridCsv.Rows.Add(valores)\r\n        Next\r\n        lblInfo.Text = System.IO.Path.GetFileName(filePath) & \" — \" & (linhas.Length - 1).ToString() & \" registro(s)\"\r\n    End Sub\r\n\r\n    Private Function SepararLinha(linha As String, separador As Char) As String()\r\n        Dim resultado As New List(Of String)()\r\n        Dim campo As New StringBuilder()\r\n        Dim dentroDeAspas As Boolean = False\r\n        Dim indice As Integer = 0\r\n        While indice < linha.Length\r\n            Dim caractere As Char = linha(indice)\r\n            If caractere = Convert.ToChar(34) Then\r\n                If dentroDeAspas AndAlso indice + 1 < linha.Length AndAlso linha(indice + 1) = Convert.ToChar(34) Then\r\n                    campo.Append(Convert.ToChar(34))\r\n                    indice += 1\r\n                Else\r\n                    dentroDeAspas = Not dentroDeAspas\r\n                End If\r\n            ElseIf caractere = separador AndAlso Not dentroDeAspas Then\r\n                resultado.Add(campo.ToString())\r\n                campo.Clear()\r\n            Else\r\n                campo.Append(caractere)\r\n            End If\r\n            indice += 1\r\n        End While\r\n        resultado.Add(campo.ToString())\r\n        Return resultado.ToArray()\r\n    End Function\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"Leitor de CSV","AssemblyDescription":"Exemplo criado no FlowForge","AssemblyCompany":"Wtec","AssemblyProduct":"CsvViewer","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"","AssemblyVersion":"1.0.1.0","FileVersion":"1.0.1.0"}