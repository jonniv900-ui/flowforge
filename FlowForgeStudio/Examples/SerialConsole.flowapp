{"Name":"SerialConsole","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"FlowForge Serial Console — Arduino"},{"Key":"ClientSize","Value":"785, 535"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"MinimumSize","Value":"700, 450"},{"Key":"BackColor","Value":"45, 45, 48"}],"Controls":[{"TypeName":"Label","Name":"lblPorta","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblPorta"},{"Key":"Location","Value":"12, 16"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Porta:"}]},{"TypeName":"ComboBox","Name":"cmbPort","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"cmbPort"},{"Key":"Location","Value":"60, 12"},{"Key":"Size","Value":"105, 24"},{"Key":"DropDownStyle","Value":"DropDownList"}]},{"TypeName":"Button","Name":"btnAtualizar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnAtualizar"},{"Key":"Location","Value":"172, 11"},{"Key":"Size","Value":"86, 27"},{"Key":"Text","Value":"Atualizar"}]},{"TypeName":"Label","Name":"lblBaud","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblBaud"},{"Key":"Location","Value":"275, 16"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Baud:"}]},{"TypeName":"ComboBox","Name":"cmbBaud","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"cmbBaud"},{"Key":"Location","Value":"320, 12"},{"Key":"Size","Value":"105, 24"},{"Key":"DropDownStyle","Value":"DropDownList"}]},{"TypeName":"CheckBox","Name":"chkDtr","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"chkDtr"},{"Key":"Location","Value":"440, 14"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"DTR"},{"Key":"Checked","Value":"True"}]},{"TypeName":"CheckBox","Name":"chkRts","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"chkRts"},{"Key":"Location","Value":"500, 14"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"RTS"}]},{"TypeName":"Button","Name":"btnConectar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnConectar"},{"Key":"Location","Value":"570, 11"},{"Key":"Size","Value":"90, 27"},{"Key":"Text","Value":"Conectar"},{"Key":"Anchor","Value":"Top, Right"}]},{"TypeName":"Button","Name":"btnDesconectar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnDesconectar"},{"Key":"Location","Value":"668, 11"},{"Key":"Size","Value":"105, 27"},{"Key":"Text","Value":"Desconectar"},{"Key":"Anchor","Value":"Top, Right"}]},{"TypeName":"RichTextBox","Name":"txtTerminal","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"txtTerminal"},{"Key":"Location","Value":"12, 50"},{"Key":"Size","Value":"761, 400"},{"Key":"BackColor","Value":"30, 30, 30"},{"Key":"ForeColor","Value":"White"},{"Key":"Font","Value":"Consolas, 10pt"},{"Key":"ReadOnly","Value":"True"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"}]},{"TypeName":"TextBox","Name":"txtEnviar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"txtEnviar"},{"Key":"Location","Value":"12, 462"},{"Key":"Size","Value":"570, 24"},{"Key":"Anchor","Value":"Bottom, Left, Right"}]},{"TypeName":"CheckBox","Name":"chkNovaLinha","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"chkNovaLinha"},{"Key":"Location","Value":"592, 465"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Nova linha"},{"Key":"Checked","Value":"True"},{"Key":"Anchor","Value":"Bottom, Right"}]},{"TypeName":"Button","Name":"btnEnviar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnEnviar"},{"Key":"Location","Value":"682, 460"},{"Key":"Size","Value":"91, 28"},{"Key":"Text","Value":"Enviar"},{"Key":"Anchor","Value":"Bottom, Right"}]},{"TypeName":"Label","Name":"lblStatus","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblStatus"},{"Key":"Location","Value":"12, 500"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Desconectado"},{"Key":"ForeColor","Value":"Gainsboro"},{"Key":"Anchor","Value":"Bottom, Left"}]},{"TypeName":"Button","Name":"btnLimpar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnLimpar"},{"Key":"Location","Value":"682, 496"},{"Key":"Size","Value":"91, 27"},{"Key":"Text","Value":"Limpar"},{"Key":"Anchor","Value":"Bottom, Right"}]},{"TypeName":"SerialConnection","Name":"SerialConnection1","AssemblyPath":"","IsNonVisual":true,"Properties":[{"Key":"Name","Value":"SerialConnection1"},{"Key":"PortName","Value":"COM1"},{"Key":"BaudRate","Value":"9600"},{"Key":"DataBits","Value":"8"},{"Key":"Parity","Value":"None"},{"Key":"StopBits","Value":"One"},{"Key":"Handshake","Value":"None"},{"Key":"DtrEnable","Value":"False"},{"Key":"RtsEnable","Value":"False"},{"Key":"ReadTimeout","Value":"1000"},{"Key":"WriteTimeout","Value":"1000"},{"Key":"EncodingName","Value":"utf-8"},{"Key":"__TrayLocation","Value":"20, 20"}]}],"Code":"Imports System\r\nImports System.Drawing\r\nImports System.IO.Ports\r\nImports System.Linq\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private Sub Form1_Load() Handles MyBase.Load\r\n        cmbBaud.Items.AddRange(New Object() {\"300\", \"1200\", \"2400\", \"4800\", \"9600\", \"19200\", \"38400\", \"57600\", \"115200\", \"230400\", \"250000\"})\r\n        cmbBaud.SelectedItem = \"9600\"\r\n        AtualizarPortas()\r\n        AtualizarEstado(False)\r\n    End Sub\r\n\r\n    Private Sub btnAtualizar_Click() Handles btnAtualizar.Click\r\n        AtualizarPortas()\r\n    End Sub\r\n\r\n    Private Sub AtualizarPortas()\r\n        Dim anterior As String = If(cmbPort.SelectedItem Is Nothing, \"\", cmbPort.SelectedItem.ToString())\r\n        cmbPort.Items.Clear()\r\n        Dim portas As String() = SerialPort.GetPortNames().OrderBy(Function(p) p).ToArray()\r\n        cmbPort.Items.AddRange(portas)\r\n        If anterior <> \"\" AndAlso cmbPort.Items.Contains(anterior) Then\r\n            cmbPort.SelectedItem = anterior\r\n        ElseIf cmbPort.Items.Count > 0 Then\r\n            cmbPort.SelectedIndex = 0\r\n        End If\r\n        lblStatus.Text = If(portas.Length = 0, \"Nenhuma porta serial encontrada\", portas.Length.ToString() & \" porta(s) encontrada(s)\")\r\n    End Sub\r\n\r\n    Private Sub btnConectar_Click() Handles btnConectar.Click\r\n        If cmbPort.SelectedItem Is Nothing Then\r\n            MessageBox.Show(\"Selecione uma porta COM.\", \"Serial Console\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n            Return\r\n        End If\r\n        Try\r\n            SerialConnection1.PortName = cmbPort.SelectedItem.ToString()\r\n            SerialConnection1.BaudRate = Integer.Parse(cmbBaud.Text)\r\n            SerialConnection1.DataBits = 8\r\n            SerialConnection1.Parity = Parity.None\r\n            SerialConnection1.StopBits = StopBits.One\r\n            SerialConnection1.Handshake = Handshake.None\r\n            SerialConnection1.DtrEnable = chkDtr.Checked\r\n            SerialConnection1.RtsEnable = chkRts.Checked\r\n            SerialConnection1.NewLine = Environment.NewLine\r\n            SerialConnection1.Open()\r\n            AdicionarTerminal(\"[CONECTADO] \" & SerialConnection1.PortName & \" @ \" & SerialConnection1.BaudRate.ToString() & Environment.NewLine, Color.LightGreen)\r\n            AtualizarEstado(True)\r\n        Catch ex As Exception\r\n            MessageBox.Show(ex.Message, \"Erro ao conectar\", MessageBoxButtons.OK, MessageBoxIcon.Error)\r\n            AtualizarEstado(False)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub btnDesconectar_Click() Handles btnDesconectar.Click\r\n        Try\r\n            If SerialConnection1.IsOpen Then SerialConnection1.Close()\r\n        Catch ex As Exception\r\n            MessageBox.Show(ex.Message, \"Erro serial\", MessageBoxButtons.OK, MessageBoxIcon.Warning)\r\n        End Try\r\n        AdicionarTerminal(\"[DESCONECTADO]\" & Environment.NewLine, Color.Orange)\r\n        AtualizarEstado(False)\r\n    End Sub\r\n\r\n    Private Sub btnEnviar_Click() Handles btnEnviar.Click\r\n        EnviarComando()\r\n    End Sub\r\n\r\n    Private Sub txtEnviar_KeyDown(sender As Object, e As KeyEventArgs) Handles txtEnviar.KeyDown\r\n        If e.KeyCode = Keys.Enter Then\r\n            e.SuppressKeyPress = True\r\n            EnviarComando()\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub EnviarComando()\r\n        If Not SerialConnection1.IsOpen Then\r\n            MessageBox.Show(\"Conecte a porta serial primeiro.\", \"Serial Console\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n            Return\r\n        End If\r\n        Try\r\n            Dim comando As String = txtEnviar.Text\r\n            If chkNovaLinha.Checked Then SerialConnection1.WriteLine(comando) Else SerialConnection1.Write(comando)\r\n            AdicionarTerminal(\"TX > \" & comando & If(chkNovaLinha.Checked, Environment.NewLine, \"\"), Color.DeepSkyBlue)\r\n            txtEnviar.Clear()\r\n        Catch ex As Exception\r\n            AdicionarTerminal(\"[ERRO TX] \" & ex.Message & Environment.NewLine, Color.Salmon)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub SerialConnection1_DataReceived() Handles SerialConnection1.DataReceived\r\n        Try\r\n            Dim recebido As String = SerialConnection1.ReadExisting()\r\n            If recebido <> \"\" Then AdicionarTerminalSeguro(\"RX < \" & recebido, Color.White)\r\n        Catch ex As Exception\r\n            AdicionarTerminalSeguro(\"[ERRO RX] \" & ex.Message & Environment.NewLine, Color.Salmon)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub AdicionarTerminalSeguro(texto As String, cor As Color)\r\n        If txtTerminal.InvokeRequired Then\r\n            txtTerminal.BeginInvoke(New Action(Of String, Color)(AddressOf AdicionarTerminal), texto, cor)\r\n        Else\r\n            AdicionarTerminal(texto, cor)\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub AdicionarTerminal(texto As String, cor As Color)\r\n        txtTerminal.SelectionStart = txtTerminal.TextLength\r\n        txtTerminal.SelectionColor = cor\r\n        txtTerminal.AppendText(texto)\r\n        txtTerminal.SelectionColor = txtTerminal.ForeColor\r\n        txtTerminal.ScrollToCaret()\r\n    End Sub\r\n\r\n    Private Sub btnLimpar_Click() Handles btnLimpar.Click\r\n        txtTerminal.Clear()\r\n    End Sub\r\n\r\n    Private Sub AtualizarEstado(conectado As Boolean)\r\n        btnConectar.Enabled = Not conectado\r\n        btnDesconectar.Enabled = conectado\r\n        btnEnviar.Enabled = conectado\r\n        cmbPort.Enabled = Not conectado\r\n        cmbBaud.Enabled = Not conectado\r\n        btnAtualizar.Enabled = Not conectado\r\n        lblStatus.Text = If(conectado, \"Conectado a \" & SerialConnection1.PortName, \"Desconectado\")\r\n        lblStatus.ForeColor = If(conectado, Color.LightGreen, Color.Gainsboro)\r\n    End Sub\r\n\r\n    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing\r\n        If SerialConnection1.IsOpen Then SerialConnection1.Close()\r\n    End Sub\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"FlowForge Serial Console","AssemblyDescription":"Console serial para Arduino e dispositivos COM","AssemblyCompany":"Wtec","AssemblyProduct":"SerialConsole","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}