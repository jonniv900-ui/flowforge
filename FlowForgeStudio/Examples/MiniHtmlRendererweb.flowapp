{
  "ApplicationIcon": "",
  "AssemblyCompany": "Wtec",
  "AssemblyCopyright": "Copyright © 2026",
  "AssemblyDescription": "Mini renderizador HTML com acesso HTTP/HTTPS criado no FlowForge",
  "AssemblyProduct": "MiniHtmlRenderer",
  "AssemblyTitle": "Mini HTML Renderer",
  "AssemblyTrademark": "",
  "AssemblyVersion": "1.2.0.0",
  "FileVersion": "1.2.0.0",
  "Forms": [
    {
      "Code": "Imports System\nImports System.Collections.Generic\nImports System.Drawing\nImports System.Drawing.Drawing2D\nImports System.Net\nImports System.Text.RegularExpressions\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Class EstiloHtml\n        Public Negrito As Boolean\n        Public Italico As Boolean\n        Public Sublinhado As Boolean\n        Public Tamanho As Single = 10.0F\n        Public Cor As Color = Color.Black\n        Public Function Copiar() As EstiloHtml\n            Return New EstiloHtml With {.Negrito = Negrito, .Italico = Italico, .Sublinhado = Sublinhado, .Tamanho = Tamanho, .Cor = Cor}\n        End Function\n    End Class\n\n    Private Class TrechoHtml\n        Public Texto As String = \"\"\n        Public Estilo As EstiloHtml\n        Public Quebra As Boolean\n        Public LinhaHorizontal As Boolean\n    End Class\n\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\n        RenderizarHtml()\n    End Sub\n\n    Private Sub btnRender_Click(sender As Object, e As System.EventArgs) Handles btnRender.Click\n        RenderizarHtml()\n    End Sub\n\n    Private Async Sub btnAbrir_Click(sender As Object, e As System.EventArgs) Handles btnAbrir.Click\n        Dim endereco As String = txtUrl.Text.Trim()\n        If endereco = \"\" Then Return\n        If Not endereco.StartsWith(\"http://\", StringComparison.OrdinalIgnoreCase) AndAlso Not endereco.StartsWith(\"https://\", StringComparison.OrdinalIgnoreCase) Then endereco = \"https://\" & endereco\n        btnAbrir.Enabled = False\n        btnAbrir.Text = \"Carregando...\"\n        Try\n            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12\n            Using cliente As New WebClient()\n                cliente.Headers(HttpRequestHeader.UserAgent) = \"Mozilla/5.0 FlowForge MiniHtmlRenderer/1.2\"\n                cliente.Headers(HttpRequestHeader.Accept) = \"text/html,application/xhtml+xml\"\n                txtHtml.Text = Await cliente.DownloadStringTaskAsync(New Uri(endereco))\n            End Using\n            txtUrl.Text = endereco\n            RenderizarHtml()\n        Catch ex As Exception\n            MessageBox.Show(\"Não foi possível abrir o site:\" & Environment.NewLine & ex.Message, \"Mini HTML Renderer\", MessageBoxButtons.OK, MessageBoxIcon.Warning)\n        Finally\n            btnAbrir.Enabled = True\n            btnAbrir.Text = \"Abrir site\"\n        End Try\n    End Sub\n\n    Private Sub RenderizarHtml()\n        If canvas.ClientSize.Width < 2 OrElse canvas.ClientSize.Height < 2 Then Return\n        Dim bmp As New Bitmap(canvas.ClientSize.Width, canvas.ClientSize.Height)\n        Using g As Graphics = Graphics.FromImage(bmp)\n            g.Clear(Color.White)\n            g.SmoothingMode = SmoothingMode.AntiAlias\n            g.TextRenderingHint = System.Drawing.Text.TextRenderingHint.ClearTypeGridFit\n            DesenharTrechos(g, AnalisarHtml(txtHtml.Text), bmp.Size)\n        End Using\n        Dim anterior As Image = canvas.Image\n        canvas.Image = bmp\n        If anterior IsNot Nothing Then anterior.Dispose()\n    End Sub\n\n    Private Sub DesenharTrechos(g As Graphics, trechos As List(Of TrechoHtml), area As Size)\n        Dim margem As Single = 14.0F\n        Dim x As Single = margem\n        Dim y As Single = margem\n        Dim alturaLinha As Single = 18.0F\n\n        For Each trecho As TrechoHtml In trechos\n            If y > area.Height - margem Then Exit For\n            If trecho.Quebra Then\n                If x > margem Then y += alturaLinha\n                x = margem : alturaLinha = 18.0F\n                Continue For\n            End If\n            If trecho.LinhaHorizontal Then\n                y += 5 : g.DrawLine(Pens.Silver, margem, y, area.Width - margem, y) : y += 10 : x = margem\n                Continue For\n            End If\n            If String.IsNullOrEmpty(trecho.Texto) Then Continue For\n\n            Dim estiloFonte As FontStyle = FontStyle.Regular\n            If trecho.Estilo.Negrito Then estiloFonte = estiloFonte Or FontStyle.Bold\n            If trecho.Estilo.Italico Then estiloFonte = estiloFonte Or FontStyle.Italic\n            If trecho.Estilo.Sublinhado Then estiloFonte = estiloFonte Or FontStyle.Underline\n            Using fonte As New Font(\"Segoe UI\", trecho.Estilo.Tamanho, estiloFonte), pincel As New SolidBrush(trecho.Estilo.Cor)\n                Dim partes As String() = Regex.Split(trecho.Texto.Replace(Convert.ToChar(13).ToString(), \"\"), \"(\\s+)\")\n                For Each parte As String In partes\n                    If parte = \"\" Then Continue For\n                    If parte.IndexOf(Convert.ToChar(10)) >= 0 Then\n                        y += alturaLinha : x = margem : alturaLinha = fonte.GetHeight(g) + 4\n                        Continue For\n                    End If\n                    Dim tamanho As SizeF = g.MeasureString(parte, fonte, Integer.MaxValue, StringFormat.GenericTypographic)\n                    If x + tamanho.Width > area.Width - margem AndAlso x > margem Then\n                        y += alturaLinha : x = margem : alturaLinha = fonte.GetHeight(g) + 4\n                    End If\n                    If y > area.Height - margem Then Exit For\n                    g.DrawString(parte, fonte, pincel, x, y, StringFormat.GenericTypographic)\n                    x += tamanho.Width : alturaLinha = Math.Max(alturaLinha, fonte.GetHeight(g) + 4)\n                Next\n            End Using\n        Next\n    End Sub\n\n    Private Function AnalisarHtml(html As String) As List(Of TrechoHtml)\n        Dim resultado As New List(Of TrechoHtml)()\n        Dim pilha As New Stack(Of EstiloHtml)()\n        Dim atual As New EstiloHtml()\n        html = Regex.Replace(html, \"<script[^>]*>[\\s\\S]*?</script>\", \"\", RegexOptions.IgnoreCase)\n        html = Regex.Replace(html, \"<style[^>]*>[\\s\\S]*?</style>\", \"\", RegexOptions.IgnoreCase)\n        html = Regex.Replace(html, \"<head[^>]*>[\\s\\S]*?</head>\", \"\", RegexOptions.IgnoreCase)\n        Dim marcadores As MatchCollection = Regex.Matches(html, \"<[^>]*>|[^<]+\", RegexOptions.Singleline)\n\n        For Each marcador As Match In marcadores\n            Dim valor As String = marcador.Value\n            If Not valor.StartsWith(\"<\") Then\n                Dim texto As String = LimparEntidades(valor)\n                If texto.Trim() <> \"\" Then resultado.Add(New TrechoHtml With {.Texto = texto, .Estilo = atual.Copiar()})\n                Continue For\n            End If\n\n            Dim tag As String = valor.Trim(\"<\"c, \">\"c).Trim()\n            If tag = \"\" OrElse tag.StartsWith(\"!\") Then Continue For\n            Dim fechando As Boolean = tag.StartsWith(\"/\")\n            Dim nome As String = tag.TrimStart(\"/\"c).Split(New Char() {\" \"c, Convert.ToChar(9)}, StringSplitOptions.RemoveEmptyEntries)(0).ToLowerInvariant()\n\n            If fechando Then\n                If nome = \"p\" OrElse nome = \"div\" OrElse nome = \"h1\" OrElse nome = \"h2\" OrElse nome = \"h3\" OrElse nome = \"li\" Then resultado.Add(New TrechoHtml With {.Quebra = True})\n                If pilha.Count > 0 Then atual = pilha.Pop()\n                Continue For\n            End If\n\n            If nome = \"br\" Then resultado.Add(New TrechoHtml With {.Quebra = True}) : Continue For\n            If nome = \"hr\" Then resultado.Add(New TrechoHtml With {.LinhaHorizontal = True}) : Continue For\n            If nome = \"html\" OrElse nome = \"body\" OrElse nome = \"head\" OrElse nome = \"title\" Then Continue For\n\n            If nome = \"p\" OrElse nome = \"div\" OrElse nome = \"h1\" OrElse nome = \"h2\" OrElse nome = \"h3\" OrElse nome = \"li\" Then resultado.Add(New TrechoHtml With {.Quebra = True})\n            pilha.Push(atual.Copiar())\n            Select Case nome\n                Case \"b\", \"strong\" : atual.Negrito = True\n                Case \"i\", \"em\" : atual.Italico = True\n                Case \"u\" : atual.Sublinhado = True\n                Case \"h1\" : atual.Negrito = True : atual.Tamanho = 22\n                Case \"h2\" : atual.Negrito = True : atual.Tamanho = 17\n                Case \"h3\" : atual.Negrito = True : atual.Tamanho = 14\n                Case \"li\"\n                    resultado.Add(New TrechoHtml With {.Texto = \"• \", .Estilo = atual.Copiar()})\n            End Select\n        Next\n        Return resultado\n    End Function\n\n    Private Function LimparEntidades(texto As String) As String\n        Return texto.Replace(\"&lt;\", \"<\") _\n                    .Replace(\"&gt;\", \">\") _\n                    .Replace(\"&amp;\", \"&\") _\n                    .Replace(\"&quot;\", Convert.ToChar(34).ToString()) _\n                    .Replace(\"&apos;\", \"'\") _\n                    .Replace(\"&nbsp;\", \" \")\n    End Function\nEnd Class",
