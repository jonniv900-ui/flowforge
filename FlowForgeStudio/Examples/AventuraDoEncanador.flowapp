{"FormatVersion": 2, "Name": "AventuraDoEncanador", "Version": "1.0.0", "Forms": [{"Name": "Form1", "IsStartup": true, "Properties": [{"Key": "Text", "Value": "Aventura do Encanador - estilo Mario (graficos 100% por codigo)"}, {"Key": "ClientSize", "Value": "800, 480"}, {"Key": "FormBorderStyle", "Value": "FixedSingle"}, {"Key": "StartPosition", "Value": "CenterScreen"}, {"Key": "MaximizeBox", "Value": "False"}, {"Key": "MinimizeBox", "Value": "True"}, {"Key": "KeyPreview", "Value": "True"}, {"Key": "BackColor", "Value": "CornflowerBlue"}, {"Key": "Font", "Value": "Segoe UI, 9pt"}], "Controls": [{"Name": "lblScore", "TypeName": "Label", "AssemblyPath": "", "IsNonVisual": false, "Items": [], "Properties": [{"Key": "AutoSize", "Value": "True"}, {"Key": "BackColor", "Value": "Transparent"}, {"Key": "Font", "Value": "Segoe UI, 14pt, style=Bold"}, {"Key": "ForeColor", "Value": "White"}, {"Key": "Location", "Value": "16, 12"}, {"Key": "Text", "Value": "Pontos: 0"}, {"Key": "TabIndex", "Value": "0"}]}, {"Name": "lblVidas", "TypeName": "Label", "AssemblyPath": "", "IsNonVisual": false, "Items": [], "Properties": [{"Key": "AutoSize", "Value": "True"}, {"Key": "BackColor", "Value": "Transparent"}, {"Key": "Font", "Value": "Segoe UI, 14pt, style=Bold"}, {"Key": "ForeColor", "Value": "White"}, {"Key": "Location", "Value": "16, 44"}, {"Key": "Text", "Value": "Vidas: 3"}, {"Key": "TabIndex", "Value": "1"}]}, {"Name": "lblInstrucoes", "TypeName": "Label", "AssemblyPath": "", "IsNonVisual": false, "Items": [], "Properties": [{"Key": "AutoSize", "Value": "False"}, {"Key": "BackColor", "Value": "Black"}, {"Key": "Font", "Value": "Segoe UI, 13pt, style=Bold"}, {"Key": "ForeColor", "Value": "Yellow"}, {"Key": "Location", "Value": "150, 160"}, {"Key": "Size", "Value": "500, 150"}, {"Key": "TextAlign", "Value": "MiddleCenter"}, {"Key": "Text", "Value": "AVENTURA DO ENCANADOR\r\nSETAS para mover, ESPACO para pular\r\nPressione ENTER para comecar!"}, {"Key": "TabIndex", "Value": "2"}]}, {"Name": "gameTimer", "TypeName": "Timer", "AssemblyPath": "", "IsNonVisual": true, "Items": [], "Properties": [{"Key": "Enabled", "Value": "False"}, {"Key": "Interval", "Value": "20"}]}], "Code": "Imports System\nImports System.Collections.Generic\nImports System.Linq\nImports System.Drawing\nImports System.Drawing.Drawing2D\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    ' =========================================================\n    ' Dados do nível — tudo em coordenadas de \"mundo\" (o jogo\n    ' rola horizontalmente e a câmera segue o jogador)\n    ' =========================================================\n    Private Const LevelWidth As Integer = 3200\n    Private Const GroundTop As Integer = 400\n\n    Private ReadOnly groundSegments As New List(Of Rectangle) From {\n        New Rectangle(0, GroundTop, 500, 200),\n        New Rectangle(600, GroundTop, 600, 200),\n        New Rectangle(1320, GroundTop, 680, 200),\n        New Rectangle(2100, GroundTop, LevelWidth - 2100, 200)\n    }\n\n    Private ReadOnly platforms As New List(Of Rectangle) From {\n        New Rectangle(150, 300, 100, 20),\n        New Rectangle(700, 280, 120, 20),\n        New Rectangle(920, 220, 100, 20),\n        New Rectangle(1400, 300, 110, 20),\n        New Rectangle(1650, 250, 100, 20),\n        New Rectangle(2320, 300, 120, 20),\n        New Rectangle(2600, 230, 100, 20)\n    }\n\n    Private ReadOnly pipes As New List(Of Rectangle) From {\n        New Rectangle(820, 340, 60, 60),\n        New Rectangle(1760, 300, 60, 100),\n        New Rectangle(2470, 320, 60, 80)\n    }\n\n    Private Const FlagX As Integer = LevelWidth - 120\n\n    Private coins As New List(Of PointF)\n    Private goombas As New List(Of Goomba)\n\n    ' =========================================================\n    ' Jogador\n    ' =========================================================\n    Private Const PlayerWidth As Integer = 26\n    Private Const PlayerHeight As Integer = 38\n    Private Const Gravity As Double = 0.65\n    Private Const MoveSpeed As Double = 4.2\n    Private Const JumpVelocity As Double = -13.0\n\n    Private playerX As Double\n    Private playerY As Double\n    Private velocityX As Double\n    Private velocityY As Double\n    Private onGround As Boolean\n    Private facingRight As Boolean = True\n    Private leftHeld As Boolean\n    Private rightHeld As Boolean\n\n    ' =========================================================\n    ' Estado geral do jogo\n    ' =========================================================\n    Private cameraX As Double\n    Private score As Integer\n    Private lives As Integer\n    Private frameCount As Integer\n\n    Private Enum GameState\n        Aguardando\n        Jogando\n        FimDeJogo\n        Venceu\n    End Enum\n    Private state As GameState = GameState.Aguardando\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        Me.SetStyle(ControlStyles.AllPaintingInWmPaint Or ControlStyles.UserPaint Or ControlStyles.DoubleBuffer Or ControlStyles.ResizeRedraw, True)\n        PrepararNivel()\n    End Sub\n\n    Private Sub PrepararNivel()\n        coins = New List(Of PointF)\n        Dim coinSpotsChao() As Single = {200, 260, 320, 950, 980, 2150, 2650, 2900, 2930}\n        For Each spotX As Single In coinSpotsChao\n            coins.Add(New PointF(spotX, 370))\n        Next\n        For Each plat As Rectangle In platforms\n            coins.Add(New PointF(plat.X + plat.Width / 2.0F, plat.Y - 30))\n        Next\n\n        goombas = New List(Of Goomba)\n        goombas.Add(New Goomba With {.X = 950, .Y = GroundTop - 28, .MinX = 900, .MaxX = 1180, .Direction = -1})\n        goombas.Add(New Goomba With {.X = 1420, .Y = 300 - 28, .MinX = 1402, .MaxX = 1480, .Direction = -1})\n        goombas.Add(New Goomba With {.X = 1500, .Y = GroundTop - 28, .MinX = 1350, .MaxX = 1700, .Direction = -1})\n        goombas.Add(New Goomba With {.X = 2200, .Y = GroundTop - 28, .MinX = 2150, .MaxX = 2420, .Direction = 1})\n\n        playerX = 40\n        playerY = GroundTop - PlayerHeight\n        velocityX = 0\n        velocityY = 0\n        onGround = False\n        cameraX = 0\n        score = 0\n        lives = 3\n        frameCount = 0\n        AtualizarHud()\n    End Sub\n\n    Private Sub IniciarJogo()\n        PrepararNivel()\n        state = GameState.Jogando\n        lblInstrucoes.Visible = False\n        gameTimer.Start()\n    End Sub\n\n    Private Sub AtualizarHud()\n        lblScore.Text = \"Pontos: \" & score.ToString()\n        lblVidas.Text = \"Vidas: \" & lives.ToString()\n    End Sub\n\n    Private Sub Form1_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown\n        Select Case e.KeyCode\n            Case Keys.Left, Keys.A\n                leftHeld = True\n            Case Keys.Right, Keys.D\n                rightHeld = True\n            Case Keys.Space, Keys.Up, Keys.W\n                If state = GameState.Jogando AndAlso onGround Then\n                    velocityY = JumpVelocity\n                    onGround = False\n                ElseIf state <> GameState.Jogando Then\n                    IniciarJogo()\n                End If\n            Case Keys.Enter\n                If state <> GameState.Jogando Then IniciarJogo()\n        End Select\n        e.Handled = True\n    End Sub\n\n    Private Sub Form1_KeyUp(sender As Object, e As KeyEventArgs) Handles MyBase.KeyUp\n        Select Case e.KeyCode\n            Case Keys.Left, Keys.A\n                leftHeld = False\n            Case Keys.Right, Keys.D\n                rightHeld = False\n        End Select\n    End Sub\n\n    Private Function SolidosDoNivel() As List(Of Rectangle)\n        Dim lista As New List(Of Rectangle)\n        lista.AddRange(groundSegments)\n        lista.AddRange(platforms)\n        lista.AddRange(pipes)\n        Return lista\n    End Function\n\n    Private Sub gameTimer_Tick() Handles gameTimer.Tick\n        frameCount += 1\n\n        ' ---- Entrada / movimento horizontal ----\n        velocityX = 0\n        If leftHeld Then\n            velocityX -= MoveSpeed\n            facingRight = False\n        End If\n        If rightHeld Then\n            velocityX += MoveSpeed\n            facingRight = True\n        End If\n\n        Dim solidos As List(Of Rectangle) = SolidosDoNivel()\n\n        playerX += velocityX\n        If playerX < 0 Then playerX = 0\n        If playerX > LevelWidth - PlayerWidth Then playerX = LevelWidth - PlayerWidth\n        Dim rect As Rectangle = New Rectangle(CInt(playerX), CInt(playerY), PlayerWidth, PlayerHeight)\n        For Each s As Rectangle In solidos\n            If rect.IntersectsWith(s) Then\n                If velocityX > 0 Then playerX = s.Left - PlayerWidth\n                If velocityX < 0 Then playerX = s.Right\n                rect = New Rectangle(CInt(playerX), CInt(playerY), PlayerWidth, PlayerHeight)\n            End If\n        Next\n\n        ' ---- Gravidade / movimento vertical ----\n        velocityY += Gravity\n        playerY += velocityY\n        onGround = False\n        rect = New Rectangle(CInt(playerX), CInt(playerY), PlayerWidth, PlayerHeight)\n        For Each s As Rectangle In solidos\n            If rect.IntersectsWith(s) Then\n                If velocityY > 0 Then\n                    playerY = s.Top - PlayerHeight\n                    velocityY = 0\n                    onGround = True\n                ElseIf velocityY < 0 Then\n                    playerY = s.Bottom\n                    velocityY = 0\n                End If\n                rect = New Rectangle(CInt(playerX), CInt(playerY), PlayerWidth, PlayerHeight)\n            End If\n        Next\n\n        ' ---- Caiu num buraco ----\n        If playerY > Me.ClientSize.Height + 150 Then\n            PerderVida()\n            Return\n        End If\n\n        ' ---- Moedas ----\n        For i As Integer = coins.Count - 1 To 0 Step -1\n            Dim moeda As New RectangleF(coins(i).X - 10, coins(i).Y - 10, 20, 20)\n            If rect.IntersectsWith(Rectangle.Round(moeda)) Then\n                coins.RemoveAt(i)\n                score += 10\n                AtualizarHud()\n            End If\n        Next\n\n        ' ---- Inimigos ----\n        For Each g As Goomba In goombas\n            If Not g.Alive Then Continue For\n            g.X += g.Direction * 1.6\n            If g.X <= g.MinX Then g.Direction = 1\n            If g.X >= g.MaxX Then g.Direction = -1\n            Dim goombaRect As New Rectangle(CInt(g.X), CInt(g.Y), 28, 28)\n            If rect.IntersectsWith(goombaRect) Then\n                If velocityY > 0 AndAlso (playerY + PlayerHeight) - goombaRect.Top < 16 Then\n                    g.Alive = False\n                    velocityY = JumpVelocity * 0.55\n                    score += 50\n                    AtualizarHud()\n                Else\n                    PerderVida()\n                    Return\n                End If\n            End If\n        Next\n\n        ' ---- Chegou na bandeira: venceu ----\n        If playerX + PlayerWidth >= FlagX Then\n            state = GameState.Venceu\n            gameTimer.Stop()\n            lblInstrucoes.Text = \"VOCÊ VENCEU!\" & Environment.NewLine & \"Pontos: \" & score.ToString() & Environment.NewLine & \"Pressione ENTER para jogar de novo\"\n            lblInstrucoes.Visible = True\n            Return\n        End If\n\n        ' ---- Câmera segue o jogador ----\n        cameraX = playerX - Me.ClientSize.Width / 2.0\n        If cameraX < 0 Then cameraX = 0\n        If cameraX > LevelWidth - Me.ClientSize.Width Then cameraX = LevelWidth - Me.ClientSize.Width\n\n        Me.Invalidate()\n    End Sub\n\n    Private Sub PerderVida()\n        lives -= 1\n        If lives <= 0 Then\n            gameTimer.Stop()\n            state = GameState.FimDeJogo\n            lblInstrucoes.Text = \"FIM DE JOGO!\" & Environment.NewLine & \"Pontos: \" & score.ToString() & Environment.NewLine & \"Pressione ENTER para tentar de novo\"\n            lblInstrucoes.Visible = True\n        Else\n            playerX = 40\n            playerY = GroundTop - PlayerHeight\n            velocityX = 0\n            velocityY = 0\n            cameraX = 0\n            AtualizarHud()\n        End If\n    End Sub\n\n    ' =========================================================\n    ' Desenho — tudo gerado por código (formas, cores e gradientes),\n    ' nenhuma imagem é usada em lugar nenhum.\n    ' =========================================================\n    Protected Overrides Sub OnPaint(e As PaintEventArgs)\n        MyBase.OnPaint(e)\n        Dim g As Graphics = e.Graphics\n        g.SmoothingMode = SmoothingMode.AntiAlias\n\n        DesenharCeu(g)\n        DesenharMontanhas(g)\n        DesenharNuvens(g)\n\n        Dim offset As Integer = CInt(cameraX)\n\n        For Each seg As Rectangle In groundSegments\n            DesenharChao(g, New Rectangle(seg.X - offset, seg.Y, seg.Width, seg.Height))\n        Next\n        For Each p As Rectangle In platforms\n            DesenharPlataforma(g, New Rectangle(p.X - offset, p.Y, p.Width, p.Height))\n        Next\n        For Each tubo As Rectangle In pipes\n            DesenharCano(g, New Rectangle(tubo.X - offset, tubo.Y, tubo.Width, tubo.Height))\n        Next\n\n        DesenharBandeira(g, FlagX - offset, GroundTop)\n\n        For Each c As PointF In coins\n            DesenharMoeda(g, c.X - offset, c.Y)\n        Next\n\n        For Each go As Goomba In goombas\n            If go.Alive Then DesenharGoomba(g, CSng(go.X - offset), CSng(go.Y), go.Direction)\n        Next\n\n        DesenharJogador(g, CSng(playerX - offset), CSng(playerY))\n\n        If state = GameState.Aguardando Then\n            DesenharFaixaTexto(g, \"SETAS para mover • ESPAÇO para pular\", Me.ClientSize.Height - 40)\n        End If\n    End Sub\n\n    Private Sub DesenharCeu(g As Graphics)\n        Using brush As New LinearGradientBrush(New Rectangle(0, 0, Me.ClientSize.Width, Me.ClientSize.Height), Color.FromArgb(90, 170, 250), Color.FromArgb(190, 230, 255), LinearGradientMode.Vertical)\n            g.FillRectangle(brush, 0, 0, Me.ClientSize.Width, Me.ClientSize.Height)\n        End Using\n    End Sub\n\n    Private Sub DesenharMontanhas(g As Graphics)\n        Dim parallax As Integer = CInt(cameraX * 0.25) Mod 300\n        Using brush As New SolidBrush(Color.FromArgb(120, 160, 110))\n            Dim baseX As Integer = -parallax - 300\n            While baseX < Me.ClientSize.Width\n                Dim pontos() As Point = {New Point(baseX, GroundTop), New Point(baseX + 90, GroundTop - 110), New Point(baseX + 180, GroundTop)}\n                g.FillPolygon(brush, pontos)\n                baseX += 300\n            End While\n        End Using\n    End Sub\n\n    Private Sub DesenharNuvens(g As Graphics)\n        Dim parallax As Integer = CInt(cameraX * 0.5) Mod 260\n        Using brush As New SolidBrush(Color.White)\n            Dim baseX As Integer = -parallax - 260\n            While baseX < Me.ClientSize.Width\n                g.FillEllipse(brush, baseX, 60, 60, 30)\n                g.FillEllipse(brush, baseX + 30, 45, 50, 30)\n                g.FillEllipse(brush, baseX + 60, 60, 60, 30)\n                baseX += 260\n            End While\n        End Using\n    End Sub\n\n    Private Sub DesenharChao(g As Graphics, area As Rectangle)\n        If area.Right < 0 OrElse area.Left > Me.ClientSize.Width Then Return\n        Using solo As New SolidBrush(Color.FromArgb(150, 90, 40))\n            g.FillRectangle(solo, area)\n        End Using\n        Using grama As New SolidBrush(Color.FromArgb(70, 180, 70))\n            g.FillRectangle(grama, area.X, area.Y, area.Width, 14)\n        End Using\n        Using linha As New Pen(Color.FromArgb(90, 50, 20))\n            Dim y As Integer = area.Y + 14\n            While y < area.Bottom\n                g.DrawLine(linha, area.X, y, area.Right, y)\n                y += 22\n            End While\n        End Using\n    End Sub\n\n    Private Sub DesenharPlataforma(g As Graphics, area As Rectangle)\n        If area.Right < 0 OrElse area.Left > Me.ClientSize.Width Then Return\n        Using corpo As New SolidBrush(Color.FromArgb(190, 130, 70))\n            g.FillRectangle(corpo, area)\n        End Using\n        Using borda As New Pen(Color.FromArgb(120, 80, 40), 2)\n            g.DrawRectangle(borda, area)\n        End Using\n        Using brilho As New Pen(Color.FromArgb(230, 190, 140))\n            g.DrawLine(brilho, area.X + 2, area.Y + 2, area.Right - 2, area.Y + 2)\n        End Using\n    End Sub\n\n    Private Sub DesenharCano(g As Graphics, area As Rectangle)\n        If area.Right < 0 OrElse area.Left > Me.ClientSize.Width Then Return\n        Dim tampa As New Rectangle(area.X - 6, area.Y, area.Width + 12, 18)\n        Using corpo As New SolidBrush(Color.FromArgb(60, 170, 70))\n            g.FillRectangle(corpo, area)\n            g.FillRectangle(corpo, tampa)\n        End Using\n        Using borda As New Pen(Color.FromArgb(30, 100, 40), 2)\n            g.DrawRectangle(borda, area)\n            g.DrawRectangle(borda, tampa)\n        End Using\n        Using luz As New SolidBrush(Color.FromArgb(140, 220, 140))\n            g.FillRectangle(luz, area.X + 4, area.Y, 6, area.Height)\n        End Using\n    End Sub\n\n    Private Sub DesenharBandeira(g As Graphics, x As Single, chaoY As Integer)\n        If x < -40 OrElse x > Me.ClientSize.Width + 40 Then Return\n        Using mastro As New Pen(Color.FromArgb(210, 210, 210), 4)\n            g.DrawLine(mastro, x, chaoY, x, chaoY - 220)\n        End Using\n        Using bola As New SolidBrush(Color.Gold)\n            g.FillEllipse(bola, x - 6, chaoY - 232, 12, 12)\n        End Using\n        Dim ondulacao As Single = CSng(Math.Sin(frameCount * 0.15) * 6)\n        Dim bandeira() As PointF = {\n            New PointF(x, chaoY - 210),\n            New PointF(x + 46 + ondulacao, chaoY - 198),\n            New PointF(x, chaoY - 186)\n        }\n        Using pano As New SolidBrush(Color.OrangeRed)\n            g.FillPolygon(pano, bandeira)\n        End Using\n    End Sub\n\n    Private Sub DesenharMoeda(g As Graphics, x As Single, y As Single)\n        If x < -20 OrElse x > Me.ClientSize.Width + 20 Then Return\n        Dim largura As Single = CSng(Math.Abs(Math.Sin(frameCount * 0.12 + x)) * 16) + 4\n        Using ouro As New SolidBrush(Color.Gold)\n            g.FillEllipse(ouro, x - largura / 2, y - 10, largura, 20)\n        End Using\n        Using borda As New Pen(Color.FromArgb(200, 150, 0), 1.5F)\n            g.DrawEllipse(borda, x - largura / 2, y - 10, largura, 20)\n        End Using\n    End Sub\n\n    Private Sub DesenharGoomba(g As Graphics, x As Single, y As Single, direcao As Integer)\n        If x < -40 OrElse x > Me.ClientSize.Width + 40 Then Return\n        Dim balanco As Single = CSng(Math.Sin(frameCount * 0.3) * 2)\n        Using corpo As New SolidBrush(Color.FromArgb(150, 90, 60))\n            g.FillEllipse(corpo, x, y + balanco, 28, 22)\n        End Using\n        Using pes As New SolidBrush(Color.FromArgb(90, 50, 30))\n            g.FillEllipse(pes, x + 2, y + 20, 10, 8)\n            g.FillEllipse(pes, x + 16, y + 20, 10, 8)\n        End Using\n        Using olhoBranco As New SolidBrush(Color.White)\n            g.FillEllipse(olhoBranco, x + 6, y + 6 + balanco, 7, 8)\n            g.FillEllipse(olhoBranco, x + 15, y + 6 + balanco, 7, 8)\n        End Using\n        Using pupila As New SolidBrush(Color.Black)\n            Dim deslocamento As Single = If(direcao < 0, -1.5F, 1.5F)\n            g.FillEllipse(pupila, x + 8 + deslocamento, y + 9 + balanco, 3, 4)\n            g.FillEllipse(pupila, x + 17 + deslocamento, y + 9 + balanco, 3, 4)\n        End Using\n    End Sub\n\n    Private Sub DesenharJogador(g As Graphics, x As Single, y As Single)\n        Dim andando As Boolean = (leftHeld OrElse rightHeld) AndAlso onGround\n        Dim passo As Single = If(andando, CSng(Math.Sin(frameCount * 0.5) * 4), 0.0F)\n        Dim dir As Single = If(facingRight, 1.0F, -1.0F)\n\n        ' Pernas\n        Using calca As New SolidBrush(Color.FromArgb(30, 90, 200))\n            If onGround Then\n                g.FillRectangle(calca, x + 4, y + 28 + Math.Max(0.0F, passo), 8, 10 - Math.Max(0.0F, passo))\n                g.FillRectangle(calca, x + 14, y + 28 + Math.Max(0.0F, -passo), 8, 10 - Math.Max(0.0F, -passo))\n            Else\n                g.FillRectangle(calca, x + 4, y + 26, 8, 12)\n                g.FillRectangle(calca, x + 14, y + 26, 8, 12)\n            End If\n        End Using\n        ' Sapatos\n        Using sapato As New SolidBrush(Color.FromArgb(90, 55, 25))\n            g.FillRectangle(sapato, x + 2, y + 34, 10, 5)\n            g.FillRectangle(sapato, x + 14, y + 34, 10, 5)\n        End Using\n        ' Macacão\n        Using macacao As New SolidBrush(Color.FromArgb(30, 90, 200))\n            g.FillRectangle(macacao, x + 3, y + 16, 20, 14)\n        End Using\n        Using alcas As New SolidBrush(Color.FromArgb(220, 60, 40))\n            g.FillRectangle(alcas, x + 5, y + 14, 4, 6)\n            g.FillRectangle(alcas, x + 17, y + 14, 4, 6)\n        End Using\n        ' Camisa / braços\n        Using camisa As New SolidBrush(Color.FromArgb(220, 60, 40))\n            g.FillRectangle(camisa, x + 1, y + 14, 24, 6)\n        End Using\n        ' Cabeça / rosto\n        Using pele As New SolidBrush(Color.FromArgb(255, 210, 170))\n            g.FillEllipse(pele, x + 5, y + 2, 16, 14)\n        End Using\n        ' Boné\n        Using bone As New SolidBrush(Color.FromArgb(220, 60, 40))\n            g.FillRectangle(bone, x + 4, y, 18, 6)\n            g.FillRectangle(bone, x + 4 + If(dir > 0, 14.0F, -6.0F), y + 4, 8, 4)\n        End Using\n        ' Bigode\n        Using bigode As New SolidBrush(Color.FromArgb(90, 60, 40))\n            g.FillRectangle(bigode, x + 6 + Math.Max(0.0F, dir) * 6, y + 10, 10, 3)\n        End Using\n        ' Olho\n        Using olho As New SolidBrush(Color.Black)\n            g.FillEllipse(olho, x + 6 + Math.Max(0.0F, dir) * 7, y + 6, 3, 3)\n        End Using\n    End Sub\n\n    Private Sub DesenharFaixaTexto(g As Graphics, texto As String, y As Integer)\n        Using fonte As New Font(\"Segoe UI\", 11, FontStyle.Bold)\n            Dim tamanho As SizeF = g.MeasureString(texto, fonte)\n            Dim caixa As New RectangleF((Me.ClientSize.Width - tamanho.Width) / 2 - 10, y - 4, tamanho.Width + 20, tamanho.Height + 8)\n            Using fundo As New SolidBrush(Color.FromArgb(150, 0, 0, 0))\n                g.FillRectangle(fundo, caixa)\n            End Using\n            Using corTexto As New SolidBrush(Color.White)\n                g.DrawString(texto, fonte, corTexto, caixa.X + 10, caixa.Y + 4)\n            End Using\n        End Using\n    End Sub\n\n    Private Class Goomba\n        Public X As Double\n        Public Y As Double\n        Public MinX As Double\n        Public MaxX As Double\n        Public Direction As Integer\n        Public Alive As Boolean = True\n    End Class\n\nEnd Class\n", "FolderPath": ""}], "Classes": [], "Modules": [], "UserControls": [], "Folders": [], "ApplicationIcon": "", "AssemblyTitle": "AventuraDoEncanador", "AssemblyDescription": "Jogo de plataforma estilo Mario com graficos 100% desenhados por codigo (sem nenhuma imagem)", "AssemblyCompany": "", "AssemblyProduct": "AventuraDoEncanador", "AssemblyCopyright": "", "AssemblyTrademark": "", "AssemblyVersion": "1.0.0.0", "FileVersion": "1.0.0.0", "Libraries": []}