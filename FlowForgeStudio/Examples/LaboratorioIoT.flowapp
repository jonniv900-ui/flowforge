      ],
      "Code": "Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private matrixOn As Boolean\n\n    Private Sub VirtualJoystick1_PositionChanged() Handles VirtualJoystick1.PositionChanged\n        LcdDisplay1.Value = \"X=\" & VirtualJoystick1.XValue.ToString() & \" Y=\" & VirtualJoystick1.YValue.ToString()\n        ArduinoPin2.Value = Math.Max(0, Math.Min(1023, 512 + VirtualJoystick1.XValue * 5))\n        IoTSensorTemp.Value = 25 + (VirtualJoystick1.YValue / 20.0)\n        SevenSegmentDigit1.Value = Math.Abs(VirtualJoystick1.XValue) Mod 10\n    End Sub\n\n    Private Sub ArduinoPin1_ValueChanged() Handles ArduinoPin1.ValueChanged\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"GPIO 13 = \" & ArduinoPin1.Value.ToString()\n    End Sub\n\n    Private Sub CycleButton_Click() Handles CycleButton.Click\n        Select Case TrafficLight1.State\n            Case FlowForgeStudio.TrafficLightState.Red\n                TrafficLight1.State = FlowForgeStudio.TrafficLightState.Green\n            Case FlowForgeStudio.TrafficLightState.Green\n                TrafficLight1.State = FlowForgeStudio.TrafficLightState.Yellow\n            Case Else\n                TrafficLight1.State = FlowForgeStudio.TrafficLightState.Red\n        End Select\n    End Sub\n\n    Private Sub MatrixButton_Click() Handles MatrixButton.Click\n        matrixOn = Not matrixOn\n        If matrixOn Then\n            LedMatrix1.Pattern = \"10000001,01000010,00100100,00011000,00011000,00100100,01000010,10000001\"\n        Else\n            LedMatrix1.Pattern = \"00111100,01000010,10100101,10000001,10100101,10011001,01000010,00111100\"\n        End If\n    End Sub\nEnd Class\n"
    }
