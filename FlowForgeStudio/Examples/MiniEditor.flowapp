{"Name":"MiniEditor","Version":"1.0.2","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Mini Editor"},{"Key":"ClientSize","Value":"984, 661"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"BackColor","Value":"Window"},{"Key":"Font","Value":"Segoe UI, 9pt"},{"Key":"MinimumSize","Value":"720, 480"},{"Key":"KeyPreview","Value":"True"}],"Controls":[{"TypeName":"MenuStrip","Name":"MenuStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"MenuStrip1"},{"Key":"Location","Value":"0, 0"},{"Key":"Size","Value":"984, 24"},{"Key":"Dock","Value":"Top"}],"Items":[{"TypeName":"ToolStripMenuItem","Name":"MenuArquivo","Text":"Arquivo","Properties":[{"Key":"Name","Value":"MenuArquivo"},{"Key":"Text","Value":"Arquivo"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuNovo","Text":"Novo","Properties":[{"Key":"Name","Value":"MenuNovo"},{"Key":"Text","Value":"Novo"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuAbrir","Text":"Abrir...","Properties":[{"Key":"Name","Value":"MenuAbrir"},{"Key":"Text","Value":"Abrir..."}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSalvar","Text":"Salvar","Properties":[{"Key":"Name","Value":"MenuSalvar"},{"Key":"Text","Value":"Salvar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSalvarComo","Text":"Salvar como...","Properties":[{"Key":"Name","Value":"MenuSalvarComo"},{"Key":"Text","Value":"Salvar como..."}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepArq1","Text":"-","Properties":[{"Key":"Name","Value":"SepArq1"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuImprimir","Text":"Imprimir...","Properties":[{"Key":"Name","Value":"MenuImprimir"},{"Key":"Text","Value":"Imprimir..."}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepArq2","Text":"-","Properties":[{"Key":"Name","Value":"SepArq2"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSair","Text":"Sair","Properties":[{"Key":"Name","Value":"MenuSair"},{"Key":"Text","Value":"Sair"}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuEditar","Text":"Editar","Properties":[{"Key":"Name","Value":"MenuEditar"},{"Key":"Text","Value":"Editar"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuDesfazer","Text":"Desfazer","Properties":[{"Key":"Name","Value":"MenuDesfazer"},{"Key":"Text","Value":"Desfazer"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuRefazer","Text":"Refazer","Properties":[{"Key":"Name","Value":"MenuRefazer"},{"Key":"Text","Value":"Refazer"}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepEdit","Text":"-","Properties":[{"Key":"Name","Value":"SepEdit"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuRecortar","Text":"Recortar","Properties":[{"Key":"Name","Value":"MenuRecortar"},{"Key":"Text","Value":"Recortar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuCopiar","Text":"Copiar","Properties":[{"Key":"Name","Value":"MenuCopiar"},{"Key":"Text","Value":"Copiar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuColar","Text":"Colar","Properties":[{"Key":"Name","Value":"MenuColar"},{"Key":"Text","Value":"Colar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSelecionarTudo","Text":"Selecionar tudo","Properties":[{"Key":"Name","Value":"MenuSelecionarTudo"},{"Key":"Text","Value":"Selecionar tudo"}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepBusca","Text":"-","Properties":[{"Key":"Name","Value":"SepBusca"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuLocalizar","Text":"Localizar...","Properties":[{"Key":"Name","Value":"MenuLocalizar"},{"Key":"Text","Value":"Localizar..."}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSubstituir","Text":"Substituir...","Properties":[{"Key":"Name","Value":"MenuSubstituir"},{"Key":"Text","Value":"Substituir..."}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuFormatar","Text":"Formatar","Properties":[{"Key":"Name","Value":"MenuFormatar"},{"Key":"Text","Value":"Formatar"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuFonte","Text":"Fonte...","Properties":[{"Key":"Name","Value":"MenuFonte"},{"Key":"Text","Value":"Fonte..."}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuCor","Text":"Cor...","Properties":[{"Key":"Name","Value":"MenuCor"},{"Key":"Text","Value":"Cor..."}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuNegrito","Text":"Negrito","Properties":[{"Key":"Name","Value":"MenuNegrito"},{"Key":"Text","Value":"Negrito"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuItalico","Text":"Itálico","Properties":[{"Key":"Name","Value":"MenuItalico"},{"Key":"Text","Value":"Itálico"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSublinhado","Text":"Sublinhado","Properties":[{"Key":"Name","Value":"MenuSublinhado"},{"Key":"Text","Value":"Sublinhado"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuQuebra","Text":"Quebra automática","Properties":[{"Key":"Name","Value":"MenuQuebra"},{"Key":"Text","Value":"Quebra automática"},{"Key":"Checked","Value":"True"}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuAjuda","Text":"Ajuda","Properties":[{"Key":"Name","Value":"MenuAjuda"},{"Key":"Text","Value":"Ajuda"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuSobre","Text":"Sobre","Properties":[{"Key":"Name","Value":"MenuSobre"},{"Key":"Text","Value":"Sobre"}],"DropDownItems":[]}]}]},{"TypeName":"ToolStrip","Name":"ToolStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ToolStrip1"},{"Key":"Location","Value":"0, 24"},{"Key":"Size","Value":"984, 28"},{"Key":"Dock","Value":"Top"}],"Items":[{"TypeName":"ToolStripButton","Name":"BtnNovo","Text":"Novo","Properties":[{"Key":"Name","Value":"BtnNovo"},{"Key":"Text","Value":"Novo"},{"Key":"ToolTipText","Value":"Novo"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnAbrir","Text":"Abrir","Properties":[{"Key":"Name","Value":"BtnAbrir"},{"Key":"Text","Value":"Abrir"},{"Key":"ToolTipText","Value":"Abrir"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnSalvar","Text":"Salvar","Properties":[{"Key":"Name","Value":"BtnSalvar"},{"Key":"Text","Value":"Salvar"},{"Key":"ToolTipText","Value":"Salvar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnImprimir","Text":"Imprimir","Properties":[{"Key":"Name","Value":"BtnImprimir"},{"Key":"Text","Value":"Imprimir"},{"Key":"ToolTipText","Value":"Imprimir"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnDesfazer","Text":"Desfazer","Properties":[{"Key":"Name","Value":"BtnDesfazer"},{"Key":"Text","Value":"Desfazer"},{"Key":"ToolTipText","Value":"Desfazer"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnRefazer","Text":"Refazer","Properties":[{"Key":"Name","Value":"BtnRefazer"},{"Key":"Text","Value":"Refazer"},{"Key":"ToolTipText","Value":"Refazer"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnRecortar","Text":"Recortar","Properties":[{"Key":"Name","Value":"BtnRecortar"},{"Key":"Text","Value":"Recortar"},{"Key":"ToolTipText","Value":"Recortar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnCopiar","Text":"Copiar","Properties":[{"Key":"Name","Value":"BtnCopiar"},{"Key":"Text","Value":"Copiar"},{"Key":"ToolTipText","Value":"Copiar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnColar","Text":"Colar","Properties":[{"Key":"Name","Value":"BtnColar"},{"Key":"Text","Value":"Colar"},{"Key":"ToolTipText","Value":"Colar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnNegrito","Text":"Negrito","Properties":[{"Key":"Name","Value":"BtnNegrito"},{"Key":"Text","Value":"Negrito"},{"Key":"ToolTipText","Value":"Negrito"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnItalico","Text":"Itálico","Properties":[{"Key":"Name","Value":"BtnItalico"},{"Key":"Text","Value":"Itálico"},{"Key":"ToolTipText","Value":"Itálico"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnSublinhado","Text":"Sublinhado","Properties":[{"Key":"Name","Value":"BtnSublinhado"},{"Key":"Text","Value":"Sublinhado"},{"Key":"ToolTipText","Value":"Sublinhado"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnEsquerda","Text":"Alinhar à esquerda","Properties":[{"Key":"Name","Value":"BtnEsquerda"},{"Key":"Text","Value":"Alinhar à esquerda"},{"Key":"ToolTipText","Value":"Alinhar à esquerda"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnCentro","Text":"Centralizar","Properties":[{"Key":"Name","Value":"BtnCentro"},{"Key":"Text","Value":"Centralizar"},{"Key":"ToolTipText","Value":"Centralizar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnDireita","Text":"Alinhar à direita","Properties":[{"Key":"Name","Value":"BtnDireita"},{"Key":"Text","Value":"Alinhar à direita"},{"Key":"ToolTipText","Value":"Alinhar à direita"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnCor","Text":"Cor do texto","Properties":[{"Key":"Name","Value":"BtnCor"},{"Key":"Text","Value":"Cor do texto"},{"Key":"ToolTipText","Value":"Cor do texto"}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepFonte","Text":"-","Properties":[{"Key":"Name","Value":"SepFonte"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripComboBox","Name":"ComboFonte","Text":"Segoe UI","Properties":[{"Key":"Name","Value":"ComboFonte"},{"Key":"Text","Value":"Segoe UI"},{"Key":"ToolTipText","Value":"Fonte"}],"DropDownItems":[]},{"TypeName":"ToolStripTextBox","Name":"CampoTamanho","Text":"11","Properties":[{"Key":"Name","Value":"CampoTamanho"},{"Key":"Text","Value":"11"},{"Key":"ToolTipText","Value":"Tamanho"}],"DropDownItems":[]}]},{"TypeName":"RichTextBox","Name":"RichTextBoxEditor","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"RichTextBoxEditor"},{"Key":"Location","Value":"0, 52"},{"Key":"Size","Value":"984, 587"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"},{"Key":"AcceptsTab","Value":"True"},{"Key":"DetectUrls","Value":"True"},{"Key":"EnableAutoDragDrop","Value":"True"},{"Key":"Font","Value":"Segoe UI, 11pt"},{"Key":"WordWrap","Value":"True"},{"Key":"BorderStyle","Value":"None"}],"Items":[]},{"TypeName":"StatusStrip","Name":"StatusStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"StatusStrip1"},{"Key":"Location","Value":"0, 639"},{"Key":"Size","Value":"984, 22"},{"Key":"Dock","Value":"Bottom"}],"Items":[{"TypeName":"ToolStripStatusLabel","Name":"StatusArquivo","Text":"Sem título","Properties":[{"Key":"Name","Value":"StatusArquivo"},{"Key":"Text","Value":"Sem título"}],"DropDownItems":[]},{"TypeName":"ToolStripStatusLabel","Name":"StatusPosicao","Text":"Linha 1, Coluna 1","Properties":[{"Key":"Name","Value":"StatusPosicao"},{"Key":"Text","Value":"Linha 1, Coluna 1"}],"DropDownItems":[]},{"TypeName":"ToolStripStatusLabel","Name":"StatusContagem","Text":"0 caracteres","Properties":[{"Key":"Name","Value":"StatusContagem"},{"Key":"Text","Value":"0 caracteres"}],"DropDownItems":[]}]}],"Code":"Imports System\r\nImports System.Drawing\r\nImports System.Drawing.Drawing2D\r\nImports System.Drawing.Printing\r\nImports System.IO\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private arquivoAtual As String = \"\"\r\n    Private alterado As Boolean\r\n    Private carregando As Boolean\r\n\r\n    Private Sub Form1_Load() Handles MyBase.Load\r\n        AplicarIcones()\r\n        For Each familia As FontFamily In FontFamily.Families\r\n            ComboFonte.Items.Add(familia.Name)\r\n        Next\r\n        ComboFonte.Text = RichTextBoxEditor.Font.Name\r\n        AtualizarEstado()\r\n    End Sub\r\n\r\n    Private Function CriarIcone(simbolo As String, fundo As Color) As Bitmap\r\n        Dim imagem As New Bitmap(24, 24)\r\n        Using g As Graphics = Graphics.FromImage(imagem)\r\n            g.SmoothingMode = SmoothingMode.AntiAlias : g.Clear(Color.Transparent)\r\n            Using b As New SolidBrush(fundo) : g.FillRectangle(b, 1, 1, 22, 22) : End Using\r\n            Using f As New Font(\"Segoe UI Symbol\", 10, FontStyle.Bold), b As New SolidBrush(Color.White)\r\n                Dim sf As New StringFormat With {.Alignment = StringAlignment.Center, .LineAlignment = StringAlignment.Center}\r\n                g.DrawString(simbolo, f, b, New RectangleF(0, 0, 24, 24), sf)\r\n            End Using\r\n        End Using\r\n        Return imagem\r\n    End Function\r\n\r\n    Private Sub AplicarIcones()\r\n        Dim botoes As ToolStripButton() = {BtnNovo, BtnAbrir, BtnSalvar, BtnImprimir, BtnDesfazer, BtnRefazer, BtnRecortar, BtnCopiar, BtnColar, BtnNegrito, BtnItalico, BtnSublinhado, BtnEsquerda, BtnCentro, BtnDireita, BtnCor}\r\n        Dim simbolos As String() = {\"N\", \"↗\", \"S\", \"P\", \"↶\", \"↷\", \"✂\", \"C\", \"V\", \"B\", \"I\", \"U\", \"≪\", \"≡\", \"≫\", \"A\"}\r\n        Dim cores As Color() = {Color.Teal, Color.SteelBlue, Color.SeaGreen, Color.DarkSlateBlue, Color.DimGray, Color.DimGray, Color.Firebrick, Color.RoyalBlue, Color.DarkCyan, Color.Black, Color.DarkSlateGray, Color.Navy, Color.SlateGray, Color.SlateGray, Color.SlateGray, Color.MediumVioletRed}\r\n        For i As Integer = 0 To botoes.Length - 1\r\n            botoes(i).Image = CriarIcone(simbolos(i), cores(i)) : botoes(i).DisplayStyle = ToolStripItemDisplayStyle.Image\r\n        Next\r\n    End Sub\r\n\r\n    Private Function ConfirmarDescarte() As Boolean\r\n        If Not alterado Then Return True\r\n        Dim resposta = MessageBox.Show(\"Deseja salvar as alterações?\", \"Mini Editor\", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)\r\n        If resposta = DialogResult.Cancel Then Return False\r\n        If resposta = DialogResult.Yes Then Salvar_Click()\r\n        Return Not alterado\r\n    End Function\r\n\r\n    Private Sub Novo_Click() Handles MenuNovo.Click, BtnNovo.Click\r\n        If Not ConfirmarDescarte() Then Return\r\n        carregando = True : RichTextBoxEditor.Clear() : arquivoAtual = \"\" : alterado = False : carregando = False : AtualizarEstado()\r\n    End Sub\r\n\r\n    Private Sub Abrir_Click() Handles MenuAbrir.Click, BtnAbrir.Click\r\n        If Not ConfirmarDescarte() Then Return\r\n        Using d As New OpenFileDialog With {.Filter = \"Documentos|*.txt;*.rtf|Texto|*.txt|Rich Text|*.rtf|Todos|*.*\"}\r\n            If d.ShowDialog() <> DialogResult.OK Then Return\r\n            carregando = True\r\n            If Path.GetExtension(d.FileName).Equals(\".rtf\", StringComparison.OrdinalIgnoreCase) Then RichTextBoxEditor.LoadFile(d.FileName, RichTextBoxStreamType.RichText) Else RichTextBoxEditor.Text = File.ReadAllText(d.FileName)\r\n            arquivoAtual = d.FileName : alterado = False : carregando = False : AtualizarEstado()\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub Salvar_Click() Handles MenuSalvar.Click, BtnSalvar.Click\r\n        If arquivoAtual = \"\" Then SalvarComo_Click() : Return\r\n        SalvarArquivo(arquivoAtual)\r\n    End Sub\r\n\r\n    Private Sub SalvarComo_Click() Handles MenuSalvarComo.Click\r\n        Using d As New SaveFileDialog With {.Filter = \"Texto|*.txt|Rich Text|*.rtf\", .DefaultExt = \"txt\"}\r\n            If d.ShowDialog() = DialogResult.OK Then arquivoAtual = d.FileName : SalvarArquivo(arquivoAtual)\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub SalvarArquivo(caminho As String)\r\n        If Path.GetExtension(caminho).Equals(\".rtf\", StringComparison.OrdinalIgnoreCase) Then RichTextBoxEditor.SaveFile(caminho, RichTextBoxStreamType.RichText) Else File.WriteAllText(caminho, RichTextBoxEditor.Text)\r\n        alterado = False : AtualizarEstado()\r\n    End Sub\r\n\r\n    Private Sub Imprimir_Click() Handles MenuImprimir.Click, BtnImprimir.Click\r\n        Using documento As New PrintDocument()\r\n            AddHandler documento.PrintPage, Sub(s, e) e.Graphics.DrawString(RichTextBoxEditor.Text, RichTextBoxEditor.Font, Brushes.Black, e.MarginBounds)\r\n            Using d As New PrintDialog With {.Document = documento}\r\n                If d.ShowDialog() = DialogResult.OK Then documento.Print()\r\n            End Using\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub Desfazer_Click() Handles MenuDesfazer.Click, BtnDesfazer.Click\r\n        If RichTextBoxEditor.CanUndo Then RichTextBoxEditor.Undo()\r\n    End Sub\r\n    Private Sub Refazer_Click() Handles MenuRefazer.Click, BtnRefazer.Click\r\n        If RichTextBoxEditor.CanRedo Then RichTextBoxEditor.Redo()\r\n    End Sub\r\n    Private Sub Recortar_Click() Handles MenuRecortar.Click, BtnRecortar.Click\r\n        RichTextBoxEditor.Cut()\r\n    End Sub\r\n    Private Sub Copiar_Click() Handles MenuCopiar.Click, BtnCopiar.Click\r\n        RichTextBoxEditor.Copy()\r\n    End Sub\r\n    Private Sub Colar_Click() Handles MenuColar.Click, BtnColar.Click\r\n        RichTextBoxEditor.Paste()\r\n    End Sub\r\n    Private Sub SelecionarTudo_Click() Handles MenuSelecionarTudo.Click\r\n        RichTextBoxEditor.SelectAll()\r\n    End Sub\r\n\r\n    Private Sub AlternarEstilo(estilo As FontStyle)\r\n        Dim atual As Font = If(RichTextBoxEditor.SelectionFont, RichTextBoxEditor.Font)\r\n        Dim novoEstilo As FontStyle = CType(CInt(atual.Style) Xor CInt(estilo), FontStyle)\r\n        RichTextBoxEditor.SelectionFont = New Font(atual, novoEstilo)\r\n    End Sub\r\n    Private Sub Negrito_Click() Handles BtnNegrito.Click, MenuNegrito.Click\r\n        AlternarEstilo(FontStyle.Bold)\r\n    End Sub\r\n    Private Sub Italico_Click() Handles BtnItalico.Click, MenuItalico.Click\r\n        AlternarEstilo(FontStyle.Italic)\r\n    End Sub\r\n    Private Sub Sublinhado_Click() Handles BtnSublinhado.Click, MenuSublinhado.Click\r\n        AlternarEstilo(FontStyle.Underline)\r\n    End Sub\r\n\r\n    Private Sub Fonte_Click() Handles MenuFonte.Click\r\n        Using d As New FontDialog With {.Font = If(RichTextBoxEditor.SelectionFont, RichTextBoxEditor.Font), .ShowColor = True, .Color = RichTextBoxEditor.SelectionColor}\r\n            If d.ShowDialog() = DialogResult.OK Then RichTextBoxEditor.SelectionFont = d.Font : RichTextBoxEditor.SelectionColor = d.Color\r\n        End Using\r\n    End Sub\r\n    Private Sub Cor_Click() Handles MenuCor.Click, BtnCor.Click\r\n        Using d As New ColorDialog With {.Color = RichTextBoxEditor.SelectionColor, .FullOpen = True}\r\n            If d.ShowDialog() = DialogResult.OK Then RichTextBoxEditor.SelectionColor = d.Color\r\n        End Using\r\n    End Sub\r\n    Private Sub ComboFonte_SelectedIndexChanged() Handles ComboFonte.SelectedIndexChanged\r\n        If ComboFonte.Text = \"\" Then Return\r\n        Dim atual As Font = If(RichTextBoxEditor.SelectionFont, RichTextBoxEditor.Font)\r\n        Try : RichTextBoxEditor.SelectionFont = New Font(ComboFonte.Text, atual.Size, atual.Style) : Catch : End Try\r\n    End Sub\r\n    Private Sub Tamanho_TextChanged() Handles CampoTamanho.TextChanged\r\n        Dim tamanho As Single\r\n        If Not Single.TryParse(CampoTamanho.Text, tamanho) OrElse tamanho < 6 OrElse tamanho > 200 Then Return\r\n        Dim atual As Font = If(RichTextBoxEditor.SelectionFont, RichTextBoxEditor.Font)\r\n        RichTextBoxEditor.SelectionFont = New Font(atual.FontFamily, tamanho, atual.Style)\r\n    End Sub\r\n\r\n    Private Sub Esquerda_Click() Handles BtnEsquerda.Click\r\n        RichTextBoxEditor.SelectionAlignment = HorizontalAlignment.Left\r\n    End Sub\r\n    Private Sub Centro_Click() Handles BtnCentro.Click\r\n        RichTextBoxEditor.SelectionAlignment = HorizontalAlignment.Center\r\n    End Sub\r\n    Private Sub Direita_Click() Handles BtnDireita.Click\r\n        RichTextBoxEditor.SelectionAlignment = HorizontalAlignment.Right\r\n    End Sub\r\n    Private Sub Quebra_Click() Handles MenuQuebra.Click\r\n        RichTextBoxEditor.WordWrap = Not RichTextBoxEditor.WordWrap : MenuQuebra.Checked = RichTextBoxEditor.WordWrap\r\n    End Sub\r\n\r\n    Private Sub Localizar_Click() Handles MenuLocalizar.Click\r\n        Dim termo = Microsoft.VisualBasic.Interaction.InputBox(\"Texto a localizar:\", \"Localizar\")\r\n        If termo = \"\" Then Return\r\n        Dim inicio = Math.Max(0, RichTextBoxEditor.SelectionStart + RichTextBoxEditor.SelectionLength)\r\n        Dim pos = RichTextBoxEditor.Find(termo, inicio, RichTextBoxFinds.None)\r\n        If pos < 0 Then MessageBox.Show(\"Texto não encontrado.\", \"Localizar\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n    End Sub\r\n    Private Sub Substituir_Click() Handles MenuSubstituir.Click\r\n        Dim termo = Microsoft.VisualBasic.Interaction.InputBox(\"Texto a localizar:\", \"Substituir\")\r\n        If termo = \"\" Then Return\r\n        Dim novo = Microsoft.VisualBasic.Interaction.InputBox(\"Substituir por:\", \"Substituir\")\r\n        RichTextBoxEditor.Text = RichTextBoxEditor.Text.Replace(termo, novo)\r\n    End Sub\r\n\r\n    Private Sub Editor_TextChanged() Handles RichTextBoxEditor.TextChanged\r\n        If Not carregando Then alterado = True\r\n        AtualizarEstado()\r\n    End Sub\r\n    Private Sub Editor_SelectionChanged() Handles RichTextBoxEditor.SelectionChanged\r\n        AtualizarEstado()\r\n    End Sub\r\n    Private Sub AtualizarEstado()\r\n        Dim linha = RichTextBoxEditor.GetLineFromCharIndex(RichTextBoxEditor.SelectionStart) + 1\r\n        Dim inicioLinha = RichTextBoxEditor.GetFirstCharIndexOfCurrentLine()\r\n        StatusArquivo.Text = If(arquivoAtual = \"\", \"Sem título\", Path.GetFileName(arquivoAtual)) & If(alterado, \" *\", \"\")\r\n        StatusPosicao.Text = \"Linha \" & linha & \", Coluna \" & (RichTextBoxEditor.SelectionStart - inicioLinha + 1)\r\n        StatusContagem.Text = RichTextBoxEditor.TextLength & \" caracteres\"\r\n        Text = \"Mini Editor - \" & StatusArquivo.Text\r\n    End Sub\r\n\r\n    Private Sub Sair_Click() Handles MenuSair.Click\r\n        Close()\r\n    End Sub\r\n    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing\r\n        If Not ConfirmarDescarte() Then e.Cancel = True\r\n    End Sub\r\n    Private Sub Sobre_Click() Handles MenuSobre.Click\r\n        MessageBox.Show(\"Mini Editor 1.0\" & Environment.NewLine & \"Exemplo criado no FlowForge.\", \"Sobre\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n    End Sub\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"Mini Editor","AssemblyDescription":"Mini editor de texto criado no FlowForge","AssemblyCompany":"Wtec","AssemblyProduct":"Mini Editor","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"FlowForge","AssemblyVersion":"1.0.2.0","FileVersion":"1.0.2.0"}