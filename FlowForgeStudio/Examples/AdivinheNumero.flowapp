{"Name":"AdivinheNumero","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Adivinhe o Numero"},{"Key":"ClientSize","Value":"360, 320"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"FixedSingle"},{"Key":"BackColor","Value":"White"},{"Key":"Font","Value":"Segoe UI, 10pt"},{"Key":"MaximizeBox","Value":"False"},{"Key":"MinimizeBox","Value":"True"}],"Controls":[{"TypeName":"Label","Name":"LabelInstrucao","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelInstrucao"},{"Key":"Location","Value":"20, 20"},{"Key":"Size","Value":"320, 40"},{"Key":"Text","Value":"Pensei em um numero entre 1 e 100. Tente adivinhar!"}],"Items":[]},{"TypeName":"Label","Name":"LabelPalpite","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelPalpite"},{"Key":"Location","Value":"20, 85"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Seu palpite:"}],"Items":[]},{"TypeName":"TextBox","Name":"TextBoxPalpite","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TextBoxPalpite"},{"Key":"Location","Value":"120, 81"},{"Key":"Size","Value":"100, 27"},{"Key":"TextAlign","Value":"Center"}],"Items":[]},{"TypeName":"Button","Name":"ButtonTentar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonTentar"},{"Key":"Location","Value":"230, 80"},{"Key":"Size","Value":"110, 29"},{"Key":"Text","Value":"Tentar"}],"Items":[]},{"TypeName":"Label","Name":"LabelResultado","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelResultado"},{"Key":"Location","Value":"20, 125"},{"Key":"Size","Value":"320, 65"},{"Key":"Text","Value":""},{"Key":"Font","Value":"Segoe UI, 11pt, style=Bold"}],"Items":[]},{"TypeName":"Label","Name":"LabelTentativas","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelTentativas"},{"Key":"Location","Value":"20, 200"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Tentativas: 0"}],"Items":[]},{"TypeName":"Button","Name":"ButtonNovoJogo","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonNovoJogo"},{"Key":"Location","Value":"20, 240"},{"Key":"Size","Value":"320, 38"},{"Key":"Text","Value":"Novo jogo"},{"Key":"BackColor","Value":"MediumSeaGreen"},{"Key":"ForeColor","Value":"White"}],"Items":[]}],"Code":"Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private numeroSecreto As Integer\n    Private tentativas As Integer\n    Private ReadOnly sorteio As New Random()\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        IniciarNovoJogo()\n    End Sub\n\n    Private Sub IniciarNovoJogo()\n        numeroSecreto = sorteio.Next(1, 101) ' numero inteiro de 1 a 100\n        tentativas = 0\n        LabelResultado.ForeColor = Color.Black\n        LabelResultado.Text = \"\"\n        LabelTentativas.Text = \"Tentativas: 0\"\n        TextBoxPalpite.Text = \"\"\n        TextBoxPalpite.Focus()\n    End Sub\n\n    Private Sub ButtonTentar_Click() Handles ButtonTentar.Click\n        Dim palpite As Integer\n        If Not Integer.TryParse(TextBoxPalpite.Text, palpite) Then\n            LabelResultado.ForeColor = Color.DarkRed\n            LabelResultado.Text = \"Digite um numero inteiro valido.\"\n            Return\n        End If\n\n        tentativas += 1\n        LabelTentativas.Text = \"Tentativas: \" & tentativas\n\n        If palpite = numeroSecreto Then\n            LabelResultado.ForeColor = Color.SeaGreen\n            LabelResultado.Text = \"Parabens! Voce acertou em \" & tentativas & \" tentativa(s).\"\n        ElseIf palpite < numeroSecreto Then\n            LabelResultado.ForeColor = Color.DarkOrange\n            LabelResultado.Text = \"O numero secreto e MAIOR que \" & palpite & \".\"\n        Else\n            LabelResultado.ForeColor = Color.DarkOrange\n            LabelResultado.Text = \"O numero secreto e MENOR que \" & palpite & \".\"\n        End If\n\n        TextBoxPalpite.SelectAll()\n        TextBoxPalpite.Focus()\n    End Sub\n\n    Private Sub ButtonNovoJogo_Click() Handles ButtonNovoJogo.Click\n        IniciarNovoJogo()\n    End Sub\n\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"","AssemblyDescription":"","AssemblyCompany":"","AssemblyProduct":"","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}