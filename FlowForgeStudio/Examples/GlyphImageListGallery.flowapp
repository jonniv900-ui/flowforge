      "Code": "Imports FlowForgeStudio\nImports System\nImports System.Drawing\nImports System.Windows.Forms\n' EXEMPLO COMENTADO do GlyphImageList. Não existem PNGs externos.\nPartial Public Class Form1\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\n        CategoryBox.Items.AddRange(New Object() {\"File\",\"Edit\",\"Text\",\"Navigation\",\"UI\",\"Image\",\"Media\",\"Network\",\"Hardware\",\"Database\",\"Development\",\"IoT\",\"Security\",\"System\",\"Status\",\"Office\"})\n        CategoryBox.SelectedIndex = 0\n        ThemeBox.Items.AddRange(New Object() {\"Modern\",\"Office2003\",\"Classic\",\"Windows9x\",\"Dark\",\"Monochrome\"})\n        ThemeBox.SelectedIndex = 0\n        FillGallery()\n    End Sub\n    Private Sub LoadButton_Click(sender As Object, e As System.EventArgs) Handles LoadButton.Click\n        Dim selectedTheme As FlowForgeStudio.GlyphTheme\n        If [Enum].TryParse(Of FlowForgeStudio.GlyphTheme)(ThemeBox.Text, selectedTheme) Then Glyphs1.Theme = selectedTheme\n        FillGallery()\n    End Sub\n    Private Sub FillGallery()\n        GalleryPanel.Controls.Clear()\n        Dim prefix As String = CategoryBox.Text & \"_\"\n        ' Percorre o enum completo e filtra pela categoria.\n        For Each glyph As FlowForgeStudio.GlyphType In [Enum].GetValues(GetType(FlowForgeStudio.GlyphType))\n            If Not glyph.ToString().StartsWith(prefix, StringComparison.OrdinalIgnoreCase) Then Continue For\n            Dim b As New Button()\n            b.Width=150 : b.Height=54\n            b.Text=glyph.ToString().Substring(prefix.Length)\n            b.TextImageRelation=TextImageRelation.ImageBeforeText\n            b.Image=Glyphs1.GetGlyph(glyph)\n            b.Tag=glyph\n            AddHandler b.Click, AddressOf GlyphButtonClick\n            GalleryPanel.Controls.Add(b)\n        Next\n    End Sub\n    Private Sub GlyphButtonClick(sender As Object, e As System.EventArgs)\n        Dim b As Button=DirectCast(sender,Button)\n        MessageBox.Show(\"FlowForgeStudio.GlyphType.\" & b.Tag.ToString(),\"Glyph selecionado\")\n    End Sub\nEnd Class\n"
    }
