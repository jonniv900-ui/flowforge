      "Code": "Imports System\nImports System.Collections.Generic\nImports System.Diagnostics\nImports System.Globalization\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Class WifiEntry\n        Public Property SSID As String\n        Public Property BSSID As String\n        Public Property Signal As Integer\n        Public Property Channel As Integer\n        Public Property Band As String\n        Public Property Security As String\n        Public Property Radio As String\n    End Class\n\n    Private ReadOnly Networks As New List(Of WifiEntry)()\n\n    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load\n        ConfigureGrid()\n        SignalBars.Value = 0\n        SignalDisplay.Value = \"-- dBm\"\n        SignalSparkline.DataPoints = \"\"\n        ChannelChart.DataPoints = \"\"\n        ScanWifi()\n    End Sub\n\n    Private Sub ConfigureGrid()\n        GridWifi.AutoGenerateColumns = False\n        GridWifi.AllowUserToAddRows = False\n        GridWifi.AllowUserToDeleteRows = False\n        GridWifi.ReadOnly = True\n        GridWifi.MultiSelect = False\n        GridWifi.SelectionMode = DataGridViewSelectionMode.FullRowSelect\n        GridWifi.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill\n        GridWifi.Columns.Clear()\n        GridWifi.Columns.Add(\"SSID\", \"SSID\")\n        GridWifi.Columns.Add(\"BSSID\", \"BSSID\")\n        GridWifi.Columns.Add(\"Signal\", \"Sinal\")\n        GridWifi.Columns.Add(\"Channel\", \"Canal\")\n        GridWifi.Columns.Add(\"Band\", \"Banda\")\n        GridWifi.Columns.Add(\"Security\", \"Segurança\")\n        GridWifi.Columns.Add(\"Radio\", \"Rádio\")\n    End Sub\n\n    Private Sub RefreshButton_Click(sender As Object, e As EventArgs) Handles RefreshButton.Click\n        ScanWifi()\n    End Sub\n\n    Private Sub SearchBox1_Search(sender As Object, e As EventArgs) Handles SearchBox1.Search\n        RefreshGrid()\n    End Sub\n\n    Private Sub ScanWifi()\n        RefreshButton.Enabled = False\n        StatusLabel.Text = \"Procurando redes Wi-Fi...\"\n        Networks.Clear()\n        GridWifi.Rows.Clear()\n        SignalSparkline.DataPoints = \"\"\n        ChannelChart.DataPoints = \"\"\n\n        Try\n            Dim output As String = RunNetsh()\n            If String.IsNullOrWhiteSpace(output) Then\n                StatusLabel.Text = \"O netsh não retornou redes. Verifique se o Wi-Fi está ativo.\"\n                Return\n            End If\n\n            ParseNetworks(output)\n            RefreshGrid()\n            UpdateCharts()\n\n            If Networks.Count = 0 Then\n                StatusLabel.Text = \"Nenhuma rede Wi-Fi encontrada.\"\n            Else\n                StatusLabel.Text = Networks.Count.ToString() & \" ponto(s) de acesso encontrado(s).\"\n            End If\n        Catch ex As Exception\n            StatusLabel.Text = \"Falha ao consultar o Wi-Fi: \" & ex.Message\n        Finally\n            RefreshButton.Enabled = True\n        End Try\n    End Sub\n\n    Private Function RunNetsh() As String\n        Dim info As New ProcessStartInfo()\n        info.FileName = \"netsh\"\n        info.Arguments = \"wlan show networks mode=bssid\"\n        info.UseShellExecute = False\n        info.CreateNoWindow = True\n        info.RedirectStandardOutput = True\n        info.RedirectStandardError = True\n\n        Using process As New Process()\n            process.StartInfo = info\n            process.Start()\n            Dim output As String = process.StandardOutput.ReadToEnd()\n            Dim errors As String = process.StandardError.ReadToEnd()\n            process.WaitForExit()\n\n            If String.IsNullOrWhiteSpace(output) AndAlso Not String.IsNullOrWhiteSpace(errors) Then\n                Throw New InvalidOperationException(errors.Trim())\n            End If\n            Return output\n        End Using\n    End Function\n\n    Private Sub ParseNetworks(output As String)\n        Dim currentSsid As String = \"\"\n        Dim currentSecurity As String = \"\"\n        Dim currentRadio As String = \"\"\n        Dim currentBand As String = \"\"\n        Dim current As WifiEntry = Nothing\n\n        Dim normalized As String = output.Replace(System.Convert.ToChar(13).ToString(), \"\")\n        Dim lines As String() = normalized.Split(New Char() {System.Convert.ToChar(10)})\n\n        For Each raw As String In lines\n            Dim line As String = raw.Trim()\n            If line = \"\" Then Continue For\n\n            If IsSsidLine(line) Then\n                AddCurrent(current)\n                current = Nothing\n                currentSsid = ValueAfterColon(line)\n                currentSecurity = \"\"\n                currentRadio = \"\"\n                currentBand = \"\"\n                Continue For\n            End If\n\n            If line.StartsWith(\"BSSID \", StringComparison.OrdinalIgnoreCase) Then\n                AddCurrent(current)\n                current = New WifiEntry() With {\n                    .SSID = If(currentSsid = \"\", \"(SSID oculto)\", currentSsid),\n                    .BSSID = ValueAfterColon(line),\n                    .Signal = 0,\n                    .Channel = 0,\n                    .Band = currentBand,\n                    .Security = currentSecurity,\n                    .Radio = currentRadio\n                }\n                Continue For\n            End If\n\n            Dim lower As String = line.ToLowerInvariant()\n\n            If lower.StartsWith(\"signal\") OrElse lower.StartsWith(\"sinal\") Then\n                If current IsNot Nothing Then current.Signal = ParsePercent(ValueAfterColon(line))\n            ElseIf lower.StartsWith(\"channel\") OrElse lower.StartsWith(\"canal\") Then\n                If current IsNot Nothing Then\n                    Dim channel As Integer\n                    If Integer.TryParse(ValueAfterColon(line), channel) Then current.Channel = channel\n                End If\n            ElseIf lower.StartsWith(\"band\") OrElse lower.StartsWith(\"banda\") Then\n                currentBand = ValueAfterColon(line)\n                If current IsNot Nothing Then current.Band = currentBand\n            ElseIf lower.Contains(\"authent\") OrElse lower.Contains(\"autent\") Then\n                currentSecurity = ValueAfterColon(line)\n                If current IsNot Nothing Then current.Security = currentSecurity\n            ElseIf lower.Contains(\"radio type\") OrElse lower.Contains(\"tipo de r\") Then\n                currentRadio = ValueAfterColon(line)\n                If current IsNot Nothing Then current.Radio = currentRadio\n            ElseIf lower.Contains(\"cipher\") OrElse lower.Contains(\"cript\") Then\n                Dim cipher As String = ValueAfterColon(line)\n                If cipher <> \"\" Then\n                    If currentSecurity = \"\" Then\n                        currentSecurity = cipher\n                    Else\n                        currentSecurity &= \" / \" & cipher\n                    End If\n                    If current IsNot Nothing Then current.Security = currentSecurity\n                End If\n            End If\n        Next\n\n        AddCurrent(current)\n\n        For Each item As WifiEntry In Networks\n            If String.IsNullOrWhiteSpace(item.Band) Then item.Band = InferBand(item.Channel)\n            If String.IsNullOrWhiteSpace(item.Security) Then item.Security = \"Não informado\"\n            If String.IsNullOrWhiteSpace(item.Radio) Then item.Radio = \"-\"\n        Next\n    End Sub\n\n    Private Function IsSsidLine(line As String) As Boolean\n        If line.StartsWith(\"BSSID \", StringComparison.OrdinalIgnoreCase) Then Return False\n        If Not line.StartsWith(\"SSID \", StringComparison.OrdinalIgnoreCase) Then Return False\n        Dim colon As Integer = line.IndexOf(\":\"c)\n        If colon <= 4 Then Return False\n        Dim numberText As String = line.Substring(4, colon - 4).Trim()\n        Dim number As Integer\n        Return Integer.TryParse(numberText, number)\n    End Function\n\n    Private Sub AddCurrent(item As WifiEntry)\n        If item Is Nothing OrElse String.IsNullOrWhiteSpace(item.BSSID) Then Return\n        Networks.Add(item)\n    End Sub\n\n    Private Function ValueAfterColon(line As String) As String\n        Dim pos As Integer = line.IndexOf(\":\"c)\n        If pos < 0 OrElse pos >= line.Length - 1 Then Return \"\"\n        Return line.Substring(pos + 1).Trim()\n    End Function\n\n    Private Function ParsePercent(value As String) As Integer\n        Dim cleaned As String = value.Replace(\"%\", \"\").Trim()\n        Dim number As Integer\n        If Not Integer.TryParse(cleaned, number) Then Return 0\n        Return Math.Max(0, Math.Min(100, number))\n    End Function\n\n    Private Function InferBand(channel As Integer) As String\n        If channel >= 1 AndAlso channel <= 14 Then Return \"2,4 GHz\"\n        If channel > 14 Then Return \"5/6 GHz\"\n        Return \"-\"\n    End Function\n\n    Private Sub RefreshGrid()\n        Dim filter As String = SearchBox1.Text.Trim()\n        GridWifi.Rows.Clear()\n\n        For Each item As WifiEntry In Networks\n            If filter <> \"\" AndAlso\n               item.SSID.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0 AndAlso\n               item.BSSID.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0 AndAlso\n               item.Security.IndexOf(filter, StringComparison.OrdinalIgnoreCase) < 0 Then Continue For\n\n            GridWifi.Rows.Add(item.SSID, item.BSSID,\n                              item.Signal.ToString(CultureInfo.InvariantCulture) & \"%\",\n                              If(item.Channel = 0, \"-\", item.Channel.ToString(CultureInfo.InvariantCulture)),\n                              item.Band, item.Security, item.Radio)\n        Next\n    End Sub\n\n    Private Sub GridWifi_SelectionChanged(sender As Object, e As EventArgs) Handles GridWifi.SelectionChanged\n        If GridWifi.SelectedRows.Count = 0 Then Return\n\n        Dim bssid As String = Convert.ToString(GridWifi.SelectedRows(0).Cells(\"BSSID\").Value)\n        Dim selected As WifiEntry = Nothing\n        For Each item As WifiEntry In Networks\n            If String.Equals(item.BSSID, bssid, StringComparison.OrdinalIgnoreCase) Then\n                selected = item\n                Exit For\n            End If\n        Next\n        If selected Is Nothing Then Return\n\n        SignalBars.Value = selected.Signal\n        SignalDisplay.Value = EstimateRssi(selected.Signal).ToString(CultureInfo.InvariantCulture) & \" dBm\"\n        SelectedLabel.Text = selected.SSID & \"   |   Canal \" &\n                             If(selected.Channel = 0, \"-\", selected.Channel.ToString()) &\n                             \"   |   \" & selected.Band\n    End Sub\n\n    Private Function EstimateRssi(signalPercent As Integer) As Integer\n        Return CInt(Math.Round(signalPercent / 2.0 - 100.0))\n    End Function\n\n    Private Sub UpdateCharts()\n        Dim signalValues As New List(Of String)()\n        For Each item As WifiEntry In Networks\n            signalValues.Add(item.Signal.ToString(CultureInfo.InvariantCulture))\n        Next\n        SignalSparkline.DataPoints = String.Join(\",\", signalValues.ToArray())\n\n        Dim channels(13) As Integer\n        For Each item As WifiEntry In Networks\n            If item.Channel >= 1 AndAlso item.Channel <= 14 Then\n                channels(item.Channel - 1) += 1\n            End If\n        Next\n\n        Dim channelValues As New List(Of String)()\n        For Each count As Integer In channels\n            channelValues.Add(count.ToString(CultureInfo.InvariantCulture))\n        Next\n        ChannelChart.DataPoints = String.Join(\",\", channelValues.ToArray())\n    End Sub\nEnd Class\n"
    }
  ],
