{"ApplicationIcon":"","AssemblyCompany":"Wtec","AssemblyCopyright":"Copyright © 2026","AssemblyDescription":"Mini jogo estilo Flappy Bird em Windows Forms","AssemblyProduct":"FlappyBirdVB","AssemblyTitle":"FlappyBirdVB","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0","Forms":[{"Code":"Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private birdPosY As Integer = 200\n    Private birdPosX As Integer = 80\n    Private birdSize As Integer = 30\n    Private gravity As Double = 0.6\n    Private lift As Double = -8.5\n    Private velocity As Double = 0\n\n    Private pipeX As Integer = 400\n    Private pipeWidth As Integer = 60\n    Private pipeGap As Integer = 130\n    Private pipeSpeed As Integer = 5\n    Private topPipeHeight As Integer = 150\n\n    Private score As Integer = 0\n    Private isPlaying As Boolean = False\n    Private rand As New Random()\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        Me.SetStyle(ControlStyles.AllPaintingInWmPaint Or ControlStyles.UserPaint Or ControlStyles.DoubleBuffer, True)\n    End Sub\n\n    Private Sub Form1_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown\n        If e.KeyCode = Keys.Space Then\n            If isPlaying Then\n                velocity = lift\n            Else\n                IniciarJogo()\n            End If\n            e.Handled = True\n        ElseIf e.KeyCode = Keys.Enter Then\n            If Not isPlaying Then\n                IniciarJogo()\n            End If\n            e.Handled = True\n        End If\n    End Sub\n\n    Private Sub Form1_MouseClick(sender As Object, e As MouseEventArgs) Handles MyBase.MouseClick, lblInstrucoes.Click, lblScore.Click\n        If Not isPlaying Then\n            IniciarJogo()\n        Else\n            velocity = lift\n        End If\n    End Sub\n\n    Private Sub IniciarJogo()\n        birdPosY = 200\n        velocity = 0\n        pipeX = 400\n        score = 0\n        lblScore.Text = \"0\"\n        lblInstrucoes.Visible = False\n        GerarNovoCano()\n        gameTimer.Start()\n        isPlaying = True\n    End Sub\n\n    Private Sub GerarNovoCano()\n        pipeX = 430\n        topPipeHeight = rand.Next(50, 260)\n    End Sub\n\n    Private Sub gameTimer_Tick() Handles gameTimer.Tick\n        ' Fisica do Passaro\n        velocity += gravity\n        birdPosY += CInt(velocity)\n\n        ' Movimento dos Canos\n        pipeX -= pipeSpeed\n        If pipeX < -pipeWidth Then\n            GerarNovoCano()\n            score += 1\n            lblScore.Text = score.ToString()\n        End If\n\n        ' Retangulos para Colisao\n        Dim birdRect As New Rectangle(birdPosX, birdPosY, birdSize, birdSize)\n        Dim topPipeRect As New Rectangle(pipeX, 0, pipeWidth, topPipeHeight)\n        Dim bottomPipeY As Integer = topPipeHeight + pipeGap\n        Dim bottomPipeRect As New Rectangle(pipeX, bottomPipeY, pipeWidth, Me.ClientSize.Height - bottomPipeY)\n\n        ' Condicoes de Fim de Jogo\n        If birdPosY >= Me.ClientSize.Height - birdSize OrElse birdPosY <= 0 OrElse birdRect.IntersectsWith(topPipeRect) OrElse birdRect.IntersectsWith(bottomPipeRect) Then\n            GameOver()\n        End If\n\n        Me.Invalidate()\n    End Sub\n\n    Private Sub GameOver()\n        gameTimer.Stop()\n        isPlaying = False\n        lblInstrucoes.Text = \"GAME OVER! Clique ou Enter para Reiniciar\"\n        lblInstrucoes.Visible = True\n    End Sub\n\n    Protected Overrides Sub OnPaint(e As PaintEventArgs) \n        MyBase.OnPaint(e)\n        Dim g As Graphics = e.Graphics\n\n        ' Desenhar o Passaro\n        g.FillEllipse(Brushes.Gold, birdPosX, birdPosY, birdSize, birdSize)\n        g.FillEllipse(Brushes.Black, birdPosX + 18, birdPosY + 8, 6, 6)\n        g.FillRectangle(Brushes.OrangeRed, birdPosX + 22, birdPosY + 14, 10, 6)\n\n        If isPlaying OrElse score > 0 Then\n            ' Desenhar Canos\n            Dim pipeBrush As Brush = Brushes.ForestGreen\n            g.FillRectangle(pipeBrush, pipeX, 0, pipeWidth, topPipeHeight)\n            Dim bottomPipeY As Integer = topPipeHeight + pipeGap\n            g.FillRectangle(pipeBrush, pipeX, bottomPipeY, pipeWidth, Me.ClientSize.Height - bottomPipeY)\n        End If\n    End Sub\n\nEnd Class","Controls":[{"AssemblyPath":"","IsNonVisual":false,"Items":[],"Name":"lblScore","Properties":[{"Key":"AutoSize","Value":"True"},{"Key":"AutoEllipsis","Value":"False"},{"Key":"BorderStyle","Value":"None"},{"Key":"FlatStyle","Value":"Standard"},{"Key":"ImageIndex","Value":"(nenhum\/a)"},{"Key":"ImageKey","Value":"(nenhum\/a)"},{"Key":"ImageAlign","Value":"MiddleCenter"},{"Key":"LiveSetting","Value":"Off"},{"Key":"TextAlign","Value":"TopLeft"},{"Key":"Text","Value":"0"},{"Key":"UseCompatibleTextRendering","Value":"False"},{"Key":"UseMnemonic","Value":"True"},{"Key":"AccessibleDescription","Value":""},{"Key":"AccessibleName","Value":""},{"Key":"AccessibleRole","Value":"Default"},{"Key":"AllowDrop","Value":"False"},{"Key":"Anchor","Value":"Top, Left"},{"Key":"BackColor","Value":"DeepSkyBlue"},{"Key":"CausesValidation","Value":"True"},{"Key":"Cursor","Value":"Default"},{"Key":"Dock","Value":"None"},{"Key":"Enabled","Value":"True"},{"Key":"Font","Value":"Arial, 20pt, style=Bold"},{"Key":"ForeColor","Value":"White"},{"Key":"Location","Value":"20, 20"},{"Key":"Margin","Value":"3, 0, 3, 0"},{"Key":"MaximumSize","Value":"0, 0"},{"Key":"MinimumSize","Value":"0, 0"},{"Key":"RightToLeft","Value":"No"},{"Key":"Size","Value":"30, 32"},{"Key":"TabIndex","Value":"0"},{"Key":"Tag","Value":""},{"Key":"UseWaitCursor","Value":"False"},{"Key":"Padding","Value":"0, 0, 0, 0"}],"TypeName":"Label"},{"AssemblyPath":"","IsNonVisual":false,"Items":[],"Name":"lblInstrucoes","Properties":[{"Key":"AutoSize","Value":"False"},{"Key":"AutoEllipsis","Value":"False"},{"Key":"BorderStyle","Value":"None"},{"Key":"FlatStyle","Value":"Standard"},{"Key":"ImageIndex","Value":"(nenhum\/a)"},{"Key":"ImageKey","Value":"(nenhum\/a)"},{"Key":"ImageAlign","Value":"MiddleCenter"},{"Key":"LiveSetting","Value":"Off"},{"Key":"TextAlign","Value":"MiddleCenter"},{"Key":"Text","Value":"CLIQUE ou ESPACO para Pular! Pressione ENTER para Iniciar"},{"Key":"UseCompatibleTextRendering","Value":"False"},{"Key":"UseMnemonic","Value":"True"},{"Key":"AccessibleDescription","Value":""},{"Key":"AccessibleName","Value":""},{"Key":"AccessibleRole","Value":"Default"},{"Key":"AllowDrop","Value":"False"},{"Key":"Anchor","Value":"Top, Left"},{"Key":"BackColor","Value":"DeepSkyBlue"},{"Key":"CausesValidation","Value":"True"},{"Key":"Cursor","Value":"Default"},{"Key":"Dock","Value":"None"},{"Key":"Enabled","Value":"True"},{"Key":"Font","Value":"Arial, 13pt, style=Bold"},{"Key":"ForeColor","Value":"Yellow"},{"Key":"Location","Value":"30, 180"},{"Key":"Margin","Value":"3, 0, 3, 0"},{"Key":"MaximumSize","Value":"0, 0"},{"Key":"MinimumSize","Value":"0, 0"},{"Key":"RightToLeft","Value":"No"},{"Key":"Size","Value":"340, 100"},{"Key":"TabIndex","Value":"1"},{"Key":"Tag","Value":""},{"Key":"UseWaitCursor","Value":"False"},{"Key":"Padding","Value":"0, 0, 0, 0"}],"TypeName":"Label"},{"AssemblyPath":"","IsNonVisual":true,"Items":[],"Name":"gameTimer","Properties":[{"Key":"Tag","Value":""},{"Key":"Enabled","Value":"False"},{"Key":"Interval","Value":"20"},{"Key":"__TrayLocation","Value":"20, 20"}],"TypeName":"Timer"}],"IsStartup":true,"Name":"Form1","Properties":[{"Key":"AutoScroll","Value":"False"},{"Key":"AutoSize","Value":"False"},{"Key":"AutoSizeMode","Value":"GrowOnly"},{"Key":"AutoValidate","Value":"EnablePreventFocusChange"},{"Key":"BackColor","Value":"DeepSkyBlue"},{"Key":"FormBorderStyle","Value":"FixedSingle"},{"Key":"ControlBox","Value":"True"},{"Key":"HelpButton","Value":"False"},{"Key":"IsMdiContainer","Value":"False"},{"Key":"KeyPreview","Value":"True"},{"Key":"Location","Value":"0, 0"},{"Key":"MaximumSize","Value":"0, 0"},{"Key":"MinimumSize","Value":"0, 0"},{"Key":"MaximizeBox","Value":"False"},{"Key":"MinimizeBox","Value":"True"},{"Key":"Opacity","Value":"100%"},{"Key":"RightToLeftLayout","Value":"False"},{"Key":"ShowInTaskbar","Value":"True"},{"Key":"ShowIcon","Value":"True"},{"Key":"Size","Value":"416, 539"},{"Key":"SizeGripStyle","Value":"Auto"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"Text","Value":"Flappy Bird - Windows Forms"},{"Key":"TopMost","Value":"False"},{"Key":"TransparencyKey","Value":""},{"Key":"WindowState","Value":"Normal"},{"Key":"AutoScrollMargin","Value":"0, 0"},{"Key":"AutoScrollMinSize","Value":"0, 0"},{"Key":"AccessibleDescription","Value":""},{"Key":"AccessibleName","Value":""},{"Key":"AccessibleRole","Value":"Default"},{"Key":"AllowDrop","Value":"False"},{"Key":"Anchor","Value":"Top, Left"},{"Key":"BackgroundImageLayout","Value":"Tile"},{"Key":"CausesValidation","Value":"True"},{"Key":"Cursor","Value":"Default"},{"Key":"Dock","Value":"None"},{"Key":"Enabled","Value":"True"},{"Key":"Font","Value":"Microsoft Sans Serif, 8.25pt"},{"Key":"ForeColor","Value":"ControlText"},{"Key":"RightToLeft","Value":"No"},{"Key":"Tag","Value":""},{"Key":"UseWaitCursor","Value":"False"},{"Key":"Padding","Value":"0, 0, 0, 0"},{"Key":"ImeMode","Value":"NoControl"}]}],"Name":"FlappyBird","Version":"1.0.4"}