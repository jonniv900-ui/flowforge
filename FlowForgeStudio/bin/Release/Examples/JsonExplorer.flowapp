      ],
      "Code": "Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Sub ParseButton_Click() Handles ParseButton.Click\n        JsonTreeViewer1.JsonText = SyntaxCodeEditor1.Text\n        If JsonTreeViewer1.IsValid Then\n            StatusLabel.Text = \"JSON válido\"\n        Else\n            StatusLabel.Text = \"Erro: \" & JsonTreeViewer1.LastError\n        End If\n    End Sub\n\n    Private Sub InvalidButton_Click() Handles InvalidButton.Click\n        SyntaxCodeEditor1.Text = \"{\"\"nome\"\": \"\"FlowForge\"\", \"\"valor\"\": }\"\n        JsonTreeViewer1.JsonText = SyntaxCodeEditor1.Text\n    End Sub\n\n    Private Sub JsonTreeViewer1_JsonParsed() Handles JsonTreeViewer1.JsonParsed\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"JSON analisado com sucesso.\"\n    End Sub\n\n    Private Sub JsonTreeViewer1_JsonError() Handles JsonTreeViewer1.JsonError\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"Erro de JSON: \" & JsonTreeViewer1.LastError\n    End Sub\nEnd Class\n"
    }
