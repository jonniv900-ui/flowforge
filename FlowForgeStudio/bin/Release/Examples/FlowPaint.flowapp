      "Code": "Imports System\r\nImports System.Drawing\r\nImports System.Drawing.Drawing2D\r\nImports System.Drawing.Printing\r\nImports System.Collections.Generic\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private desenho As Bitmap\r\n    Private inicio As Point\r\n    Private ultimo As Point\r\n    Private desenhando As Boolean\r\n    Private ferramenta As String = \"Lapis\"\r\n    Private corAtual As Color = Color.Black\r\n    Private ReadOnly desfazer As New Stack(Of Bitmap)()\r\n    Private ReadOnly refazer As New Stack(Of Bitmap)()\r\n    Private arquivoAtual As String = \"\"\r\n\r\n    Private Sub Form1_Load() Handles MyBase.Load\r\n        PrepararTela()\r\n        AplicarIcones()\r\n        AtualizarEstado(\"Pronto\")\r\n    End Sub\r\n\r\n    Private Function CriarIcone(simbolo As String, fundo As Color) As Bitmap\r\n        Dim imagem As New Bitmap(24, 24)\r\n        Using g As Graphics = Graphics.FromImage(imagem)\r\n            g.SmoothingMode = SmoothingMode.AntiAlias : g.Clear(Color.Transparent)\r\n            Using b As New SolidBrush(fundo) : g.FillEllipse(b, 1, 1, 22, 22) : End Using\r\n            Using f As New Font(\"Segoe UI Symbol\", 11, FontStyle.Bold), b As New SolidBrush(Color.White)\r\n                Dim formato As New StringFormat With {.Alignment = StringAlignment.Center, .LineAlignment = StringAlignment.Center}\r\n                g.DrawString(simbolo, f, b, New RectangleF(0, 0, 24, 24), formato)\r\n            End Using\r\n        End Using\r\n        Return imagem\r\n    End Function\r\n\r\n    Private Sub AplicarIcones()\r\n        Dim botoes As ToolStripButton() = {BtnNovo, BtnAbrir, BtnSalvar, BtnDesfazer, BtnRefazer, BtnLapis, BtnPincel, BtnBorracha, BtnLinha, BtnRetangulo, BtnElipse, BtnPreencher, BtnContaGotas, BtnTexto}\r\n        Dim simbolos As String() = {\"N\", \"↗\", \"S\", \"↶\", \"↷\", \"✎\", \"●\", \"E\", \"╱\", \"□\", \"○\", \"▣\", \"◉\", \"T\"}\r\n        Dim cores As Color() = {Color.Teal, Color.SteelBlue, Color.SeaGreen, Color.DimGray, Color.DimGray, Color.RoyalBlue, Color.MediumPurple, Color.IndianRed, Color.SlateGray, Color.DarkOrange, Color.DarkCyan, Color.Goldenrod, Color.MediumVioletRed, Color.DarkSlateBlue}\r\n        For i As Integer = 0 To botoes.Length - 1\r\n            botoes(i).Image = CriarIcone(simbolos(i), cores(i)) : botoes(i).DisplayStyle = ToolStripItemDisplayStyle.Image\r\n        Next\r\n    End Sub\r\n\r\n    Private Sub PrepararTela()\r\n        If desenho Is Nothing Then\r\n            desenho = New Bitmap(Math.Max(1, PictureBoxCanvas.ClientSize.Width), Math.Max(1, PictureBoxCanvas.ClientSize.Height))\r\n            Using g As Graphics = Graphics.FromImage(desenho)\r\n                g.Clear(Color.White)\r\n            End Using\r\n        End If\r\n        PictureBoxCanvas.Image = desenho\r\n        ColorComboBox1.SelectedColor = corAtual\r\n        NumericUpDown1.Minimum = 1\r\n        NumericUpDown1.Maximum = 80\r\n        NumericUpDown1.Value = 4\r\n    End Sub\r\n\r\n    Private Sub SelecionarFerramenta(nome As String)\r\n        ferramenta = nome\r\n        ToolStripStatusLabelFerramenta.Text = \"Ferramenta: \" & nome\r\n    End Sub\r\n\r\n    Private Sub BtnLapis_Click() Handles BtnLapis.Click\r\n        SelecionarFerramenta(\"Lapis\")\r\n    End Sub\r\n    Private Sub BtnPincel_Click() Handles BtnPincel.Click\r\n        SelecionarFerramenta(\"Pincel\")\r\n    End Sub\r\n    Private Sub BtnBorracha_Click() Handles BtnBorracha.Click\r\n        SelecionarFerramenta(\"Borracha\")\r\n    End Sub\r\n    Private Sub BtnLinha_Click() Handles BtnLinha.Click\r\n        SelecionarFerramenta(\"Linha\")\r\n    End Sub\r\n    Private Sub BtnRetangulo_Click() Handles BtnRetangulo.Click\r\n        SelecionarFerramenta(\"Retangulo\")\r\n    End Sub\r\n    Private Sub BtnElipse_Click() Handles BtnElipse.Click\r\n        SelecionarFerramenta(\"Elipse\")\r\n    End Sub\r\n    Private Sub BtnPreencher_Click() Handles BtnPreencher.Click\r\n        SelecionarFerramenta(\"Preencher\")\r\n    End Sub\r\n    Private Sub BtnContaGotas_Click() Handles BtnContaGotas.Click\r\n        SelecionarFerramenta(\"Conta-gotas\")\r\n    End Sub\r\n    Private Sub BtnTexto_Click() Handles BtnTexto.Click\r\n        SelecionarFerramenta(\"Texto\")\r\n    End Sub\r\n\r\n    Private Sub ColorComboBox1_SelectedColorChanged() Handles ColorComboBox1.SelectedColorChanged\r\n        If Not ColorComboBox1.SelectedColor.IsEmpty Then corAtual = ColorComboBox1.SelectedColor\r\n    End Sub\r\n\r\n    Private Sub PictureBoxCanvas_MouseDown(sender As Object, e As MouseEventArgs) Handles PictureBoxCanvas.MouseDown\r\n        If e.Button <> MouseButtons.Left Then Return\r\n        inicio = e.Location : ultimo = e.Location\r\n        If ferramenta = \"Conta-gotas\" Then\r\n            If Dentro(e.Location) Then corAtual = desenho.GetPixel(e.X, e.Y) : ColorComboBox1.SelectedColor = corAtual\r\n            Return\r\n        End If\r\n        SalvarHistorico()\r\n        If ferramenta = \"Preencher\" Then\r\n            PreencherArea(e.Location, corAtual) : PictureBoxCanvas.Invalidate() : Return\r\n        End If\r\n        If ferramenta = \"Texto\" Then\r\n            Dim texto As String = Microsoft.VisualBasic.Interaction.InputBox(\"Digite o texto:\", \"Inserir texto\", \"Texto\")\r\n            If texto <> \"\" Then\r\n                Using g As Graphics = Graphics.FromImage(desenho), fonte As New Font(\"Segoe UI\", CSng(Math.Max(8, NumericUpDown1.Value * 3)))\r\n                    g.DrawString(texto, fonte, New SolidBrush(corAtual), e.Location)\r\n                End Using\r\n                PictureBoxCanvas.Invalidate()\r\n            End If\r\n            Return\r\n        End If\r\n        desenhando = True\r\n    End Sub\r\n\r\n    Private Sub PictureBoxCanvas_MouseMove(sender As Object, e As MouseEventArgs) Handles PictureBoxCanvas.MouseMove\r\n        ToolStripStatusLabelPosicao.Text = \"X: \" & e.X & \"  Y: \" & e.Y\r\n        If Not desenhando Then Return\r\n        If ferramenta = \"Lapis\" OrElse ferramenta = \"Pincel\" OrElse ferramenta = \"Borracha\" Then\r\n            Dim largura As Single = CSng(NumericUpDown1.Value)\r\n            If ferramenta = \"Lapis\" Then largura = 1\r\n            Dim tinta As Color = If(ferramenta = \"Borracha\", Color.White, corAtual)\r\n            Using g As Graphics = Graphics.FromImage(desenho), p As New Pen(tinta, largura)\r\n                g.SmoothingMode = SmoothingMode.AntiAlias : p.StartCap = LineCap.Round : p.EndCap = LineCap.Round\r\n                g.DrawLine(p, ultimo, e.Location)\r\n            End Using\r\n            ultimo = e.Location : PictureBoxCanvas.Invalidate()\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub PictureBoxCanvas_MouseUp(sender As Object, e As MouseEventArgs) Handles PictureBoxCanvas.MouseUp\r\n        If Not desenhando Then Return\r\n        desenhando = False\r\n        Dim r As Rectangle = RetanguloNormalizado(inicio, e.Location)\r\n        Using g As Graphics = Graphics.FromImage(desenho), p As New Pen(corAtual, CSng(NumericUpDown1.Value))\r\n            g.SmoothingMode = SmoothingMode.AntiAlias\r\n            Select Case ferramenta\r\n                Case \"Linha\" : g.DrawLine(p, inicio, e.Location)\r\n                Case \"Retangulo\" : If r.Width > 0 AndAlso r.Height > 0 Then g.DrawRectangle(p, r)\r\n                Case \"Elipse\" : If r.Width > 0 AndAlso r.Height > 0 Then g.DrawEllipse(p, r)\r\n            End Select\r\n        End Using\r\n        PictureBoxCanvas.Invalidate()\r\n    End Sub\r\n\r\n    Private Function RetanguloNormalizado(a As Point, b As Point) As Rectangle\r\n        Return Rectangle.FromLTRB(Math.Min(a.X, b.X), Math.Min(a.Y, b.Y), Math.Max(a.X, b.X), Math.Max(a.Y, b.Y))\r\n    End Function\r\n\r\n    Private Function Dentro(p As Point) As Boolean\r\n        Return p.X >= 0 AndAlso p.Y >= 0 AndAlso p.X < desenho.Width AndAlso p.Y < desenho.Height\r\n    End Function\r\n\r\n    Private Sub PreencherArea(p As Point, novaCor As Color)\r\n        If Not Dentro(p) Then Return\r\n        Dim antiga As Color = desenho.GetPixel(p.X, p.Y)\r\n        If antiga.ToArgb() = novaCor.ToArgb() Then Return\r\n        Dim fila As New System.Collections.Generic.Queue(Of Point)() : fila.Enqueue(p)\r\n        While fila.Count > 0\r\n            Dim atual = fila.Dequeue()\r\n            If Not Dentro(atual) OrElse desenho.GetPixel(atual.X, atual.Y).ToArgb() <> antiga.ToArgb() Then Continue While\r\n            desenho.SetPixel(atual.X, atual.Y, novaCor)\r\n            fila.Enqueue(New Point(atual.X + 1, atual.Y)) : fila.Enqueue(New Point(atual.X - 1, atual.Y))\r\n            fila.Enqueue(New Point(atual.X, atual.Y + 1)) : fila.Enqueue(New Point(atual.X, atual.Y - 1))\r\n        End While\r\n    End Sub\r\n\r\n    Private Sub SalvarHistorico()\r\n        desfazer.Push(DirectCast(desenho.Clone(), Bitmap))\r\n        While desfazer.Count > 20\r\n            Dim itens = desfazer.ToArray() : desfazer.Clear()\r\n            For i As Integer = Math.Min(19, itens.Length - 1) To 0 Step -1 : desfazer.Push(itens(i)) : Next\r\n        End While\r\n        refazer.Clear()\r\n    End Sub\r\n\r\n    Private Sub Desfazer_Click() Handles MenuDesfazer.Click, BtnDesfazer.Click\r\n        If desfazer.Count = 0 Then Return\r\n        refazer.Push(DirectCast(desenho.Clone(), Bitmap)) : desenho.Dispose() : desenho = desfazer.Pop()\r\n        PictureBoxCanvas.Image = desenho : PictureBoxCanvas.Invalidate()\r\n    End Sub\r\n\r\n    Private Sub Refazer_Click() Handles MenuRefazer.Click, BtnRefazer.Click\r\n        If refazer.Count = 0 Then Return\r\n        desfazer.Push(DirectCast(desenho.Clone(), Bitmap)) : desenho.Dispose() : desenho = refazer.Pop()\r\n        PictureBoxCanvas.Image = desenho : PictureBoxCanvas.Invalidate()\r\n    End Sub\r\n\r\n    Private Sub Novo_Click() Handles MenuNovo.Click, BtnNovo.Click\r\n        SalvarHistorico()\r\n        Using g As Graphics = Graphics.FromImage(desenho) : g.Clear(Color.White) : End Using\r\n        arquivoAtual = \"\" : PictureBoxCanvas.Invalidate() : AtualizarEstado(\"Nova imagem\")\r\n    End Sub\r\n\r\n    Private Sub Abrir_Click() Handles MenuAbrir.Click, BtnAbrir.Click\r\n        Using d As New OpenFileDialog With {.Filter = \"Imagens|*.png;*.jpg;*.jpeg;*.bmp;*.gif|Todos os arquivos|*.*\"}\r\n            If d.ShowDialog() <> DialogResult.OK Then Return\r\n            Using original As Image = Image.FromFile(d.FileName)\r\n                SalvarHistorico() : desenho.Dispose() : desenho = New Bitmap(PictureBoxCanvas.Width, PictureBoxCanvas.Height)\r\n                Using g As Graphics = Graphics.FromImage(desenho) : g.Clear(Color.White) : g.DrawImage(original, 0, 0, original.Width, original.Height) : End Using\r\n            End Using\r\n            arquivoAtual = d.FileName : PictureBoxCanvas.Image = desenho : PictureBoxCanvas.Invalidate() : AtualizarEstado(\"Aberto: \" & IO.Path.GetFileName(d.FileName))\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub Salvar_Click() Handles MenuSalvar.Click, BtnSalvar.Click\r\n        If arquivoAtual = \"\" Then SalvarComo_Click() Else desenho.Save(arquivoAtual, Imaging.ImageFormat.Png) : AtualizarEstado(\"Imagem salva\")\r\n    End Sub\r\n\r\n    Private Sub SalvarComo_Click() Handles MenuSalvarComo.Click\r\n        Using d As New SaveFileDialog With {.Filter = \"PNG|*.png|JPEG|*.jpg|Bitmap|*.bmp\", .DefaultExt = \"png\"}\r\n            If d.ShowDialog() <> DialogResult.OK Then Return\r\n            arquivoAtual = d.FileName\r\n            Dim ext = IO.Path.GetExtension(arquivoAtual).ToLowerInvariant()\r\n            Dim formato = If(ext = \".jpg\" OrElse ext = \".jpeg\", System.Drawing.Imaging.ImageFormat.Jpeg, If(ext = \".bmp\", System.Drawing.Imaging.ImageFormat.Bmp, System.Drawing.Imaging.ImageFormat.Png))\r\n            desenho.Save(arquivoAtual, formato) : AtualizarEstado(\"Salvo: \" & IO.Path.GetFileName(arquivoAtual))\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub Copiar_Click() Handles MenuCopiar.Click\r\n        Clipboard.SetImage(desenho)\r\n    End Sub\r\n\r\n    Private Sub Colar_Click() Handles MenuColar.Click\r\n        If Not Clipboard.ContainsImage() Then Return\r\n        SalvarHistorico()\r\n        Using g As Graphics = Graphics.FromImage(desenho) : g.DrawImage(Clipboard.GetImage(), 0, 0) : End Using\r\n        PictureBoxCanvas.Invalidate()\r\n    End Sub\r\n\r\n    Private Sub Limpar_Click() Handles MenuLimpar.Click\r\n        Novo_Click()\r\n    End Sub\r\n\r\n    Private Sub Imprimir_Click() Handles MenuImprimir.Click\r\n        Using documento As New PrintDocument()\r\n            AddHandler documento.PrintPage, Sub(s, ev) ev.Graphics.DrawImage(desenho, ev.MarginBounds)\r\n            Using dialogo As New PrintDialog With {.Document = documento}\r\n                If dialogo.ShowDialog() = DialogResult.OK Then documento.Print()\r\n            End Using\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub Sair_Click() Handles MenuSair.Click\r\n        Close()\r\n    End Sub\r\n\r\n    Private Sub Sobre_Click() Handles MenuSobre.Click\r\n        MessageBox.Show(\"FlowPaint\" & Environment.NewLine & \"Clone de Paint criado no FlowForge.\", \"Sobre\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n    End Sub\r\n\r\n    Private Sub AtualizarEstado(mensagem As String)\r\n        ToolStripStatusLabelEstado.Text = mensagem\r\n    End Sub\r\nEnd Class"
    }
  ],
  "ApplicationIcon": "",
  "AssemblyTitle": "FlowPaint",
  "AssemblyDescription": "Editor de imagens criado no FlowForge",
  "AssemblyCompany": "Wtec",
  "AssemblyProduct": "FlowPaint",
  "AssemblyCopyright": "Copyright © 2026",
  "AssemblyTrademark": "FlowForge",
  "AssemblyVersion": "1.1.0.0",
  "FileVersion": "1.1.0.0"
}