      ],
      "Code": "Imports System\r\nImports System.Globalization\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private acumulador As Double\r\n    Private operacaoPendente As String = \"\"\r\n    Private novaEntrada As Boolean = True\r\n    Private memoria As Double\r\n    Private memoriaAtiva As Boolean\r\n\r\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\r\n        cmbAngulo.Items.AddRange(New Object() {\"Graus\", \"Radianos\"})\r\n        cmbAngulo.SelectedIndex = 0\r\n        txtDisplay.Text = \"0\"\r\n    End Sub\r\n\r\n    Private Sub Numero_Click(sender As Object, e As System.EventArgs) Handles btn0.Click, btn00.Click, btn1.Click, btn2.Click, btn3.Click, btn4.Click, btn5.Click, btn6.Click, btn7.Click, btn8.Click, btn9.Click\r\n        Dim botao As Button = DirectCast(sender, Button)\r\n        If novaEntrada OrElse txtDisplay.Text = \"Erro\" Then\r\n            txtDisplay.Text = botao.Text\r\n            novaEntrada = False\r\n        ElseIf txtDisplay.Text = \"0\" Then\r\n            txtDisplay.Text = botao.Text\r\n        ElseIf txtDisplay.Text.Length < 22 Then\r\n            txtDisplay.AppendText(botao.Text)\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub btnDecimal_Click(sender As Object, e As System.EventArgs) Handles btnDecimal.Click\r\n        Dim separador As String = CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator\r\n        If novaEntrada OrElse txtDisplay.Text = \"Erro\" Then\r\n            txtDisplay.Text = \"0\" & separador\r\n            novaEntrada = False\r\n        ElseIf Not txtDisplay.Text.Contains(separador) Then\r\n            txtDisplay.AppendText(separador)\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub Operacao_Click(sender As Object, e As System.EventArgs) Handles btnPlus.Click, btnMinus.Click, btnMultiply.Click, btnDivide.Click, btnPower.Click, btnMod.Click\r\n        Dim botao As Button = DirectCast(sender, Button)\r\n        Dim simbolo As String = NormalizarOperacao(botao.Text)\r\n        Try\r\n            Dim valorAtual As Double = LerDisplay()\r\n            If operacaoPendente <> \"\" AndAlso Not novaEntrada Then\r\n                acumulador = Calcular(acumulador, valorAtual, operacaoPendente)\r\n                MostrarResultado(acumulador)\r\n            Else\r\n                acumulador = valorAtual\r\n            End If\r\n            operacaoPendente = simbolo\r\n            lblExpressao.Text = Formatar(acumulador) & \" \" & botao.Text\r\n            novaEntrada = True\r\n        Catch ex As Exception\r\n            MostrarErro(ex.Message)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub Igual_Click(sender As Object, e As System.EventArgs) Handles btnEquals.Click, btnEquals2.Click\r\n        If operacaoPendente = \"\" Then Return\r\n        Try\r\n            Dim segundoValor As Double = LerDisplay()\r\n            Dim primeiroValor As Double = acumulador\r\n            Dim resultado As Double = Calcular(primeiroValor, segundoValor, operacaoPendente)\r\n            Dim linha As String = Formatar(primeiroValor) & \" \" & ExibirOperacao(operacaoPendente) & \" \" & Formatar(segundoValor) & \" = \" & Formatar(resultado)\r\n            lstHistorico.Items.Insert(0, linha)\r\n            MostrarResultado(resultado)\r\n            lblExpressao.Text = linha\r\n            acumulador = resultado\r\n            operacaoPendente = \"\"\r\n            novaEntrada = True\r\n        Catch ex As Exception\r\n            MostrarErro(ex.Message)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Function Calcular(a As Double, b As Double, operacao As String) As Double\r\n        Select Case operacao\r\n            Case \"+\"\r\n                Return a + b\r\n            Case \"-\"\r\n                Return a - b\r\n            Case \"*\"\r\n                Return a * b\r\n            Case \"/\"\r\n                If b = 0 Then Throw New DivideByZeroException(\"Divisão por zero.\")\r\n                Return a / b\r\n            Case \"pow\"\r\n                Return Math.Pow(a, b)\r\n            Case \"mod\"\r\n                If b = 0 Then Throw New DivideByZeroException(\"Divisão por zero.\")\r\n                Return a Mod b\r\n            Case Else\r\n                Return b\r\n        End Select\r\n    End Function\r\n\r\n    Private Sub Funcao_Click(sender As Object, e As System.EventArgs) Handles btnSin.Click, btnCos.Click, btnTan.Click, btnAsin.Click, btnAcos.Click, btnAtan.Click, btnLog.Click, btnLn.Click, btnSqrt.Click, btnSquare.Click, btnInverse.Click, btnReciprocal.Click, btnAbs.Click, btnFactorial.Click, btnTenPower.Click, btnExp.Click, btnPercent.Click\r\n        Dim botao As Button = DirectCast(sender, Button)\r\n        Try\r\n            Dim entrada As Double = LerDisplay()\r\n            Dim resultado As Double\r\n            Select Case botao.Name\r\n                Case \"btnSin\"\r\n                    resultado = Math.Sin(ParaRadianos(entrada))\r\n                Case \"btnCos\"\r\n                    resultado = Math.Cos(ParaRadianos(entrada))\r\n                Case \"btnTan\"\r\n                    resultado = Math.Tan(ParaRadianos(entrada))\r\n                Case \"btnAsin\"\r\n                    If entrada < -1 OrElse entrada > 1 Then Throw New ArithmeticException(\"asin exige valor entre -1 e 1.\")\r\n                    resultado = DeRadianos(Math.Asin(entrada))\r\n                Case \"btnAcos\"\r\n                    If entrada < -1 OrElse entrada > 1 Then Throw New ArithmeticException(\"acos exige valor entre -1 e 1.\")\r\n                    resultado = DeRadianos(Math.Acos(entrada))\r\n                Case \"btnAtan\"\r\n                    resultado = DeRadianos(Math.Atan(entrada))\r\n                Case \"btnLog\"\r\n                    If entrada <= 0 Then Throw New ArithmeticException(\"log exige valor positivo.\")\r\n                    resultado = Math.Log10(entrada)\r\n                Case \"btnLn\"\r\n                    If entrada <= 0 Then Throw New ArithmeticException(\"ln exige valor positivo.\")\r\n                    resultado = Math.Log(entrada)\r\n                Case \"btnSqrt\"\r\n                    If entrada < 0 Then Throw New ArithmeticException(\"Raiz exige valor não negativo.\")\r\n                    resultado = Math.Sqrt(entrada)\r\n                Case \"btnSquare\"\r\n                    resultado = entrada * entrada\r\n                Case \"btnInverse\", \"btnReciprocal\"\r\n                    If entrada = 0 Then Throw New DivideByZeroException(\"Divisão por zero.\")\r\n                    resultado = 1.0 / entrada\r\n                Case \"btnAbs\"\r\n                    resultado = Math.Abs(entrada)\r\n                Case \"btnFactorial\"\r\n                    resultado = Fatorial(entrada)\r\n                Case \"btnTenPower\"\r\n                    resultado = Math.Pow(10.0, entrada)\r\n                Case \"btnExp\"\r\n                    resultado = Math.Exp(entrada)\r\n                Case \"btnPercent\"\r\n                    resultado = entrada / 100.0\r\n                Case Else\r\n                    resultado = entrada\r\n            End Select\r\n            Dim linha As String = botao.Text & \"(\" & Formatar(entrada) & \") = \" & Formatar(resultado)\r\n            lstHistorico.Items.Insert(0, linha)\r\n            lblExpressao.Text = linha\r\n            MostrarResultado(resultado)\r\n            novaEntrada = True\r\n        Catch ex As Exception\r\n            MostrarErro(ex.Message)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Function Fatorial(valor As Double) As Double\r\n        If valor < 0 OrElse valor > 170 OrElse Math.Truncate(valor) <> valor Then Throw New ArithmeticException(\"Fatorial exige inteiro entre 0 e 170.\")\r\n        Dim resultado As Double = 1\r\n        For numero As Integer = 2 To CInt(valor)\r\n            resultado *= numero\r\n        Next\r\n        Return resultado\r\n    End Function\r\n\r\n    Private Sub Constante_Click(sender As Object, e As System.EventArgs) Handles btnPi.Click, btnE.Click\r\n        Dim botao As Button = DirectCast(sender, Button)\r\n        If botao.Name = \"btnPi\" Then MostrarResultado(Math.PI) Else MostrarResultado(Math.E)\r\n        novaEntrada = True\r\n    End Sub\r\n\r\n    Private Sub btnSign_Click(sender As Object, e As System.EventArgs) Handles btnSign.Click\r\n        Try\r\n            MostrarResultado(-LerDisplay())\r\n        Catch ex As Exception\r\n            MostrarErro(ex.Message)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub Limpar_Click(sender As Object, e As System.EventArgs) Handles btnC.Click, btnClear2.Click\r\n        acumulador = 0\r\n        operacaoPendente = \"\"\r\n        lblExpressao.Text = \"\"\r\n        txtDisplay.Text = \"0\"\r\n        novaEntrada = True\r\n    End Sub\r\n\r\n    Private Sub LimparEntrada_Click(sender As Object, e As System.EventArgs) Handles btnCE.Click, btnClearEntry2.Click\r\n        txtDisplay.Text = \"0\"\r\n        novaEntrada = True\r\n    End Sub\r\n\r\n    Private Sub btnBack_Click(sender As Object, e As System.EventArgs) Handles btnBack.Click\r\n        If novaEntrada OrElse txtDisplay.Text = \"Erro\" Then Return\r\n        If txtDisplay.Text.Length > 1 Then txtDisplay.Text = txtDisplay.Text.Substring(0, txtDisplay.Text.Length - 1) Else txtDisplay.Text = \"0\"\r\n    End Sub\r\n\r\n    Private Sub Memoria_Click(sender As Object, e As System.EventArgs) Handles btnMC.Click, btnMR.Click, btnMPlus.Click, btnMMinus.Click\r\n        Dim botao As Button = DirectCast(sender, Button)\r\n        Try\r\n            Select Case botao.Name\r\n                Case \"btnMC\"\r\n                    memoria = 0\r\n                    memoriaAtiva = False\r\n                Case \"btnMR\"\r\n                    MostrarResultado(memoria)\r\n                    novaEntrada = True\r\n                Case \"btnMPlus\"\r\n                    memoria += LerDisplay()\r\n                    memoriaAtiva = True\r\n                Case \"btnMMinus\"\r\n                    memoria -= LerDisplay()\r\n                    memoriaAtiva = True\r\n            End Select\r\n            lblMemoria.Text = If(memoriaAtiva, \"Memória: \" & Formatar(memoria), \"Memória: vazia\")\r\n        Catch ex As Exception\r\n            MostrarErro(ex.Message)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub btnLimparHistorico_Click(sender As Object, e As System.EventArgs) Handles btnLimparHistorico.Click\r\n        lstHistorico.Items.Clear()\r\n    End Sub\r\n\r\n    Private Function LerDisplay() As Double\r\n        Dim valor As Double\r\n        If Not Double.TryParse(txtDisplay.Text, NumberStyles.Float, CultureInfo.CurrentCulture, valor) Then Throw New FormatException(\"Número inválido.\")\r\n        Return valor\r\n    End Function\r\n\r\n    Private Sub MostrarResultado(valor As Double)\r\n        If Double.IsNaN(valor) OrElse Double.IsInfinity(valor) Then Throw New ArithmeticException(\"Resultado fora do domínio.\")\r\n        txtDisplay.Text = Formatar(valor)\r\n    End Sub\r\n\r\n    Private Function Formatar(valor As Double) As String\r\n        Return valor.ToString(\"G15\", CultureInfo.CurrentCulture)\r\n    End Function\r\n\r\n    Private Function ParaRadianos(valor As Double) As Double\r\n        If cmbAngulo.SelectedIndex = 0 Then Return valor * Math.PI / 180.0\r\n        Return valor\r\n    End Function\r\n\r\n    Private Function DeRadianos(valor As Double) As Double\r\n        If cmbAngulo.SelectedIndex = 0 Then Return valor * 180.0 / Math.PI\r\n        Return valor\r\n    End Function\r\n\r\n    Private Function NormalizarOperacao(texto As String) As String\r\n        If texto = \"×\" Then Return \"*\"\r\n        If texto = \"÷\" Then Return \"/\"\r\n        If texto = \"−\" Then Return \"-\"\r\n        If texto = \"xʸ\" Then Return \"pow\"\r\n        Return texto\r\n    End Function\r\n\r\n    Private Function ExibirOperacao(operacao As String) As String\r\n        If operacao = \"*\" Then Return \"×\"\r\n        If operacao = \"/\" Then Return \"÷\"\r\n        If operacao = \"-\" Then Return \"−\"\r\n        If operacao = \"pow\" Then Return \"xʸ\"\r\n        Return operacao\r\n    End Function\r\n\r\n    Private Sub MostrarErro(mensagem As String)\r\n        txtDisplay.Text = \"Erro\"\r\n        lblExpressao.Text = mensagem\r\n        operacaoPendente = \"\"\r\n        novaEntrada = True\r\n    End Sub\r\n\r\n    Private Sub Form1_KeyDown(sender As Object, e As KeyEventArgs) Handles MyBase.KeyDown\r\n        If e.KeyCode >= Keys.D0 AndAlso e.KeyCode <= Keys.D9 Then\r\n            InserirDigito((CInt(e.KeyCode) - CInt(Keys.D0)).ToString())\r\n            e.SuppressKeyPress = True\r\n        ElseIf e.KeyCode >= Keys.NumPad0 AndAlso e.KeyCode <= Keys.NumPad9 Then\r\n            InserirDigito((CInt(e.KeyCode) - CInt(Keys.NumPad0)).ToString())\r\n            e.SuppressKeyPress = True\r\n        ElseIf e.KeyCode = Keys.Enter Then\r\n            Igual_Click(btnEquals, System.EventArgs.Empty)\r\n            e.SuppressKeyPress = True\r\n        ElseIf e.KeyCode = Keys.Escape Then\r\n            Limpar_Click(btnC, System.EventArgs.Empty)\r\n            e.SuppressKeyPress = True\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub InserirDigito(digito As String)\r\n        If novaEntrada OrElse txtDisplay.Text = \"Erro\" Then\r\n            txtDisplay.Text = digito\r\n            novaEntrada = False\r\n        ElseIf txtDisplay.Text = \"0\" Then\r\n            txtDisplay.Text = digito\r\n        ElseIf txtDisplay.Text.Length < 22 Then\r\n            txtDisplay.AppendText(digito)\r\n        End If\r\n    End Sub\r\nEnd Class"
    }
  ],
  "ApplicationIcon": "",
  "AssemblyTitle": "Calculadora Científica",
  "AssemblyDescription": "Calculadora científica completa criada no FlowForge",
