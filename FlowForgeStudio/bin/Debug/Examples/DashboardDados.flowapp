      ],
      "Code": "Imports System\nImports System.Collections.Generic\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private ReadOnly rng As New Random()\n\n    Private Sub RandomButton_Click() Handles RandomButton.Click\n        Dim values As New List(Of String)()\n        For i As Integer = 1 To 10\n            values.Add(rng.Next(10, 90).ToString())\n        Next\n        Sparkline1.DataPoints = String.Join(\",\", values)\n        SimpleChart1.DataPoints = Sparkline1.DataPoints\n        Dim lastValue As Integer = Integer.Parse(values(values.Count - 1))\n        LcdDisplay1.Value = lastValue.ToString()\n        SevenSegmentDigit1.Value = lastValue Mod 10\n        InfoLabel.Text = \"Último valor gerado: \" & lastValue.ToString()\n    End Sub\n\n    Private Sub StyleButton_Click() Handles StyleButton.Click\n        If SimpleChart1.ChartStyle = FlowForgeStudio.SimpleChartStyle.Line Then\n            SimpleChart1.ChartStyle = FlowForgeStudio.SimpleChartStyle.Bars\n            Sparkline1.ChartStyle = FlowForgeStudio.SparklineStyle.Bars\n        Else\n            SimpleChart1.ChartStyle = FlowForgeStudio.SimpleChartStyle.Line\n            Sparkline1.ChartStyle = FlowForgeStudio.SparklineStyle.Line\n        End If\n    End Sub\nEnd Class\n"
    }
