{"Name":"Cronometro","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Cronômetro"},{"Key":"ClientSize","Value":"800, 520"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"MinimumSize","Value":"640, 420"}],"Controls":[{"TypeName":"Label","Name":"lblTempo","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblTempo"},{"Key":"Location","Value":"145, 75"},{"Key":"Size","Value":"500, 100"},{"Key":"Text","Value":"00:00:00.000"},{"Key":"Font","Value":"Segoe UI, 42pt"},{"Key":"TextAlign","Value":"MiddleCenter"},{"Key":"Anchor","Value":"Top, Left, Right"}]},{"TypeName":"Button","Name":"btnIniciar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnIniciar"},{"Key":"Location","Value":"205, 210"},{"Key":"Size","Value":"115, 42"},{"Key":"Text","Value":"Iniciar"}]},{"TypeName":"Button","Name":"btnPausar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnPausar"},{"Key":"Location","Value":"337, 210"},{"Key":"Size","Value":"115, 42"},{"Key":"Text","Value":"Pausar"}]},{"TypeName":"Button","Name":"btnZerar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnZerar"},{"Key":"Location","Value":"469, 210"},{"Key":"Size","Value":"115, 42"},{"Key":"Text","Value":"Zerar"}]},{"TypeName":"ListBox","Name":"lstVoltas","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lstVoltas"},{"Key":"Location","Value":"205, 275"},{"Key":"Size","Value":"379, 190"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"}]},{"TypeName":"Button","Name":"btnVolta","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnVolta"},{"Key":"Location","Value":"337, 475"},{"Key":"Size","Value":"115, 32"},{"Key":"Text","Value":"Marcar volta"},{"Key":"Anchor","Value":"Bottom"}]}],"Code":"Imports System\r\nImports System.Diagnostics\r\nImports System.Windows.Forms\r\nPartial Public Class Form1\r\n Private ReadOnly relogio As New Stopwatch()\r\n Private WithEvents atualizador As New Timer() With {.Interval=31}\r\n Private Sub Form1_Load() Handles MyBase.Load\r\n  atualizador.Start()\r\n End Sub\r\n Private Sub btnIniciar_Click() Handles btnIniciar.Click\r\n  relogio.Start()\r\n End Sub\r\n Private Sub btnPausar_Click() Handles btnPausar.Click\r\n  relogio.Stop()\r\n End Sub\r\n Private Sub btnZerar_Click() Handles btnZerar.Click\r\n  relogio.Reset() : lstVoltas.Items.Clear()\r\n End Sub\r\n Private Sub btnVolta_Click() Handles btnVolta.Click\r\n  lstVoltas.Items.Insert(0,\"Volta \"&(lstVoltas.Items.Count+1).ToString()&\" — \"&Formatar(relogio.Elapsed))\r\n End Sub\r\n Private Sub atualizador_Tick() Handles atualizador.Tick\r\n  lblTempo.Text=Formatar(relogio.Elapsed)\r\n End Sub\r\n Private Function Formatar(t As TimeSpan) As String\r\n  Return String.Format(\"{0:00}:{1:00}:{2:00}.{3:000}\",CInt(Math.Floor(t.TotalHours)),t.Minutes,t.Seconds,t.Milliseconds)\r\n End Function\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"Cronômetro","AssemblyDescription":"Exemplo criado no FlowForge","AssemblyCompany":"Wtec","AssemblyProduct":"Cronometro","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}