{"Name":"TcpConsole","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Cliente TCP"},{"Key":"ClientSize","Value":"800, 520"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"MinimumSize","Value":"640, 420"}],"Controls":[{"TypeName":"Label","Name":"lblHost","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblHost"},{"Key":"Location","Value":"12, 17"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Servidor:"}]},{"TypeName":"TextBox","Name":"txtHost","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"txtHost"},{"Key":"Location","Value":"75, 13"},{"Key":"Size","Value":"210, 24"},{"Key":"Text","Value":"127.0.0.1"}]},{"TypeName":"Label","Name":"lblPorta","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"lblPorta"},{"Key":"Location","Value":"300, 17"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Porta:"}]},{"TypeName":"NumericUpDown","Name":"numPorta","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"numPorta"},{"Key":"Location","Value":"350, 13"},{"Key":"Size","Value":"90, 24"},{"Key":"Minimum","Value":"1"},{"Key":"Maximum","Value":"65535"},{"Key":"Value","Value":"23"}]},{"TypeName":"Button","Name":"btnConectar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnConectar"},{"Key":"Location","Value":"460, 11"},{"Key":"Size","Value":"100, 28"},{"Key":"Text","Value":"Conectar"}]},{"TypeName":"Button","Name":"btnDesconectar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnDesconectar"},{"Key":"Location","Value":"568, 11"},{"Key":"Size","Value":"110, 28"},{"Key":"Text","Value":"Desconectar"}]},{"TypeName":"RichTextBox","Name":"txtLog","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"txtLog"},{"Key":"Location","Value":"12, 52"},{"Key":"Size","Value":"776, 405"},{"Key":"ReadOnly","Value":"True"},{"Key":"BackColor","Value":"25, 25, 25"},{"Key":"ForeColor","Value":"White"},{"Key":"Font","Value":"Consolas, 10pt"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"}]},{"TypeName":"TextBox","Name":"txtEnviar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"txtEnviar"},{"Key":"Location","Value":"12, 470"},{"Key":"Size","Value":"655, 25"},{"Key":"Anchor","Value":"Bottom, Left, Right"}]},{"TypeName":"Button","Name":"btnEnviar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"btnEnviar"},{"Key":"Location","Value":"678, 468"},{"Key":"Size","Value":"110, 29"},{"Key":"Text","Value":"Enviar"},{"Key":"Anchor","Value":"Bottom, Right"}]}],"Code":"Imports System\r\nImports System.Net.Sockets\r\nImports System.Text\r\nImports System.Windows.Forms\r\nPartial Public Class Form1\r\n Private cliente As TcpClient\r\n Private fluxo As NetworkStream\r\n Private ativo As Boolean\r\n Private Async Sub btnConectar_Click() Handles btnConectar.Click\r\n  Try : cliente=New TcpClient() : Await cliente.ConnectAsync(txtHost.Text,Integer.Parse(numPorta.Value.ToString())) : fluxo=cliente.GetStream() : ativo=True : Log(\"[CONECTADO]\"&Environment.NewLine) : Receber() : Catch ex As Exception : Log(\"[ERRO] \"&ex.Message&Environment.NewLine) : End Try\r\n End Sub\r\n Private Async Sub Receber()\r\n  Dim buffer(4095) As Byte\r\n  Try\r\n   While ativo\r\n    Dim n=Await fluxo.ReadAsync(buffer,0,buffer.Length) : If n=0 Then Exit While\r\n    Log(Encoding.UTF8.GetString(buffer,0,n))\r\n   End While\r\n  Catch ex As Exception : If ativo Then Log(\"[ERRO RX] \"&ex.Message&Environment.NewLine)\r\n  Finally : Desconectar() : End Try\r\n End Sub\r\n Private Async Sub btnEnviar_Click() Handles btnEnviar.Click\r\n  If fluxo Is Nothing Then Return\r\n  Try : Dim b=Encoding.UTF8.GetBytes(txtEnviar.Text&Environment.NewLine) : Await fluxo.WriteAsync(b,0,b.Length) : Log(\"TX > \"&txtEnviar.Text&Environment.NewLine) : txtEnviar.Clear() : Catch ex As Exception : Log(\"[ERRO TX] \"&ex.Message&Environment.NewLine) : End Try\r\n End Sub\r\n Private Sub btnDesconectar_Click() Handles btnDesconectar.Click\r\n  Desconectar()\r\n End Sub\r\n Private Sub Desconectar()\r\n  ativo=False : If fluxo IsNot Nothing Then fluxo.Dispose() : fluxo=Nothing : If cliente IsNot Nothing Then cliente.Close() : cliente=Nothing\r\n End Sub\r\n Private Sub Log(s As String)\r\n  If txtLog.InvokeRequired Then txtLog.BeginInvoke(New Action(Of String)(AddressOf Log),s) Else txtLog.AppendText(s) : txtLog.ScrollToCaret()\r\n End Sub\r\n Private Sub Form1_FormClosing() Handles MyBase.FormClosing\r\n  Desconectar()\r\n End Sub\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"Cliente TCP","AssemblyDescription":"Exemplo criado no FlowForge","AssemblyCompany":"Wtec","AssemblyProduct":"TcpConsole","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}