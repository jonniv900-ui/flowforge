      "Code": "Imports FlowForgeStudio\nImports System\nImports System.Windows.Forms\n' EXEMPLO COMENTADO dos novos componentes da v5.\nPartial Public Class Form1\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\n        ' TerminalView funciona como console/log e também aceita comandos.\n        Terminal1.WriteLine(\"FlowForge TerminalView pronto.\")\n        Terminal1.WriteLine(\"Digite HELP e pressione Enter.\")\n        ' Accordion pode ser controlado por código.\n        Accordion1.ExpandSection(0)\n    End Sub\n    Private Sub NextButton_Click(sender As Object, e As System.EventArgs) Handles NextButton.Click\n        ' Avança uma etapa e exibe uma notificação.\n        Stepper1.NextStep()\n        Toast1.Show(\"Etapa atual: \" & Stepper1.CurrentStep.ToString(), FlowForgeStudio.ToastKind.Success)\n    End Sub\n    Private Sub PrevButton_Click(sender As Object, e As System.EventArgs) Handles PrevButton.Click\n        Stepper1.PreviousStep()\n    End Sub\n    Private Sub ToastButton_Click(sender As Object, e As System.EventArgs) Handles ToastButton.Click\n        Toast1.Show(\"Esta é uma notificação dinâmica.\", FlowForgeStudio.ToastKind.Info)\n    End Sub\n    Private Sub Terminal1_CommandEntered(sender As Object, e As FlowForgeStudio.TerminalCommandEventArgs) Handles Terminal1.CommandEntered\n        ' CommandEntered entrega o comando digitado no terminal.\n        Dim cmd As String = e.Command.Trim().ToUpperInvariant()\n        Select Case cmd\n            Case \"HELP\" : Terminal1.WriteLine(\"Comandos: HELP, CLEAR, STATUS\")\n            Case \"CLEAR\" : Terminal1.ClearScreen()\n            Case \"STATUS\" : Terminal1.WriteLine(\"Stepper = \" & Stepper1.CurrentStep.ToString())\n            Case Else : Terminal1.WriteLine(\"Comando recebido: \" & e.Command)\n        End Select\n    End Sub\nEnd Class\n"
    }
