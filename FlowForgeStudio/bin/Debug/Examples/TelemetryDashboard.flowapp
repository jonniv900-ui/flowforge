      "Code": "Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Sub NumericKnob1_ValueChanged() Handles NumericKnob1.ValueChanged\n        BatteryIndicator1.Value = NumericKnob1.Value\n        SignalStrength1.Value = NumericKnob1.Value\n        AnalogGauge1.Value = NumericKnob1.Value\n        ThermometerGauge1.Value = NumericKnob1.Value\n        NotificationBanner1.Text = \"Leitura atual: \" & NumericKnob1.Value.ToString()\n    End Sub\n\n    Private Sub ChargeButton_CheckedChanged() Handles ChargeButton.CheckedChanged\n        BatteryIndicator1.Charging = ChargeButton.Checked\n        LoadingSpinner1.Active = ChargeButton.Checked\n        NotificationBanner1.BannerStyle = If(ChargeButton.Checked, FlowForgeStudio.NotificationBannerStyle.Success, FlowForgeStudio.NotificationBannerStyle.Information)\n    End Sub\n\n    Private Sub ColorSwatch1_SelectedColorChanged() Handles ColorSwatch1.SelectedColorChanged\n        AnalogGauge1.ForeColor = ColorSwatch1.SelectedColor\n        NotificationBanner1.ForeColor = ColorSwatch1.SelectedColor\n    End Sub\nEnd Class\n"
    }
