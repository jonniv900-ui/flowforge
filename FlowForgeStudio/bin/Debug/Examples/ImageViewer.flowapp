      ],
      "Code": "Imports System\r\nImports System.Drawing\r\nImports System.IO\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private Sub btnAbrir_Click(sender As Object, e As System.EventArgs) Handles btnAbrir.Click\r\n        Using dialogo As New OpenFileDialog()\r\n            dialogo.Filter = \"Imagens|*.png;*.jpg;*.jpeg;*.bmp;*.gif;*.tif;*.tiff|Todos os arquivos|*.*\"\r\n            If dialogo.ShowDialog() <> DialogResult.OK Then Return\r\n            Try\r\n                Dim novaImagem As Bitmap\r\n                Using arquivo As Image = Image.FromFile(dialogo.FileName)\r\n                    novaImagem = New Bitmap(arquivo)\r\n                End Using\r\n                Dim imagemAnterior As Image = picImagem.Image\r\n                picImagem.Image = novaImagem\r\n                If imagemAnterior IsNot Nothing Then imagemAnterior.Dispose()\r\n                lblInfo.Text = System.IO.Path.GetFileName(dialogo.FileName) & \" — \" & novaImagem.Width.ToString() & \" x \" & novaImagem.Height.ToString()\r\n            Catch ex As Exception\r\n                MessageBox.Show(ex.Message, \"Abrir imagem\", MessageBoxButtons.OK, MessageBoxIcon.Error)\r\n            End Try\r\n        End Using\r\n    End Sub\r\n\r\n    Private Sub btnAjustar_Click(sender As Object, e As System.EventArgs) Handles btnAjustar.Click\r\n        picImagem.SizeMode = PictureBoxSizeMode.Zoom\r\n    End Sub\r\n\r\n    Private Sub btnReal_Click(sender As Object, e As System.EventArgs) Handles btnReal.Click\r\n        picImagem.SizeMode = PictureBoxSizeMode.CenterImage\r\n    End Sub\r\n\r\n    Private Sub btnGirar_Click(sender As Object, e As System.EventArgs) Handles btnGirar.Click\r\n        If picImagem.Image Is Nothing Then Return\r\n        picImagem.Image.RotateFlip(RotateFlipType.Rotate90FlipNone)\r\n        picImagem.Refresh()\r\n        lblInfo.Text = picImagem.Image.Width.ToString() & \" x \" & picImagem.Image.Height.ToString()\r\n    End Sub\r\n\r\n    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing\r\n        Dim imagem As Image = picImagem.Image\r\n        picImagem.Image = Nothing\r\n        If imagem IsNot Nothing Then imagem.Dispose()\r\n    End Sub\r\nEnd Class"
    }
