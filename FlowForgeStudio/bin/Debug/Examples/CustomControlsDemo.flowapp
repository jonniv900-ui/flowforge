      ],
      "Code": "Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private counter As Integer\n\n    Private Sub ToggleSwitch1_CheckedChanged() Handles ToggleSwitch1.CheckedChanged\n        LedIndicator1.IsOn = ToggleSwitch1.Checked\n        DigitalDisplay1.Value = If(ToggleSwitch1.Checked, \"LIGADO\", \"DESLIGADO\")\n    End Sub\n\n    Private Sub CountButton_Click() Handles CountButton.Click\n        counter += 1\n        DigitalDisplay1.Value = counter.ToString()\n        LedIndicator1.Toggle()\n    End Sub\n\n    Private Sub ColorsButton_Click() Handles ColorsButton.Click\n        GradientPanel1.SwapColors()\n        DigitalDisplay1.AppendValue(\".\")\n    End Sub\nEnd Class\n"
    }
