{"Name":"ConversorTemperatura","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Conversor de Temperatura"},{"Key":"ClientSize","Value":"380, 280"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"FixedSingle"},{"Key":"BackColor","Value":"White"},{"Key":"Font","Value":"Segoe UI, 10pt"},{"Key":"MaximizeBox","Value":"False"},{"Key":"MinimizeBox","Value":"True"}],"Controls":[{"TypeName":"Label","Name":"LabelCelsius","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelCelsius"},{"Key":"Location","Value":"30, 33"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Celsius (°C):"}],"Items":[]},{"TypeName":"TextBox","Name":"TextBoxCelsius","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TextBoxCelsius"},{"Key":"Location","Value":"180, 27"},{"Key":"Size","Value":"170, 27"},{"Key":"TextAlign","Value":"Right"}],"Items":[]},{"TypeName":"Label","Name":"LabelFahrenheit","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelFahrenheit"},{"Key":"Location","Value":"30, 83"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Fahrenheit (°F):"}],"Items":[]},{"TypeName":"TextBox","Name":"TextBoxFahrenheit","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TextBoxFahrenheit"},{"Key":"Location","Value":"180, 77"},{"Key":"Size","Value":"170, 27"},{"Key":"TextAlign","Value":"Right"}],"Items":[]},{"TypeName":"Button","Name":"ButtonCparaF","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonCparaF"},{"Key":"Location","Value":"30, 130"},{"Key":"Size","Value":"320, 36"},{"Key":"Text","Value":"Celsius -> Fahrenheit"}],"Items":[]},{"TypeName":"Button","Name":"ButtonFparaC","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonFparaC"},{"Key":"Location","Value":"30, 175"},{"Key":"Size","Value":"320, 36"},{"Key":"Text","Value":"Fahrenheit -> Celsius"}],"Items":[]},{"TypeName":"Button","Name":"ButtonLimpar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonLimpar"},{"Key":"Location","Value":"30, 222"},{"Key":"Size","Value":"320, 32"},{"Key":"Text","Value":"Limpar"},{"Key":"BackColor","Value":"IndianRed"},{"Key":"ForeColor","Value":"White"}],"Items":[]}],"Code":"Imports System\nImports System.Windows.Forms\nImports System.Globalization\n\nPartial Public Class Form1\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        TextBoxCelsius.Text = \"0\"\n        TextBoxFahrenheit.Text = \"32\"\n    End Sub\n\n    Private Sub ButtonCparaF_Click() Handles ButtonCparaF.Click\n        Dim celsius As Double\n        If Double.TryParse(TextBoxCelsius.Text, NumberStyles.Any, CultureInfo.InvariantCulture, celsius) Then\n            Dim fahrenheit As Double = celsius * 9 / 5 + 32\n            TextBoxFahrenheit.Text = fahrenheit.ToString(\"0.00\")\n        Else\n            MessageBox.Show(\"Digite um valor numerico valido em Celsius.\", \"Valor invalido\", MessageBoxButtons.OK, MessageBoxIcon.Warning)\n        End If\n    End Sub\n\n    Private Sub ButtonFparaC_Click() Handles ButtonFparaC.Click\n        Dim fahrenheit As Double\n        If Double.TryParse(TextBoxFahrenheit.Text, NumberStyles.Any, CultureInfo.InvariantCulture, fahrenheit) Then\n            Dim celsius As Double = (fahrenheit - 32) * 5 / 9\n            TextBoxCelsius.Text = celsius.ToString(\"0.00\")\n        Else\n            MessageBox.Show(\"Digite um valor numerico valido em Fahrenheit.\", \"Valor invalido\", MessageBoxButtons.OK, MessageBoxIcon.Warning)\n        End If\n    End Sub\n\n    Private Sub ButtonLimpar_Click() Handles ButtonLimpar.Click\n        TextBoxCelsius.Text = \"0\"\n        TextBoxFahrenheit.Text = \"32\"\n    End Sub\n\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"","AssemblyDescription":"","AssemblyCompany":"","AssemblyProduct":"","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}