      ],
      "Code": "Imports System\r\nImports System.IO.Ports\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private Sub Form1_Load(sender As Object, e As System.EventArgs) Handles MyBase.Load\r\n        AtualizarPortas()\r\n        AtualizarInterface(False)\r\n    End Sub\r\n\r\n    Private Sub btnAtualizar_Click(sender As Object, e As System.EventArgs) Handles btnAtualizar.Click\r\n        AtualizarPortas()\r\n    End Sub\r\n\r\n    Private Sub AtualizarPortas()\r\n        cmbPorta.Items.Clear()\r\n        Dim portas As String() = SerialPort.GetPortNames()\r\n        Array.Sort(portas)\r\n        cmbPorta.Items.AddRange(portas)\r\n        If cmbPorta.Items.Count > 0 Then cmbPorta.SelectedIndex = 0\r\n    End Sub\r\n\r\n    Private Sub btnConectar_Click(sender As Object, e As System.EventArgs) Handles btnConectar.Click\r\n        If SerialConnection1.IsOpen Then\r\n            Desconectar()\r\n            Return\r\n        End If\r\n        If cmbPorta.SelectedItem Is Nothing Then\r\n            MessageBox.Show(\"Selecione uma porta COM.\", \"Arduino\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n            Return\r\n        End If\r\n        Try\r\n            SerialConnection1.PortName = cmbPorta.SelectedItem.ToString()\r\n            SerialConnection1.BaudRate = 9600\r\n            SerialConnection1.DataBits = 8\r\n            SerialConnection1.Parity = Parity.None\r\n            SerialConnection1.StopBits = StopBits.One\r\n            SerialConnection1.Handshake = Handshake.None\r\n            SerialConnection1.DtrEnable = True\r\n            SerialConnection1.Open()\r\n            AtualizarInterface(True)\r\n            AdicionarLog(\"[CONECTADO] \" & SerialConnection1.PortName & Environment.NewLine)\r\n        Catch ex As Exception\r\n            MessageBox.Show(ex.Message, \"Arduino\", MessageBoxButtons.OK, MessageBoxIcon.Error)\r\n            AtualizarInterface(False)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub btnLigar_Click(sender As Object, e As System.EventArgs) Handles btnLigar.Click\r\n        Enviar(\"LED_ON\")\r\n    End Sub\r\n\r\n    Private Sub btnDesligar_Click(sender As Object, e As System.EventArgs) Handles btnDesligar.Click\r\n        Enviar(\"LED_OFF\")\r\n    End Sub\r\n\r\n    Private Sub btnEnviar_Click(sender As Object, e As System.EventArgs) Handles btnEnviar.Click\r\n        Enviar(txtComando.Text)\r\n    End Sub\r\n\r\n    Private Sub Enviar(comando As String)\r\n        If Not SerialConnection1.IsOpen Then\r\n            MessageBox.Show(\"Conecte o Arduino primeiro.\", \"Arduino\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n            Return\r\n        End If\r\n        Try\r\n            SerialConnection1.WriteLine(comando)\r\n            AdicionarLog(\"TX > \" & comando & Environment.NewLine)\r\n        Catch ex As Exception\r\n            AdicionarLog(\"[ERRO TX] \" & ex.Message & Environment.NewLine)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub SerialConnection1_DataReceived(sender As Object, e As SerialDataReceivedEventArgs) Handles SerialConnection1.DataReceived\r\n        Try\r\n            Dim recebido As String = SerialConnection1.ReadExisting()\r\n            If recebido <> \"\" Then AdicionarLogSeguro(\"RX < \" & recebido)\r\n        Catch ex As Exception\r\n            AdicionarLogSeguro(\"[ERRO RX] \" & ex.Message & Environment.NewLine)\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub AdicionarLogSeguro(texto As String)\r\n        If txtLog.InvokeRequired Then\r\n            txtLog.BeginInvoke(New Action(Of String)(AddressOf AdicionarLog), New Object() {texto})\r\n        Else\r\n            AdicionarLog(texto)\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub AdicionarLog(texto As String)\r\n        txtLog.AppendText(texto)\r\n        txtLog.SelectionStart = txtLog.TextLength\r\n        txtLog.ScrollToCaret()\r\n    End Sub\r\n\r\n    Private Sub Desconectar()\r\n        Try\r\n            If SerialConnection1.IsOpen Then SerialConnection1.Close()\r\n        Catch\r\n        End Try\r\n        AtualizarInterface(False)\r\n        AdicionarLog(\"[DESCONECTADO]\" & Environment.NewLine)\r\n    End Sub\r\n\r\n    Private Sub AtualizarInterface(conectado As Boolean)\r\n        lblEstado.Text = If(conectado, \"Conectado\", \"Desconectado\")\r\n        btnConectar.Text = If(conectado, \"Desconectar\", \"Conectar\")\r\n        cmbPorta.Enabled = Not conectado\r\n        btnAtualizar.Enabled = Not conectado\r\n        btnLigar.Enabled = conectado\r\n        btnDesligar.Enabled = conectado\r\n        btnEnviar.Enabled = conectado\r\n    End Sub\r\n\r\n    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles MyBase.FormClosing\r\n        If SerialConnection1.IsOpen Then SerialConnection1.Close()\r\n    End Sub\r\nEnd Class"
    }
  ],
