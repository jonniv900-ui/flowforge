{"Name":"ControlesAvancados","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Controles avançados FlowForge"},{"Key":"ClientSize","Value":"760, 430"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"BackColor","Value":"WhiteSmoke"},{"Key":"Font","Value":"Segoe UI, 10pt"}],"Controls":[{"TypeName":"BadgeLabel","Name":"BadgeLabel1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"BadgeLabel1"},{"Key":"Location","Value":"25, 20"},{"Key":"Size","Value":"150, 32"},{"Key":"Text","Value":"FLOWFORGE UI"},{"Key":"BadgeColor","Value":"RoyalBlue"}],"Items":[]},{"TypeName":"SeparatorLine","Name":"SeparatorLine1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"SeparatorLine1"},{"Key":"Location","Value":"25, 62"},{"Key":"Size","Value":"700, 4"},{"Key":"LineColor","Value":"Silver"},{"Key":"Thickness","Value":"2"}],"Items":[]},{"TypeName":"DigitalDisplay","Name":"DigitalDisplay1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"DigitalDisplay1"},{"Key":"Location","Value":"25, 85"},{"Key":"Size","Value":"420, 75"},{"Key":"Digits","Value":"10"},{"Key":"Value","Value":"123.45"},{"Key":"DisplayStyle","Value":"SevenSegment"}],"Items":[]},{"TypeName":"CircularProgress","Name":"CircularProgress1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"CircularProgress1"},{"Key":"Location","Value":"485, 78"},{"Key":"Size","Value":"115, 115"},{"Key":"Value","Value":"45"},{"Key":"ProgressColor","Value":"DodgerBlue"}],"Items":[]},{"TypeName":"LevelMeter","Name":"LevelMeter1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LevelMeter1"},{"Key":"Location","Value":"650, 82"},{"Key":"Size","Value":"45, 170"},{"Key":"Value","Value":"45"}],"Items":[]},{"TypeName":"NumericKnob","Name":"NumericKnob1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"NumericKnob1"},{"Key":"Location","Value":"25, 195"},{"Key":"Size","Value":"115, 115"},{"Key":"Value","Value":"45"}],"Items":[]},{"TypeName":"StarRating","Name":"StarRating1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"StarRating1"},{"Key":"Location","Value":"175, 215"},{"Key":"Size","Value":"230, 45"},{"Key":"Rating","Value":"4"}],"Items":[]},{"TypeName":"RoundedButton","Name":"StyleButton","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"StyleButton"},{"Key":"Location","Value":"175, 275"},{"Key":"Size","Value":"230, 45"},{"Key":"Text","Value":"TROCAR TIPO DO DISPLAY"},{"Key":"CornerRadius","Value":"16"}],"Items":[]},{"TypeName":"CardPanel","Name":"CardPanel1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"CardPanel1"},{"Key":"Location","Value":"465, 285"},{"Key":"Size","Value":"260, 105"},{"Key":"BackColor","Value":"White"},{"Key":"BorderColor","Value":"Gainsboro"}],"Items":[]}],"Code":"Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Sub NumericKnob1_ValueChanged() Handles NumericKnob1.ValueChanged\n        CircularProgress1.Value = NumericKnob1.Value\n        LevelMeter1.Value = NumericKnob1.Value\n        DigitalDisplay1.Value = NumericKnob1.Value.ToString()\n    End Sub\n\n    Private Sub StarRating1_RatingChanged() Handles StarRating1.RatingChanged\n        BadgeLabel1.Text = StarRating1.Rating.ToString() & \" ESTRELAS\"\n    End Sub\n\n    Private Sub StyleButton_Click() Handles StyleButton.Click\n        If DigitalDisplay1.DisplayStyle = FlowForgeStudio.DigitalDisplayStyle.SevenSegment Then\n            DigitalDisplay1.DisplayStyle = FlowForgeStudio.DigitalDisplayStyle.DotMatrix\n        ElseIf DigitalDisplay1.DisplayStyle = FlowForgeStudio.DigitalDisplayStyle.DotMatrix Then\n            DigitalDisplay1.DisplayStyle = FlowForgeStudio.DigitalDisplayStyle.Text\n        Else\n            DigitalDisplay1.DisplayStyle = FlowForgeStudio.DigitalDisplayStyle.SevenSegment\n        End If\n    End Sub\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"Controles avançados","AssemblyDescription":"Demonstração dos controles avançados do FlowForge","AssemblyCompany":"FlowForge","AssemblyProduct":"Controles avançados","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}
