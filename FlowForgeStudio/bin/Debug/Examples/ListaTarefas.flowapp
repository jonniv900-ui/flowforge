{"Name":"ListaTarefas","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Lista de Tarefas"},{"Key":"ClientSize","Value":"380, 480"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"MinimumSize","Value":"380, 480"},{"Key":"BackColor","Value":"White"},{"Key":"Font","Value":"Segoe UI, 9pt"}],"Controls":[{"TypeName":"Label","Name":"LabelTitulo","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelTitulo"},{"Key":"Location","Value":"20, 20"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Nova tarefa:"}],"Items":[]},{"TypeName":"TextBox","Name":"TextBoxNovaTarefa","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TextBoxNovaTarefa"},{"Key":"Location","Value":"20, 45"},{"Key":"Size","Value":"240, 27"},{"Key":"Anchor","Value":"Top, Left, Right"}],"Items":[]},{"TypeName":"Button","Name":"ButtonAdicionar","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonAdicionar"},{"Key":"Location","Value":"270, 44"},{"Key":"Size","Value":"90, 29"},{"Key":"Text","Value":"Adicionar"},{"Key":"Anchor","Value":"Top, Right"}],"Items":[]},{"TypeName":"ListBox","Name":"ListBoxTarefas","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ListBoxTarefas"},{"Key":"Location","Value":"20, 85"},{"Key":"Size","Value":"340, 300"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"},{"Key":"IntegralHeight","Value":"False"}],"Items":[]},{"TypeName":"Button","Name":"ButtonRemover","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonRemover"},{"Key":"Location","Value":"20, 400"},{"Key":"Size","Value":"165, 32"},{"Key":"Text","Value":"Remover selecionada"},{"Key":"Anchor","Value":"Bottom, Left"}],"Items":[]},{"TypeName":"Button","Name":"ButtonLimparTudo","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ButtonLimparTudo"},{"Key":"Location","Value":"195, 400"},{"Key":"Size","Value":"165, 32"},{"Key":"Text","Value":"Limpar tudo"},{"Key":"BackColor","Value":"IndianRed"},{"Key":"ForeColor","Value":"White"},{"Key":"Anchor","Value":"Bottom, Right"}],"Items":[]},{"TypeName":"Label","Name":"LabelContador","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"LabelContador"},{"Key":"Location","Value":"20, 442"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"0 tarefa(s)"},{"Key":"Anchor","Value":"Bottom, Left"}],"Items":[]}],"Code":"Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        AtualizarContador()\n    End Sub\n\n    Private Sub ButtonAdicionar_Click() Handles ButtonAdicionar.Click\n        AdicionarTarefa()\n    End Sub\n\n    ' Permite adicionar a tarefa tambem apertando Enter dentro do TextBox.\n    Private Sub TextBoxNovaTarefa_KeyDown(sender As Object, e As KeyEventArgs) Handles TextBoxNovaTarefa.KeyDown\n        If e.KeyCode = Keys.Enter Then\n            AdicionarTarefa()\n            e.SuppressKeyPress = True\n        End If\n    End Sub\n\n    Private Sub AdicionarTarefa()\n        Dim texto As String = TextBoxNovaTarefa.Text.Trim()\n        If texto = \"\" Then\n            MessageBox.Show(\"Digite uma tarefa antes de adicionar.\", \"Campo vazio\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n            Return\n        End If\n        ListBoxTarefas.Items.Add(texto)\n        TextBoxNovaTarefa.Text = \"\"\n        TextBoxNovaTarefa.Focus()\n        AtualizarContador()\n    End Sub\n\n    Private Sub ButtonRemover_Click() Handles ButtonRemover.Click\n        If ListBoxTarefas.SelectedIndex = -1 Then\n            MessageBox.Show(\"Selecione uma tarefa na lista para remover.\", \"Nada selecionado\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n            Return\n        End If\n        ListBoxTarefas.Items.RemoveAt(ListBoxTarefas.SelectedIndex)\n        AtualizarContador()\n    End Sub\n\n    Private Sub ButtonLimparTudo_Click() Handles ButtonLimparTudo.Click\n        If ListBoxTarefas.Items.Count = 0 Then Return\n        Dim resposta As DialogResult = MessageBox.Show(\"Remover todas as tarefas?\", \"Confirmar\", MessageBoxButtons.YesNo, MessageBoxIcon.Question)\n        If resposta = DialogResult.Yes Then\n            ListBoxTarefas.Items.Clear()\n            AtualizarContador()\n        End If\n    End Sub\n\n    Private Sub AtualizarContador()\n        LabelContador.Text = ListBoxTarefas.Items.Count & \" tarefa(s)\"\n    End Sub\n\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"","AssemblyDescription":"","AssemblyCompany":"","AssemblyProduct":"","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}