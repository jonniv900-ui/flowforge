{"Name":"EditoresTexto","Version":"1.0.0","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"Editores de texto FlowForge"},{"Key":"ClientSize","Value":"1050, 590"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"BackColor","Value":"WhiteSmoke"},{"Key":"Font","Value":"Segoe UI, 9pt"}],"Controls":[{"TypeName":"Label","Name":"RichLabel","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"RichLabel"},{"Key":"Location","Value":"20, 18"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"EDITOR DE DOCUMENTOS"}],"Items":[]},{"TypeName":"RichTextEditor","Name":"RichTextEditor1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"RichTextEditor1"},{"Key":"Location","Value":"20, 48"},{"Key":"Size","Value":"490, 485"},{"Key":"Text","Value":"Digite e formate seu documento aqui."},{"Key":"ToolbarVisible","Value":"True"}],"Items":[]},{"TypeName":"Label","Name":"CodeLabel","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"CodeLabel"},{"Key":"Location","Value":"535, 18"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"EDITOR DE CÓDIGO — VB.NET"}],"Items":[]},{"TypeName":"SyntaxCodeEditor","Name":"SyntaxCodeEditor1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"SyntaxCodeEditor1"},{"Key":"Location","Value":"535, 48"},{"Key":"Size","Value":"495, 485"},{"Key":"Language","Value":"VisualBasic"},{"Key":"ShowLineNumbers","Value":"True"},{"Key":"Text","Value":"Imports System\nImports System.Windows.Forms\n\nPublic Class Exemplo\n    Private Sub MostrarMensagem()\n        Dim mensagem As String = \"Olá, FlowForge!\"\n        MessageBox.Show(mensagem)\n    End Sub\nEnd Class"}],"Items":[]},{"TypeName":"Label","Name":"StatusLabel","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"StatusLabel"},{"Key":"Location","Value":"20, 550"},{"Key":"AutoSize","Value":"True"},{"Key":"Text","Value":"Pronto"}],"Items":[]}],"Code":"Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Sub RichTextEditor1_ContentChanged() Handles RichTextEditor1.ContentChanged\n        StatusLabel.Text = \"Documento: \" & RichTextEditor1.Text.Length.ToString() & \" caracteres\"\n    End Sub\n\n    Private Sub SyntaxCodeEditor1_CodeChanged() Handles SyntaxCodeEditor1.CodeChanged\n        StatusLabel.Text = \"Código: \" & SyntaxCodeEditor1.LineCount.ToString() & \" linhas\"\n    End Sub\nEnd Class\n"}],"ApplicationIcon":"","AssemblyTitle":"Editores de Texto","AssemblyDescription":"Editores rico e de código do FlowForge","AssemblyCompany":"FlowForge","AssemblyProduct":"Editores de Texto","AssemblyCopyright":"","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0"}
