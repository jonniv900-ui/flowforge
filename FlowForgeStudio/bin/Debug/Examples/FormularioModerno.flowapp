      ],
      "Code": "Imports System\nImports System.Windows.Forms\n\nPartial Public Class Form1\n    Private Sub SearchBox1_Search() Handles SearchBox1.Search\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"Pesquisa solicitada por: \" & SearchBox1.Text\n    End Sub\n\n    Private Sub ShowButton_Click() Handles ShowButton.Click\n        PasswordBox1.ShowPassword = Not PasswordBox1.ShowPassword\n    End Sub\n\n    Private Sub IPAddressBox1_TextChanged() Handles IPAddressBox1.TextChanged\n        If IpStatus Is Nothing Then Return\n        IpStatus.Text = If(IPAddressBox1.IsValidAddress, \"IP válido\", \"IP incompleto/inválido\")\n    End Sub\n\n    Private Sub ModernDatePicker1_ValueChanged() Handles ModernDatePicker1.ValueChanged\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"Data escolhida: \" & ModernDatePicker1.Value.ToLongDateString()\n    End Sub\n\n    Private Sub TagInput1_TagsChanged() Handles TagInput1.TagsChanged\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"Tags cadastradas: \" & TagInput1.TagCount.ToString()\n    End Sub\n\n    Private Sub TabStripCustom1_SelectedIndexChanged() Handles TabStripCustom1.SelectedIndexChanged\n        If StatusLabel Is Nothing Then Return\n        StatusLabel.Text = \"Aba: \" & TabStripCustom1.SelectedTabText\n    End Sub\n\n    Private Sub PrevButton_Click() Handles PrevButton.Click\n        TabStripCustom1.SelectedIndex = Math.Max(0, TabStripCustom1.SelectedIndex - 1)\n    End Sub\n\n    Private Sub NextButton_Click() Handles NextButton.Click\n        TabStripCustom1.SelectedIndex = Math.Min(3, TabStripCustom1.SelectedIndex + 1)\n    End Sub\n\n    Private Sub ImageButton1_Click() Handles ImageButton1.Click\n        StatusLabel.Text = \"ImageButton também funciona como um botão normal.\"\n    End Sub\nEnd Class\n"
    }
