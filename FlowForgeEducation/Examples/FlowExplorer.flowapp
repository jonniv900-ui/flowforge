{"Name":"FlowExplorer","Version":"1.0.1","Forms":[{"Name":"Form1","IsStartup":true,"Properties":[{"Key":"Name","Value":"Form1"},{"Key":"Text","Value":"FlowExplorer"},{"Key":"ClientSize","Value":"1100, 670"},{"Key":"StartPosition","Value":"CenterScreen"},{"Key":"FormBorderStyle","Value":"Sizable"},{"Key":"BackColor","Value":"Control"},{"Key":"Font","Value":"Segoe UI, 9pt"},{"Key":"MinimumSize","Value":"820, 520"},{"Key":"KeyPreview","Value":"True"}],"Controls":[{"TypeName":"MenuStrip","Name":"MenuStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"MenuStrip1"},{"Key":"Location","Value":"0, 0"},{"Key":"Size","Value":"1100, 24"},{"Key":"Dock","Value":"Top"}],"Items":[{"TypeName":"ToolStripMenuItem","Name":"MenuArquivo","Text":"Arquivo","Properties":[{"Key":"Name","Value":"MenuArquivo"},{"Key":"Text","Value":"Arquivo"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuAbrir","Text":"Abrir","Properties":[{"Key":"Name","Value":"MenuAbrir"},{"Key":"Text","Value":"Abrir"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuNovaPasta","Text":"Nova pasta","Properties":[{"Key":"Name","Value":"MenuNovaPasta"},{"Key":"Text","Value":"Nova pasta"}],"DropDownItems":[]},{"TypeName":"ToolStripSeparator","Name":"SepArquivo","Text":"-","Properties":[{"Key":"Name","Value":"SepArquivo"},{"Key":"Text","Value":"-"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuPropriedades","Text":"Propriedades","Properties":[{"Key":"Name","Value":"MenuPropriedades"},{"Key":"Text","Value":"Propriedades"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuExcluir","Text":"Excluir","Properties":[{"Key":"Name","Value":"MenuExcluir"},{"Key":"Text","Value":"Excluir"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuRenomear","Text":"Renomear","Properties":[{"Key":"Name","Value":"MenuRenomear"},{"Key":"Text","Value":"Renomear"}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuNavegar","Text":"Navegar","Properties":[{"Key":"Name","Value":"MenuNavegar"},{"Key":"Text","Value":"Navegar"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuVoltar","Text":"Voltar","Properties":[{"Key":"Name","Value":"MenuVoltar"},{"Key":"Text","Value":"Voltar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuAvancar","Text":"Avançar","Properties":[{"Key":"Name","Value":"MenuAvancar"},{"Key":"Text","Value":"Avançar"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuSubir","Text":"Subir","Properties":[{"Key":"Name","Value":"MenuSubir"},{"Key":"Text","Value":"Subir"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuAtualizar","Text":"Atualizar","Properties":[{"Key":"Name","Value":"MenuAtualizar"},{"Key":"Text","Value":"Atualizar"}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuExibir","Text":"Exibir","Properties":[{"Key":"Name","Value":"MenuExibir"},{"Key":"Text","Value":"Exibir"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuDetalhes","Text":"Detalhes","Properties":[{"Key":"Name","Value":"MenuDetalhes"},{"Key":"Text","Value":"Detalhes"}],"DropDownItems":[]},{"TypeName":"ToolStripMenuItem","Name":"MenuIcones","Text":"Ícones grandes","Properties":[{"Key":"Name","Value":"MenuIcones"},{"Key":"Text","Value":"Ícones grandes"}],"DropDownItems":[]}]},{"TypeName":"ToolStripMenuItem","Name":"MenuAjuda","Text":"Ajuda","Properties":[{"Key":"Name","Value":"MenuAjuda"},{"Key":"Text","Value":"Ajuda"}],"DropDownItems":[{"TypeName":"ToolStripMenuItem","Name":"MenuSobre","Text":"Sobre","Properties":[{"Key":"Name","Value":"MenuSobre"},{"Key":"Text","Value":"Sobre"}],"DropDownItems":[]}]}]},{"TypeName":"ToolStrip","Name":"ToolStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ToolStrip1"},{"Key":"Location","Value":"0, 24"},{"Key":"Size","Value":"1100, 27"},{"Key":"Dock","Value":"Top"}],"Items":[{"TypeName":"ToolStripButton","Name":"BtnVoltar","Text":"Voltar","Properties":[{"Key":"Name","Value":"BtnVoltar"},{"Key":"Text","Value":"Voltar"},{"Key":"ToolTipText","Value":"Voltar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnAvancar","Text":"Avançar","Properties":[{"Key":"Name","Value":"BtnAvancar"},{"Key":"Text","Value":"Avançar"},{"Key":"ToolTipText","Value":"Avançar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnSubir","Text":"Subir","Properties":[{"Key":"Name","Value":"BtnSubir"},{"Key":"Text","Value":"Subir"},{"Key":"ToolTipText","Value":"Subir"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnAtualizar","Text":"Atualizar","Properties":[{"Key":"Name","Value":"BtnAtualizar"},{"Key":"Text","Value":"Atualizar"},{"Key":"ToolTipText","Value":"Atualizar"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnNovaPasta","Text":"Nova pasta","Properties":[{"Key":"Name","Value":"BtnNovaPasta"},{"Key":"Text","Value":"Nova pasta"},{"Key":"ToolTipText","Value":"Nova pasta"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnAbrir","Text":"Abrir","Properties":[{"Key":"Name","Value":"BtnAbrir"},{"Key":"Text","Value":"Abrir"},{"Key":"ToolTipText","Value":"Abrir"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnRenomear","Text":"Renomear","Properties":[{"Key":"Name","Value":"BtnRenomear"},{"Key":"Text","Value":"Renomear"},{"Key":"ToolTipText","Value":"Renomear"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnExcluir","Text":"Excluir","Properties":[{"Key":"Name","Value":"BtnExcluir"},{"Key":"Text","Value":"Excluir"},{"Key":"ToolTipText","Value":"Excluir"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnDetalhes","Text":"Detalhes","Properties":[{"Key":"Name","Value":"BtnDetalhes"},{"Key":"Text","Value":"Detalhes"},{"Key":"ToolTipText","Value":"Detalhes"}],"DropDownItems":[]},{"TypeName":"ToolStripButton","Name":"BtnIcones","Text":"Ícones grandes","Properties":[{"Key":"Name","Value":"BtnIcones"},{"Key":"Text","Value":"Ícones grandes"},{"Key":"ToolTipText","Value":"Ícones grandes"}],"DropDownItems":[]}]},{"TypeName":"ComboBox","Name":"ComboEndereco","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ComboEndereco"},{"Key":"Location","Value":"12, 59"},{"Key":"Size","Value":"840, 25"},{"Key":"Anchor","Value":"Top, Left, Right"},{"Key":"DropDownStyle","Value":"DropDown"}],"Items":[]},{"TypeName":"TextBox","Name":"CampoFiltro","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"CampoFiltro"},{"Key":"Text","Value":""},{"Key":"Location","Value":"865, 59"},{"Key":"Size","Value":"220, 25"},{"Key":"Anchor","Value":"Top, Right"}],"Items":[]},{"TypeName":"TreeView","Name":"TreeViewPastas","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"TreeViewPastas"},{"Key":"Location","Value":"12, 94"},{"Key":"Size","Value":"310, 545"},{"Key":"Anchor","Value":"Top, Bottom, Left"},{"Key":"HideSelection","Value":"False"}],"Items":[]},{"TypeName":"ListView","Name":"ListViewArquivos","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"ListViewArquivos"},{"Key":"Location","Value":"332, 94"},{"Key":"Size","Value":"753, 545"},{"Key":"Anchor","Value":"Top, Bottom, Left, Right"},{"Key":"View","Value":"Details"},{"Key":"FullRowSelect","Value":"True"},{"Key":"GridLines","Value":"True"},{"Key":"HideSelection","Value":"False"},{"Key":"MultiSelect","Value":"False"}],"Items":[]},{"TypeName":"StatusStrip","Name":"StatusStrip1","AssemblyPath":"","IsNonVisual":false,"Properties":[{"Key":"Name","Value":"StatusStrip1"},{"Key":"Location","Value":"0, 648"},{"Key":"Size","Value":"1100, 22"},{"Key":"Dock","Value":"Bottom"}],"Items":[{"TypeName":"ToolStripStatusLabel","Name":"StatusMensagem","Text":"Pronto","Properties":[{"Key":"Name","Value":"StatusMensagem"},{"Key":"Text","Value":"Pronto"}],"DropDownItems":[]},{"TypeName":"ToolStripStatusLabel","Name":"StatusCaminho","Text":"","Properties":[{"Key":"Name","Value":"StatusCaminho"},{"Key":"Text","Value":""}],"DropDownItems":[]}]}],"Code":"Imports System\r\nImports System.Collections.Generic\r\nImports System.Diagnostics\r\nImports System.Drawing\r\nImports System.Drawing.Drawing2D\r\nImports System.IO\r\nImports System.Linq\r\nImports System.Windows.Forms\r\n\r\nPartial Public Class Form1\r\n    Private ReadOnly voltar As New Stack(Of String)()\r\n    Private ReadOnly avancar As New Stack(Of String)()\r\n    Private ReadOnly icones As New ImageList()\r\n    Private pastaAtual As String = \"\"\r\n    Private atualizandoEndereco As Boolean\r\n\r\n    Private Sub Form1_Load() Handles MyBase.Load\r\n        PrepararInterface()\r\n        CarregarUnidades()\r\n        Navegar(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), False)\r\n    End Sub\r\n\r\n    Private Sub PrepararInterface()\r\n        ListViewArquivos.View = View.Details : ListViewArquivos.FullRowSelect = True : ListViewArquivos.GridLines = True\r\n        ListViewArquivos.Columns.Clear()\r\n        ListViewArquivos.Columns.Add(\"Nome\", 360) : ListViewArquivos.Columns.Add(\"Tipo\", 150) : ListViewArquivos.Columns.Add(\"Tamanho\", 110) : ListViewArquivos.Columns.Add(\"Modificado\", 155)\r\n        icones.ColorDepth = ColorDepth.Depth32Bit : icones.ImageSize = New Size(20, 20)\r\n        icones.Images.Add(\"drive\", SystemIcons.WinLogo.ToBitmap()) : icones.Images.Add(\"folder\", SystemIcons.Application.ToBitmap()) : icones.Images.Add(\"file\", SystemIcons.WinLogo.ToBitmap())\r\n        TreeViewPastas.ImageList = icones : ListViewArquivos.SmallImageList = icones : ListViewArquivos.LargeImageList = icones\r\n        AplicarIcones()\r\n    End Sub\r\n\r\n    Private Function CriarIcone(simbolo As String, fundo As Color) As Bitmap\r\n        Dim imagem As New Bitmap(24, 24)\r\n        Using g As Graphics = Graphics.FromImage(imagem)\r\n            g.SmoothingMode = SmoothingMode.AntiAlias : g.Clear(Color.Transparent)\r\n            Using b As New SolidBrush(fundo) : g.FillEllipse(b, 1, 1, 22, 22) : End Using\r\n            Using f As New Font(\"Segoe UI Symbol\", 10, FontStyle.Bold), b As New SolidBrush(Color.White)\r\n                Dim sf As New StringFormat With {.Alignment = StringAlignment.Center, .LineAlignment = StringAlignment.Center}\r\n                g.DrawString(simbolo, f, b, New RectangleF(0, 0, 24, 24), sf)\r\n            End Using\r\n        End Using\r\n        Return imagem\r\n    End Function\r\n\r\n    Private Sub AplicarIcones()\r\n        Dim botoes As ToolStripButton() = {BtnVoltar, BtnAvancar, BtnSubir, BtnAtualizar, BtnNovaPasta, BtnAbrir, BtnRenomear, BtnExcluir, BtnDetalhes, BtnIcones}\r\n        Dim simbolos As String() = {\"←\", \"→\", \"↑\", \"↻\", \"+\", \"↗\", \"R\", \"×\", \"☷\", \"▦\"}\r\n        Dim cores As Color() = {Color.SteelBlue, Color.SteelBlue, Color.Teal, Color.SeaGreen, Color.DarkCyan, Color.RoyalBlue, Color.DarkOrange, Color.Firebrick, Color.SlateGray, Color.SlateGray}\r\n        For i As Integer = 0 To botoes.Length - 1\r\n            botoes(i).Image = CriarIcone(simbolos(i), cores(i)) : botoes(i).DisplayStyle = ToolStripItemDisplayStyle.Image\r\n        Next\r\n    End Sub\r\n\r\n    Private Sub CarregarUnidades()\r\n        TreeViewPastas.Nodes.Clear()\r\n        For Each unidade As DriveInfo In DriveInfo.GetDrives()\r\n            Dim node As New TreeNode(unidade.Name) With {.Tag = unidade.RootDirectory.FullName, .ImageKey = \"drive\", .SelectedImageKey = \"drive\"}\r\n            node.Nodes.Add(New TreeNode(\"Carregando...\")) : TreeViewPastas.Nodes.Add(node)\r\n        Next\r\n    End Sub\r\n\r\n    Private Sub TreeViewPastas_BeforeExpand(sender As Object, e As TreeViewCancelEventArgs) Handles TreeViewPastas.BeforeExpand\r\n        CarregarFilhos(e.Node)\r\n    End Sub\r\n\r\n    Private Sub CarregarFilhos(node As TreeNode)\r\n        If node.Tag Is Nothing Then Return\r\n        node.Nodes.Clear()\r\n        Try\r\n            For Each diretorio As String In Directory.GetDirectories(CStr(node.Tag)).OrderBy(Function(x) x)\r\n                Dim child As New TreeNode(Path.GetFileName(diretorio)) With {.Tag = diretorio, .ImageKey = \"folder\", .SelectedImageKey = \"folder\"}\r\n                Try\r\n                    If Directory.EnumerateDirectories(diretorio).Any() Then child.Nodes.Add(New TreeNode(\"Carregando...\"))\r\n                Catch\r\n                End Try\r\n                node.Nodes.Add(child)\r\n            Next\r\n        Catch ex As UnauthorizedAccessException\r\n            StatusMensagem.Text = \"Acesso negado: \" & CStr(node.Tag)\r\n        Catch ex As Exception\r\n            StatusMensagem.Text = ex.Message\r\n        End Try\r\n    End Sub\r\n\r\n    Private Sub TreeViewPastas_AfterSelect(sender As Object, e As TreeViewEventArgs) Handles TreeViewPastas.AfterSelect\r\n        If e.Node.Tag IsNot Nothing Then Navegar(CStr(e.Node.Tag), True)\r\n    End Sub\r\n\r\n    Private Sub Navegar(caminho As String, registrar As Boolean)\r\n        If String.IsNullOrWhiteSpace(caminho) OrElse Not Directory.Exists(caminho) Then Return\r\n        If registrar AndAlso pastaAtual <> \"\" AndAlso Not pastaAtual.Equals(caminho, StringComparison.OrdinalIgnoreCase) Then voltar.Push(pastaAtual) : avancar.Clear()\r\n        pastaAtual = caminho\r\n        atualizandoEndereco = True : ComboEndereco.Text = caminho\r\n        If Not ComboEndereco.Items.Contains(caminho) Then ComboEndereco.Items.Insert(0, caminho)\r\n        atualizandoEndereco = False\r\n        CarregarLista()\r\n    End Sub\r\n\r\n    Private Sub CarregarLista()\r\n        ListViewArquivos.BeginUpdate() : ListViewArquivos.Items.Clear()\r\n        Dim filtro As String = CampoFiltro.Text.Trim().ToLowerInvariant()\r\n        Try\r\n            For Each diretorio As String In Directory.GetDirectories(pastaAtual).OrderBy(Function(x) x)\r\n                Dim nome As String = Path.GetFileName(diretorio)\r\n                If filtro <> \"\" AndAlso Not nome.ToLowerInvariant().Contains(filtro) Then Continue For\r\n                Dim info As New DirectoryInfo(diretorio), linha As New ListViewItem(nome, \"folder\") With {.Tag = diretorio}\r\n                linha.SubItems.Add(\"Pasta\") : linha.SubItems.Add(\"\") : linha.SubItems.Add(info.LastWriteTime.ToString(\"dd/MM/yyyy HH:mm\")) : ListViewArquivos.Items.Add(linha)\r\n            Next\r\n            For Each arquivo As String In Directory.GetFiles(pastaAtual).OrderBy(Function(x) x)\r\n                Dim info As New FileInfo(arquivo)\r\n                If filtro <> \"\" AndAlso Not info.Name.ToLowerInvariant().Contains(filtro) Then Continue For\r\n                Dim linha As New ListViewItem(info.Name, \"file\") With {.Tag = arquivo}\r\n                linha.SubItems.Add(If(info.Extension = \"\", \"Arquivo\", info.Extension.ToUpperInvariant().TrimStart(\".\"c) & \" arquivo\"))\r\n                linha.SubItems.Add(FormatarTamanho(info.Length)) : linha.SubItems.Add(info.LastWriteTime.ToString(\"dd/MM/yyyy HH:mm\")) : ListViewArquivos.Items.Add(linha)\r\n            Next\r\n            StatusMensagem.Text = ListViewArquivos.Items.Count & \" itens\"\r\n        Catch ex As UnauthorizedAccessException\r\n            StatusMensagem.Text = \"Acesso negado.\"\r\n        Catch ex As Exception\r\n            StatusMensagem.Text = ex.Message\r\n        Finally\r\n            ListViewArquivos.EndUpdate()\r\n        End Try\r\n        BtnVoltar.Enabled = voltar.Count > 0 : BtnAvancar.Enabled = avancar.Count > 0\r\n        StatusCaminho.Text = pastaAtual\r\n    End Sub\r\n\r\n    Private Function FormatarTamanho(bytes As Long) As String\r\n        Dim valor As Double = bytes, unidades As String() = {\"B\", \"KB\", \"MB\", \"GB\", \"TB\"}, indice As Integer = 0\r\n        While valor >= 1024 AndAlso indice < unidades.Length - 1 : valor /= 1024 : indice += 1 : End While\r\n        Return valor.ToString(If(indice = 0, \"0\", \"0.##\")) & \" \" & unidades(indice)\r\n    End Function\r\n\r\n    Private Sub AbrirSelecionado() Handles BtnAbrir.Click, MenuAbrir.Click, ListViewArquivos.DoubleClick\r\n        If ListViewArquivos.SelectedItems.Count = 0 Then Return\r\n        Dim caminho As String = CStr(ListViewArquivos.SelectedItems(0).Tag)\r\n        If Directory.Exists(caminho) Then\r\n            Navegar(caminho, True)\r\n        Else\r\n            Try : Process.Start(New ProcessStartInfo(caminho) With {.UseShellExecute = True}) : Catch ex As Exception : MessageBox.Show(ex.Message, \"Abrir\", MessageBoxButtons.OK, MessageBoxIcon.Error) : End Try\r\n        End If\r\n    End Sub\r\n\r\n    Private Sub Voltar_Click() Handles BtnVoltar.Click, MenuVoltar.Click\r\n        If voltar.Count = 0 Then Return\r\n        If pastaAtual <> \"\" Then avancar.Push(pastaAtual)\r\n        Navegar(voltar.Pop(), False)\r\n    End Sub\r\n    Private Sub Avancar_Click() Handles BtnAvancar.Click, MenuAvancar.Click\r\n        If avancar.Count = 0 Then Return\r\n        If pastaAtual <> \"\" Then voltar.Push(pastaAtual)\r\n        Navegar(avancar.Pop(), False)\r\n    End Sub\r\n    Private Sub Subir_Click() Handles BtnSubir.Click, MenuSubir.Click\r\n        If pastaAtual = \"\" Then Return\r\n        Dim pai As DirectoryInfo = Directory.GetParent(pastaAtual)\r\n        If pai IsNot Nothing Then Navegar(pai.FullName, True)\r\n    End Sub\r\n    Private Sub Atualizar_Click() Handles BtnAtualizar.Click, MenuAtualizar.Click\r\n        CarregarLista()\r\n    End Sub\r\n    Private Sub ComboEndereco_KeyDown(sender As Object, e As KeyEventArgs) Handles ComboEndereco.KeyDown\r\n        If e.KeyCode = Keys.Enter Then Navegar(ComboEndereco.Text, True) : e.SuppressKeyPress = True\r\n    End Sub\r\n    Private Sub ComboEndereco_SelectedIndexChanged() Handles ComboEndereco.SelectedIndexChanged\r\n        If Not atualizandoEndereco Then Navegar(ComboEndereco.Text, True)\r\n    End Sub\r\n    Private Sub CampoFiltro_TextChanged() Handles CampoFiltro.TextChanged\r\n        If pastaAtual <> \"\" Then CarregarLista()\r\n    End Sub\r\n\r\n    Private Sub NovaPasta_Click() Handles BtnNovaPasta.Click, MenuNovaPasta.Click\r\n        Dim nome As String = Microsoft.VisualBasic.Interaction.InputBox(\"Nome da nova pasta:\", \"Nova pasta\", \"Nova pasta\")\r\n        If nome.Trim() = \"\" Then Return\r\n        Try : Directory.CreateDirectory(Path.Combine(pastaAtual, nome.Trim())) : CarregarLista() : Catch ex As Exception : MessageBox.Show(ex.Message, \"Nova pasta\", MessageBoxButtons.OK, MessageBoxIcon.Error) : End Try\r\n    End Sub\r\n    Private Sub Renomear_Click() Handles BtnRenomear.Click, MenuRenomear.Click\r\n        If ListViewArquivos.SelectedItems.Count = 0 Then Return\r\n        Dim origem As String = CStr(ListViewArquivos.SelectedItems(0).Tag)\r\n        Dim nome As String = Microsoft.VisualBasic.Interaction.InputBox(\"Novo nome:\", \"Renomear\", Path.GetFileName(origem))\r\n        If nome.Trim() = \"\" OrElse nome.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0 Then Return\r\n        Dim destino As String = Path.Combine(Path.GetDirectoryName(origem), nome.Trim())\r\n        Try\r\n            If Directory.Exists(origem) Then Directory.Move(origem, destino) Else File.Move(origem, destino)\r\n            CarregarLista()\r\n        Catch ex As Exception : MessageBox.Show(ex.Message, \"Renomear\", MessageBoxButtons.OK, MessageBoxIcon.Error) : End Try\r\n    End Sub\r\n    Private Sub Excluir_Click() Handles BtnExcluir.Click, MenuExcluir.Click\r\n        If ListViewArquivos.SelectedItems.Count = 0 Then Return\r\n        Dim caminho As String = CStr(ListViewArquivos.SelectedItems(0).Tag)\r\n        If MessageBox.Show(\"Excluir permanentemente '\" & Path.GetFileName(caminho) & \"'?\", \"Excluir\", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) <> DialogResult.Yes Then Return\r\n        Try\r\n            If Directory.Exists(caminho) Then\r\n                Microsoft.VisualBasic.FileIO.FileSystem.DeleteDirectory(caminho, Microsoft.VisualBasic.FileIO.UIOption.OnlyErrorDialogs, Microsoft.VisualBasic.FileIO.RecycleOption.SendToRecycleBin)\r\n            Else\r\n                Microsoft.VisualBasic.FileIO.FileSystem.DeleteFile(caminho, Microsoft.VisualBasic.FileIO.UIOption.OnlyErrorDialogs, Microsoft.VisualBasic.FileIO.RecycleOption.SendToRecycleBin)\r\n            End If\r\n            CarregarLista()\r\n        Catch ex As Exception : MessageBox.Show(ex.Message, \"Excluir\", MessageBoxButtons.OK, MessageBoxIcon.Error) : End Try\r\n    End Sub\r\n\r\n    Private Sub Detalhes_Click() Handles BtnDetalhes.Click, MenuDetalhes.Click\r\n        ListViewArquivos.View = View.Details\r\n    End Sub\r\n    Private Sub Icones_Click() Handles BtnIcones.Click, MenuIcones.Click\r\n        ListViewArquivos.View = View.LargeIcon\r\n    End Sub\r\n    Private Sub Propriedades_Click() Handles MenuPropriedades.Click\r\n        If ListViewArquivos.SelectedItems.Count = 0 Then Return\r\n        Dim caminho As String = CStr(ListViewArquivos.SelectedItems(0).Tag)\r\n        Dim texto As String\r\n        If Directory.Exists(caminho) Then\r\n            Dim info As New DirectoryInfo(caminho) : texto = \"Pasta: \" & info.FullName & Environment.NewLine & \"Modificada: \" & info.LastWriteTime\r\n        Else\r\n            Dim info As New FileInfo(caminho) : texto = \"Arquivo: \" & info.FullName & Environment.NewLine & \"Tamanho: \" & FormatarTamanho(info.Length) & Environment.NewLine & \"Modificado: \" & info.LastWriteTime\r\n        End If\r\n        MessageBox.Show(texto, \"Propriedades\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n    End Sub\r\n    Private Sub Sobre_Click() Handles MenuSobre.Click\r\n        MessageBox.Show(\"FlowExplorer 1.0\" & Environment.NewLine & \"Exemplo TreeView + ListView + ComboBox do FlowForge.\", \"Sobre\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n    End Sub\r\nEnd Class"}],"ApplicationIcon":"","AssemblyTitle":"FlowExplorer","AssemblyDescription":"Explorador de arquivos criado no FlowForge","AssemblyCompany":"Wtec","AssemblyProduct":"FlowExplorer","AssemblyCopyright":"Copyright © 2026","AssemblyTrademark":"FlowForge","AssemblyVersion":"1.0.1.0","FileVersion":"1.0.1.0"}