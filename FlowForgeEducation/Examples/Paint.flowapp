      ],
      "Code": "Imports System\nImports System.Drawing\nImports System.Drawing.Drawing2D\nImports System.Drawing.Imaging\nImports System.IO\nImports System.Windows.Forms\n\nPublic Partial Class Form1\n\n    ' ============================================================\n    ' Paint - exemplo educacional para FlowForge\n    ' Interface inspirada no Microsoft Paint da era Windows 9x.\n    ' O código é propositalmente comentado para servir de tutorial.\n    ' ============================================================\n\n    Private Enum PaintTool\n        Pencil\n        Brush\n        Eraser\n        Fill\n        Eyedropper\n        Line\n        Rectangle\n        Ellipse\n        TextTool\n        SelectTool\n        FreeSelect\n        RoundedRectangle\n        Polygon\n        Curve\n        Airbrush\n        Magnifier\n    End Enum\n\n    Private currentTool As PaintTool = PaintTool.Pencil\n    Private primaryColor As Color = Color.Black\n    Private secondaryColor As Color = Color.White\n    Private lineWidth As Integer = 2\n    Private drawing As Boolean = False\n    Private startPoint As Point\n    Private lastPoint As Point\n    Private workingBitmap As Bitmap\n    Private previewBitmap As Bitmap\n    Private currentFile As String = \"\"\n    Private dirty As Boolean = False\n\n    ' Estado das ferramentas de seleção.\n    Private selectionRect As Rectangle = Rectangle.Empty\n    Private selectionBitmap As Bitmap = Nothing\n    Private selectionSource As Rectangle = Rectangle.Empty\n    Private selectionFloating As Boolean = False\n    Private selectionDragging As Boolean = False\n    Private selectionDragOffset As Point\n    Private freeSelectionPoints As New System.Collections.Generic.List(Of Point)()\n    Private transparentSelection As Boolean = False\n\n    ' Painel de opções contextual, inspirado no Paint 9x.\n    Private optionsPanel As Panel\n    Private optionLabel As Label\n\n    Private lblTool As ToolStripStatusLabel\n    Private lblPos As ToolStripStatusLabel\n    Private primaryBox As Panel\n    Private secondaryBox As Panel\n    Private toolButtons As New System.Collections.Generic.Dictionary(Of PaintTool, Button)()\n\n    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load\n        Me.Text = \"Paint\"\n        Me.ClientSize = New Size(960, 656)\n        Me.MinimumSize = New Size(720, 500)\n        Me.KeyPreview = True\n\n        BuildMenus()\n        BuildToolbox()\n        BuildToolOptions()\n        BuildPalette()\n        BuildStatusBar()\n\n        ' O PictureBox visual do Designer é colocado dentro da área rolável.\n        If canvas.Parent IsNot canvasHost Then\n            If canvas.Parent IsNot Nothing Then canvas.Parent.Controls.Remove(canvas)\n            canvasHost.Controls.Add(canvas)\n        End If\n\n        CreateNewBitmap(800, 500)\n\n        AddHandler canvas.MouseDown, AddressOf Canvas_MouseDown\n        AddHandler canvas.MouseMove, AddressOf Canvas_MouseMove\n        AddHandler canvas.MouseUp, AddressOf Canvas_MouseUp\n        AddHandler canvas.Paint, AddressOf Canvas_Paint\n        AddHandler Me.FormClosing, AddressOf Form1_FormClosing\n    End Sub\n\n    ' ---------------- MENUS ----------------\n    Private Sub BuildMenus()\n        menu.Items.Clear()\n\n        Dim arquivo As New ToolStripMenuItem(\"&Arquivo\")\n        arquivo.DropDownItems.Add(MakeMenu(\"&Novo\", AddressOf NewImage, Keys.Control Or Keys.N))\n        arquivo.DropDownItems.Add(MakeMenu(\"&Abrir...\", AddressOf OpenImage, Keys.Control Or Keys.O))\n        arquivo.DropDownItems.Add(MakeMenu(\"&Salvar\", AddressOf SaveImage, Keys.Control Or Keys.S))\n        arquivo.DropDownItems.Add(MakeMenu(\"Salvar &como...\", AddressOf SaveImageAs, Keys.None))\n        arquivo.DropDownItems.Add(New ToolStripSeparator())\n        arquivo.DropDownItems.Add(MakeMenu(\"Sai&r\", AddressOf ExitApp, Keys.Alt Or Keys.F4))\n\n        Dim editar As New ToolStripMenuItem(\"&Editar\")\n        editar.DropDownItems.Add(MakeMenu(\"Recor&tar seleção\", AddressOf CutSelection, Keys.Control Or Keys.X))\n        editar.DropDownItems.Add(MakeMenu(\"&Copiar seleção\", AddressOf CopySelection, Keys.Control Or Keys.C))\n        editar.DropDownItems.Add(MakeMenu(\"Co&lar\", AddressOf PasteSelection, Keys.Control Or Keys.V))\n        editar.DropDownItems.Add(New ToolStripSeparator())\n        editar.DropDownItems.Add(MakeMenu(\"&Limpar imagem\", AddressOf ClearImage, Keys.Delete))\n        editar.DropDownItems.Add(MakeMenu(\"&Inverter cores\", AddressOf InvertColors, Keys.Control Or Keys.I))\n\n        Dim imagem As New ToolStripMenuItem(\"&Imagem\")\n        imagem.DropDownItems.Add(MakeMenu(\"&Redimensionar...\", AddressOf ResizeImage, Keys.Control Or Keys.R))\n        imagem.DropDownItems.Add(MakeMenu(\"Virar &horizontalmente\", AddressOf FlipHorizontal, Keys.None))\n        imagem.DropDownItems.Add(MakeMenu(\"Virar &verticalmente\", AddressOf FlipVertical, Keys.None))\n\n        Dim ajuda As New ToolStripMenuItem(\"A&juda\")\n        ajuda.DropDownItems.Add(MakeMenu(\"&Sobre o Paint\", AddressOf ShowAbout, Keys.None))\n\n        menu.Items.Add(arquivo)\n        menu.Items.Add(editar)\n        menu.Items.Add(imagem)\n        menu.Items.Add(ajuda)\n    End Sub\n\n    Private Function MakeMenu(text As String, handler As EventHandler, shortcut As Keys) As ToolStripMenuItem\n        Dim item As New ToolStripMenuItem(text)\n        AddHandler item.Click, handler\n        If shortcut <> Keys.None Then item.ShortcutKeys = shortcut\n        Return item\n    End Function\n\n    ' ---------------- CAIXA DE FERRAMENTAS ----------------\n    Private Sub BuildToolbox()\n        toolPanel.Controls.Clear()\n\n        ' Duas colunas de botões quadrados, como no Paint clássico.\n        Dim tools() As PaintTool = {\n            PaintTool.Pencil, PaintTool.Brush,\n            PaintTool.Eraser, PaintTool.Fill,\n            PaintTool.Eyedropper, PaintTool.Line,\n            PaintTool.Rectangle, PaintTool.Ellipse,\n            PaintTool.RoundedRectangle, PaintTool.Polygon,\n            PaintTool.Curve, PaintTool.Airbrush,\n            PaintTool.TextTool, PaintTool.SelectTool,\n            PaintTool.FreeSelect, PaintTool.Magnifier\n        }\n\n        For i As Integer = 0 To tools.Length - 1\n            Dim t As PaintTool = tools(i)\n            Dim b As New Button()\n            b.Size = New Size(32, 32)\n            b.Location = New Point(5 + (i Mod 2) * 34, 6 + (i \\ 2) * 34)\n            b.FlatStyle = FlatStyle.Standard\n            b.Tag = t\n            b.Image = CreateToolIcon(t)\n            b.ImageAlign = ContentAlignment.MiddleCenter\n            b.Text = \"\"\n            b.TabStop = False\n            b.AccessibleName = ToolName(t)\n            Dim tip As New ToolTip()\n            tip.SetToolTip(b, ToolName(t))\n            AddHandler b.Click, AddressOf ToolButton_Click\n            toolPanel.Controls.Add(b)\n            toolButtons(t) = b\n        Next\n\n        UpdateToolButtons()\n    End Sub\n\n    Private Sub BuildToolOptions()\n        optionsPanel = New Panel()\n        optionsPanel.Name = \"toolOptions\"\n        optionsPanel.Location = New Point(5, 326)\n        optionsPanel.Size = New Size(66, 170)\n        optionsPanel.BorderStyle = BorderStyle.Fixed3D\n        toolPanel.Controls.Add(optionsPanel)\n        RefreshToolOptions()\n    End Sub\n\n    Private Sub RefreshToolOptions()\n        If optionsPanel Is Nothing Then Return\n        optionsPanel.Controls.Clear()\n\n        optionLabel = New Label()\n        optionLabel.AutoSize = False\n        optionLabel.Size = New Size(58, 32)\n        optionLabel.Location = New Point(2, 3)\n        optionLabel.TextAlign = ContentAlignment.MiddleCenter\n        optionLabel.Text = ToolName(currentTool)\n        optionsPanel.Controls.Add(optionLabel)\n\n        If currentTool = PaintTool.SelectTool OrElse currentTool = PaintTool.FreeSelect Then\n            Dim opaque As New RadioButton()\n            opaque.Text = \"Opaco\"\n            opaque.Location = New Point(3, 39)\n            opaque.Size = New Size(58, 20)\n            opaque.Checked = Not transparentSelection\n            AddHandler opaque.CheckedChanged,\n                Sub()\n                    If opaque.Checked Then transparentSelection = False\n                End Sub\n            optionsPanel.Controls.Add(opaque)\n\n            Dim trans As New RadioButton()\n            trans.Text = \"Transp.\"\n            trans.Location = New Point(3, 61)\n            trans.Size = New Size(60, 20)\n            trans.Checked = transparentSelection\n            AddHandler trans.CheckedChanged,\n                Sub()\n                    If trans.Checked Then transparentSelection = True\n                End Sub\n            optionsPanel.Controls.Add(trans)\n\n            Dim cutBtn As New Button()\n            cutBtn.Text = \"✂\"\n            cutBtn.Location = New Point(3, 88)\n            cutBtn.Size = New Size(27, 25)\n            cutBtn.Tag = \"Recortar\"\n            AddHandler cutBtn.Click, AddressOf CutSelection\n            optionsPanel.Controls.Add(cutBtn)\n\n            Dim copyBtn As New Button()\n            copyBtn.Text = \"▣\"\n            copyBtn.Location = New Point(32, 88)\n            copyBtn.Size = New Size(27, 25)\n            copyBtn.Tag = \"Copiar\"\n            AddHandler copyBtn.Click, AddressOf CopySelection\n            optionsPanel.Controls.Add(copyBtn)\n        ElseIf currentTool = PaintTool.Magnifier Then\n            For i As Integer = 0 To 2\n                Dim z As New Button()\n                z.Text = If(i = 0, \"1x\", If(i = 1, \"2x\", \"4x\"))\n                z.Tag = If(i = 0, 1, If(i = 1, 2, 4))\n                z.Location = New Point(4, 40 + i * 30)\n                z.Size = New Size(54, 25)\n                AddHandler z.Click, AddressOf ZoomOption_Click\n                optionsPanel.Controls.Add(z)\n            Next\n        Else\n            Dim lab As New Label()\n            lab.Text = \"Traço\"\n            lab.Location = New Point(5, 42)\n            lab.AutoSize = True\n            optionsPanel.Controls.Add(lab)\n\n            Dim widths() As Integer = {1, 2, 3, 5, 8}\n            For i As Integer = 0 To widths.Length - 1\n                Dim b As New Button()\n                b.Text = \"\"\n                b.Tag = widths(i)\n                b.Location = New Point(4, 61 + i * 19)\n                b.Size = New Size(55, 18)\n                AddHandler b.Paint, AddressOf WidthButton_Paint\n                AddHandler b.Click,\n                    Sub(sender As Object, e As EventArgs)\n                        lineWidth = CInt(DirectCast(sender, Button).Tag)\n                        optionsPanel.Invalidate()\n                    End Sub\n                optionsPanel.Controls.Add(b)\n            Next\n        End If\n    End Sub\n\n    Private Sub WidthButton_Paint(sender As Object, e As PaintEventArgs)\n        Dim b As Button = DirectCast(sender, Button)\n        Dim w As Integer = CInt(b.Tag)\n        Using p As New Pen(Color.Black, w)\n            e.Graphics.DrawLine(p, 8, b.Height \\ 2, b.Width - 8, b.Height \\ 2)\n        End Using\n    End Sub\n\n    Private Sub ZoomOption_Click(sender As Object, e As EventArgs)\n        Dim factor As Integer = CInt(DirectCast(sender, Button).Tag)\n        canvas.SizeMode = If(factor = 1, PictureBoxSizeMode.Normal, PictureBoxSizeMode.StretchImage)\n        canvas.Size = New Size(workingBitmap.Width * factor, workingBitmap.Height * factor)\n    End Sub\n\n    Private Sub ToolButton_Click(sender As Object, e As EventArgs)\n        Dim b As Button = TryCast(sender, Button)\n        If b Is Nothing Then Return\n        CommitSelection()\n        currentTool = DirectCast(b.Tag, PaintTool)\n        UpdateToolButtons()\n        RefreshToolOptions()\n        lblTool.Text = ToolName(currentTool)\n    End Sub\n\n    Private Sub UpdateToolButtons()\n        For Each pair As System.Collections.Generic.KeyValuePair(Of PaintTool, Button) In toolButtons\n            pair.Value.BackColor = If(pair.Key = currentTool, SystemColors.Highlight, SystemColors.Control)\n        Next\n    End Sub\n\n    Private Function ToolName(t As PaintTool) As String\n        Select Case t\n            Case PaintTool.Pencil : Return \"Lápis\"\n            Case PaintTool.Brush : Return \"Pincel\"\n            Case PaintTool.Eraser : Return \"Borracha\"\n            Case PaintTool.Fill : Return \"Preencher\"\n            Case PaintTool.Eyedropper : Return \"Conta-gotas\"\n            Case PaintTool.Line : Return \"Linha\"\n            Case PaintTool.Rectangle : Return \"Retângulo\"\n            Case PaintTool.Ellipse : Return \"Elipse\"\n            Case PaintTool.TextTool : Return \"Texto\"\n            Case PaintTool.SelectTool : Return \"Seleção retangular\"\n            Case PaintTool.FreeSelect : Return \"Seleção livre\"\n            Case PaintTool.RoundedRectangle : Return \"Retângulo arredondado\"\n            Case PaintTool.Polygon : Return \"Polígono\"\n            Case PaintTool.Curve : Return \"Curva\"\n            Case PaintTool.Airbrush : Return \"Spray\"\n            Case PaintTool.Magnifier : Return \"Lupa\"\n            Case Else : Return \"Ferramenta\"\n        End Select\n    End Function\n\n    ' Gera ícones 16x16/24x24 em GDI+, sem arquivos externos.\n    Private Function CreateToolIcon(t As PaintTool) As Bitmap\n        Dim bmp As New Bitmap(24, 24)\n        Using g As Graphics = Graphics.FromImage(bmp)\n            g.Clear(Color.Transparent)\n            g.SmoothingMode = SmoothingMode.None\n            Using p As New Pen(Color.Black, 2)\n                Select Case t\n                    Case PaintTool.Pencil\n                        g.DrawLine(p, 5, 18, 18, 5)\n                        g.DrawLine(Pens.Goldenrod, 7, 19, 19, 7)\n                    Case PaintTool.Brush\n                        g.DrawLine(New Pen(Color.SaddleBrown, 3), 7, 18, 16, 7)\n                        g.FillEllipse(Brushes.Black, 4, 16, 7, 5)\n                    Case PaintTool.Eraser\n                        g.FillRectangle(Brushes.LightPink, 5, 8, 14, 10)\n                        g.DrawRectangle(Pens.Black, 5, 8, 14, 10)\n                    Case PaintTool.Fill\n                        g.DrawRectangle(p, 6, 6, 10, 10)\n                        g.FillPolygon(Brushes.DodgerBlue, New Point() {New Point(9,15), New Point(19,15), New Point(14,21)})\n                    Case PaintTool.Eyedropper\n                        g.DrawLine(p, 7, 18, 17, 8)\n                        g.DrawEllipse(Pens.Black, 15, 5, 5, 5)\n                    Case PaintTool.Line\n                        g.DrawLine(p, 4, 19, 20, 4)\n                    Case PaintTool.Rectangle\n                        g.DrawRectangle(p, 4, 5, 16, 14)\n                    Case PaintTool.Ellipse\n                        g.DrawEllipse(p, 4, 5, 16, 14)\n                    Case PaintTool.TextTool\n                        Using ff As New Font(\"Times New Roman\", 15, FontStyle.Bold)\n                            g.DrawString(\"A\", ff, Brushes.Black, 3, 1)\n                        End Using\n                    Case PaintTool.RoundedRectangle\n                        g.DrawArc(p, 4, 5, 6, 6, 180, 90)\n                        g.DrawArc(p, 14, 5, 6, 6, 270, 90)\n                        g.DrawArc(p, 14, 13, 6, 6, 0, 90)\n                        g.DrawArc(p, 4, 13, 6, 6, 90, 90)\n                        g.DrawLine(p, 7, 5, 17, 5)\n                        g.DrawLine(p, 7, 19, 17, 19)\n                        g.DrawLine(p, 4, 8, 4, 16)\n                        g.DrawLine(p, 20, 8, 20, 16)\n                    Case PaintTool.Polygon\n                        g.DrawPolygon(p, New Point() {New Point(5,18), New Point(8,6), New Point(18,4), New Point(20,15), New Point(12,20)})\n                    Case PaintTool.Curve\n                        g.DrawBezier(p, New Point(3,18), New Point(8,2), New Point(15,22), New Point(21,5))\n                    Case PaintTool.Airbrush\n                        g.FillEllipse(Brushes.Black, 11, 10, 3, 3)\n                        g.FillRectangle(Brushes.Black, 6, 7, 2, 2)\n                        g.FillRectangle(Brushes.Black, 16, 5, 2, 2)\n                        g.FillRectangle(Brushes.Black, 18, 14, 2, 2)\n                        g.FillRectangle(Brushes.Black, 8, 17, 2, 2)\n                        g.FillRectangle(Brushes.Black, 13, 19, 1, 1)\n                    Case PaintTool.Magnifier\n                        g.DrawEllipse(p, 4, 3, 12, 12)\n                        g.DrawLine(p, 14, 14, 21, 21)\n                    Case PaintTool.FreeSelect\n                        g.DrawLines(Pens.Black, New Point() {New Point(5,6), New Point(14,4), New Point(20,9), New Point(17,17), New Point(9,20), New Point(4,14), New Point(5,6)})\n                    Case PaintTool.SelectTool\n                        g.DrawRectangle(Pens.Black, 4, 5, 16, 14)\n                        For x As Integer = 5 To 19 Step 4\n                            g.FillRectangle(Brushes.White, x, 5, 2, 1)\n                            g.FillRectangle(Brushes.White, x, 18, 2, 1)\n                        Next\n                End Select\n            End Using\n        End Using\n        Return bmp\n    End Function\n\n    ' ---------------- PALETA WINDOWS 9x ----------------\n    Private Sub BuildPalette()\n        palettePanel.Controls.Clear()\n\n        primaryBox = New Panel()\n        primaryBox.Location = New Point(8, 8)\n        primaryBox.Size = New Size(28, 28)\n        primaryBox.BackColor = primaryColor\n        primaryBox.BorderStyle = BorderStyle.FixedSingle\n        palettePanel.Controls.Add(primaryBox)\n\n        secondaryBox = New Panel()\n        secondaryBox.Location = New Point(28, 25)\n        secondaryBox.Size = New Size(28, 28)\n        secondaryBox.BackColor = secondaryColor\n        secondaryBox.BorderStyle = BorderStyle.FixedSingle\n        palettePanel.Controls.Add(secondaryBox)\n        primaryBox.BringToFront()\n\n        Dim colors() As Color = {\n            Color.Black, Color.Gray, Color.Maroon, Color.Olive, Color.Green, Color.Teal, Color.Navy, Color.Purple,\n            Color.White, Color.Silver, Color.Red, Color.Yellow, Color.Lime, Color.Cyan, Color.Blue, Color.Magenta,\n            Color.FromArgb(128,64,0), Color.FromArgb(255,128,64), Color.FromArgb(128,128,64), Color.FromArgb(0,128,64),\n            Color.FromArgb(0,128,128), Color.FromArgb(0,64,128), Color.FromArgb(128,0,64), Color.FromArgb(255,128,192)\n        }\n\n        For i As Integer = 0 To colors.Length - 1\n            Dim swatch As New Panel()\n            swatch.Size = New Size(22, 22)\n            swatch.Location = New Point(70 + (i Mod 12) * 24, 5 + (i \\ 12) * 24)\n            swatch.BackColor = colors(i)\n            swatch.BorderStyle = BorderStyle.FixedSingle\n            swatch.Tag = colors(i)\n            AddHandler swatch.MouseDown, AddressOf Color_MouseDown\n            palettePanel.Controls.Add(swatch)\n        Next\n\n        Dim more As New Button()\n        more.Text = \"Cores...\"\n        more.Location = New Point(365, 15)\n        more.Size = New Size(68, 28)\n        AddHandler more.Click, AddressOf MoreColors\n        palettePanel.Controls.Add(more)\n    End Sub\n\n    Private Sub Color_MouseDown(sender As Object, e As MouseEventArgs)\n        Dim swatch As Panel = TryCast(sender, Panel)\n        If swatch Is Nothing Then Return\n        Dim c As Color = DirectCast(swatch.Tag, Color)\n        If e.Button = MouseButtons.Right Then\n            secondaryColor = c\n            secondaryBox.BackColor = c\n        Else\n            primaryColor = c\n            primaryBox.BackColor = c\n        End If\n    End Sub\n\n    Private Sub MoreColors(sender As Object, e As EventArgs)\n        Using dlg As New ColorDialog()\n            dlg.Color = primaryColor\n            dlg.FullOpen = True\n            If dlg.ShowDialog() = DialogResult.OK Then\n                primaryColor = dlg.Color\n                primaryBox.BackColor = primaryColor\n            End If\n        End Using\n    End Sub\n\n    ' ---------------- STATUS ----------------\n    Private Sub BuildStatusBar()\n        status.Items.Clear()\n        lblTool = New ToolStripStatusLabel(\"Lápis\")\n        lblTool.Width = 120\n        lblPos = New ToolStripStatusLabel(\"0, 0\")\n        lblPos.Spring = True\n        lblPos.TextAlign = ContentAlignment.MiddleRight\n        status.Items.Add(lblTool)\n        status.Items.Add(lblPos)\n    End Sub\n\n    ' ---------------- CANVAS / DESENHO ----------------\n    Private Sub CreateNewBitmap(w As Integer, h As Integer)\n        If selectionBitmap IsNot Nothing Then selectionBitmap.Dispose()\n        selectionBitmap = Nothing\n        selectionFloating = False\n        selectionRect = Rectangle.Empty\n        freeSelectionPoints.Clear()\n        If workingBitmap IsNot Nothing Then workingBitmap.Dispose()\n        workingBitmap = New Bitmap(Math.Max(1, w), Math.Max(1, h), PixelFormat.Format32bppArgb)\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            g.Clear(Color.White)\n        End Using\n        canvas.Size = workingBitmap.Size\n        canvas.Image = workingBitmap\n        currentFile = \"\"\n        dirty = False\n        UpdateTitle()\n    End Sub\n\n    Private Sub Canvas_MouseDown(sender As Object, e As MouseEventArgs)\n        If workingBitmap Is Nothing Then Return\n        If e.X < 0 OrElse e.Y < 0 OrElse e.X >= workingBitmap.Width OrElse e.Y >= workingBitmap.Height Then Return\n\n        Dim drawColor As Color = If(e.Button = MouseButtons.Right, secondaryColor, primaryColor)\n\n        If currentTool = PaintTool.SelectTool Then\n            If selectionFloating AndAlso selectionRect.Contains(e.Location) Then\n                selectionDragging = True\n                selectionDragOffset = New Point(e.X - selectionRect.X, e.Y - selectionRect.Y)\n                Return\n            End If\n            CommitSelection()\n            drawing = True\n            startPoint = e.Location\n            lastPoint = e.Location\n            selectionRect = Rectangle.Empty\n            Return\n        End If\n\n        If currentTool = PaintTool.FreeSelect Then\n            CommitSelection()\n            drawing = True\n            freeSelectionPoints.Clear()\n            freeSelectionPoints.Add(e.Location)\n            startPoint = e.Location\n            lastPoint = e.Location\n            Return\n        End If\n\n        If currentTool = PaintTool.Fill Then\n            FloodFill(e.Location, workingBitmap.GetPixel(e.X, e.Y), drawColor)\n            dirty = True\n            canvas.Invalidate()\n            UpdateTitle()\n            Return\n        End If\n\n        If currentTool = PaintTool.Eyedropper Then\n            primaryColor = workingBitmap.GetPixel(e.X, e.Y)\n            primaryBox.BackColor = primaryColor\n            Return\n        End If\n\n        If currentTool = PaintTool.TextTool Then\n            AddTextAt(e.Location, drawColor)\n            Return\n        End If\n\n        If currentTool = PaintTool.Magnifier Then\n            If canvas.Width = workingBitmap.Width Then\n                canvas.Size = New Size(workingBitmap.Width * 2, workingBitmap.Height * 2)\n                canvas.SizeMode = PictureBoxSizeMode.StretchImage\n            Else\n                canvas.Size = workingBitmap.Size\n                canvas.SizeMode = PictureBoxSizeMode.Normal\n            End If\n            Return\n        End If\n\n        drawing = True\n        startPoint = e.Location\n        lastPoint = e.Location\n\n        If currentTool = PaintTool.Line OrElse currentTool = PaintTool.Rectangle OrElse currentTool = PaintTool.Ellipse OrElse currentTool = PaintTool.RoundedRectangle OrElse currentTool = PaintTool.Polygon Then\n            previewBitmap = DirectCast(workingBitmap.Clone(), Bitmap)\n        End If\n    End Sub\n\n    Private Sub Canvas_MouseMove(sender As Object, e As MouseEventArgs)\n        lblPos.Text = e.X.ToString() & \", \" & e.Y.ToString()\n        If Not drawing OrElse workingBitmap Is Nothing Then Return\n\n        Dim drawColor As Color = If((Control.MouseButtons And MouseButtons.Right) = MouseButtons.Right, secondaryColor, primaryColor)\n\n        If currentTool = PaintTool.SelectTool Then\n            If selectionDragging Then\n                selectionRect.Location = New Point(e.X - selectionDragOffset.X, e.Y - selectionDragOffset.Y)\n                canvas.Invalidate()\n            Else\n                lastPoint = e.Location\n                selectionRect = NormalizeRect(startPoint, lastPoint)\n                canvas.Invalidate()\n            End If\n            Return\n        End If\n\n        If currentTool = PaintTool.FreeSelect Then\n            freeSelectionPoints.Add(e.Location)\n            lastPoint = e.Location\n            canvas.Invalidate()\n            Return\n        End If\n\n        If currentTool = PaintTool.Airbrush Then\n            Using g As Graphics = Graphics.FromImage(workingBitmap)\n                Dim rnd As New Random()\n                Using b As New SolidBrush(drawColor)\n                    For i As Integer = 1 To 20\n                        Dim dx As Integer = rnd.Next(-8, 9)\n                        Dim dy As Integer = rnd.Next(-8, 9)\n                        If dx * dx + dy * dy <= 64 Then g.FillRectangle(b, e.X + dx, e.Y + dy, 1, 1)\n                    Next\n                End Using\n            End Using\n            dirty = True\n            canvas.Invalidate()\n        ElseIf currentTool = PaintTool.Pencil OrElse currentTool = PaintTool.Brush OrElse currentTool = PaintTool.Eraser OrElse currentTool = PaintTool.Curve Then\n            Using g As Graphics = Graphics.FromImage(workingBitmap)\n                g.SmoothingMode = If(currentTool = PaintTool.Pencil, SmoothingMode.None, SmoothingMode.AntiAlias)\n                Dim c As Color = If(currentTool = PaintTool.Eraser, secondaryColor, drawColor)\n                Dim w As Integer = If(currentTool = PaintTool.Eraser, Math.Max(8, lineWidth * 3), lineWidth)\n                Using p As New Pen(c, w)\n                    p.StartCap = LineCap.Round\n                    p.EndCap = LineCap.Round\n                    g.DrawLine(p, lastPoint, e.Location)\n                End Using\n            End Using\n            lastPoint = e.Location\n            dirty = True\n            canvas.Invalidate()\n        Else\n            lastPoint = e.Location\n            canvas.Invalidate()\n        End If\n    End Sub\n\n    Private Sub Canvas_MouseUp(sender As Object, e As MouseEventArgs)\n        If selectionDragging Then\n            selectionDragging = False\n            dirty = True\n            UpdateTitle()\n            Return\n        End If\n\n        If Not drawing Then Return\n        drawing = False\n\n        If currentTool = PaintTool.SelectTool Then\n            selectionRect = NormalizeRect(startPoint, e.Location)\n            CreateRectangularSelection()\n            canvas.Invalidate()\n            Return\n        End If\n\n        If currentTool = PaintTool.FreeSelect Then\n            freeSelectionPoints.Add(e.Location)\n            CreateFreeSelection()\n            canvas.Invalidate()\n            Return\n        End If\n\n        If currentTool = PaintTool.Line OrElse currentTool = PaintTool.Rectangle OrElse currentTool = PaintTool.Ellipse OrElse currentTool = PaintTool.RoundedRectangle OrElse currentTool = PaintTool.Polygon Then\n            Dim drawColor As Color = If(e.Button = MouseButtons.Right, secondaryColor, primaryColor)\n            Using g As Graphics = Graphics.FromImage(workingBitmap)\n                Using p As New Pen(drawColor, lineWidth)\n                    If currentTool = PaintTool.Line Then\n                        g.DrawLine(p, startPoint, e.Location)\n                    Else\n                        Dim r As Rectangle = NormalizeRect(startPoint, e.Location)\n                        If currentTool = PaintTool.Rectangle Then g.DrawRectangle(p, r)\n                        If currentTool = PaintTool.Ellipse Then g.DrawEllipse(p, r)\n                        If currentTool = PaintTool.RoundedRectangle Then DrawRoundedRectangle(g, p, r)\n                        If currentTool = PaintTool.Polygon Then\n                            g.DrawPolygon(p, New Point() {New Point(r.Left, r.Bottom), New Point(r.Left + r.Width \\ 3, r.Top), New Point(r.Right, r.Top + r.Height \\ 3), New Point(r.Right - r.Width \\ 4, r.Bottom)})\n                        End If\n                    End If\n                End Using\n            End Using\n            If previewBitmap IsNot Nothing Then previewBitmap.Dispose()\n            previewBitmap = Nothing\n            dirty = True\n            UpdateTitle()\n            canvas.Invalidate()\n        End If\n    End Sub\n\n    Private Sub Canvas_Paint(sender As Object, e As PaintEventArgs)\n        If selectionFloating AndAlso selectionBitmap IsNot Nothing Then\n            If transparentSelection Then\n                Dim attrs As New ImageAttributes()\n                attrs.SetColorKey(secondaryColor, secondaryColor)\n                e.Graphics.DrawImage(selectionBitmap, selectionRect, 0, 0, selectionBitmap.Width, selectionBitmap.Height, GraphicsUnit.Pixel, attrs)\n                attrs.Dispose()\n            Else\n                e.Graphics.DrawImage(selectionBitmap, selectionRect)\n            End If\n            DrawSelectionFrame(e.Graphics, selectionRect)\n        ElseIf drawing AndAlso currentTool = PaintTool.SelectTool AndAlso Not selectionRect.IsEmpty Then\n            DrawSelectionFrame(e.Graphics, selectionRect)\n        ElseIf drawing AndAlso currentTool = PaintTool.FreeSelect AndAlso freeSelectionPoints.Count > 1 Then\n            Using p As New Pen(Color.Black, 1)\n                p.DashStyle = DashStyle.Dot\n                e.Graphics.DrawLines(p, freeSelectionPoints.ToArray())\n            End Using\n        End If\n\n        If Not drawing OrElse previewBitmap Is Nothing Then Return\n        If currentTool <> PaintTool.Line AndAlso currentTool <> PaintTool.Rectangle AndAlso currentTool <> PaintTool.Ellipse AndAlso currentTool <> PaintTool.RoundedRectangle AndAlso currentTool <> PaintTool.Polygon Then Return\n\n        e.Graphics.DrawImageUnscaled(previewBitmap, 0, 0)\n        Using p As New Pen(primaryColor, lineWidth)\n            If currentTool = PaintTool.Line Then\n                e.Graphics.DrawLine(p, startPoint, lastPoint)\n            Else\n                Dim r As Rectangle = NormalizeRect(startPoint, lastPoint)\n                If currentTool = PaintTool.Rectangle Then e.Graphics.DrawRectangle(p, r)\n                If currentTool = PaintTool.Ellipse Then e.Graphics.DrawEllipse(p, r)\n            End If\n        End Using\n    End Sub\n\n    Private Sub DrawRoundedRectangle(g As Graphics, p As Pen, r As Rectangle)\n        Dim radius As Integer = Math.Max(4, Math.Min(16, Math.Min(r.Width, r.Height) \\ 4))\n        Dim d As Integer = radius * 2\n        If r.Width <= d OrElse r.Height <= d Then\n            g.DrawRectangle(p, r)\n            Return\n        End If\n        g.DrawArc(p, r.Left, r.Top, d, d, 180, 90)\n        g.DrawArc(p, r.Right - d, r.Top, d, d, 270, 90)\n        g.DrawArc(p, r.Right - d, r.Bottom - d, d, d, 0, 90)\n        g.DrawArc(p, r.Left, r.Bottom - d, d, d, 90, 90)\n        g.DrawLine(p, r.Left + radius, r.Top, r.Right - radius, r.Top)\n        g.DrawLine(p, r.Left + radius, r.Bottom, r.Right - radius, r.Bottom)\n        g.DrawLine(p, r.Left, r.Top + radius, r.Left, r.Bottom - radius)\n        g.DrawLine(p, r.Right, r.Top + radius, r.Right, r.Bottom - radius)\n    End Sub\n\n    Private Sub CreateRectangularSelection()\n        If selectionRect.Width < 2 OrElse selectionRect.Height < 2 Then\n            selectionRect = Rectangle.Empty\n            Return\n        End If\n        selectionRect.Intersect(New Rectangle(0, 0, workingBitmap.Width, workingBitmap.Height))\n        If selectionRect.Width < 1 OrElse selectionRect.Height < 1 Then Return\n\n        selectionBitmap = workingBitmap.Clone(selectionRect, PixelFormat.Format32bppArgb)\n        selectionSource = selectionRect\n\n        ' O fundo deixado pela seleção usa a cor secundária, como no Paint clássico.\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            Using b As New SolidBrush(secondaryColor)\n                g.FillRectangle(b, selectionRect)\n            End Using\n        End Using\n        selectionFloating = True\n        dirty = True\n        UpdateTitle()\n    End Sub\n\n    Private Sub CreateFreeSelection()\n        If freeSelectionPoints.Count < 3 Then Return\n        Dim minX As Integer = freeSelectionPoints(0).X\n        Dim minY As Integer = freeSelectionPoints(0).Y\n        Dim maxX As Integer = minX\n        Dim maxY As Integer = minY\n        For Each pt As Point In freeSelectionPoints\n            minX = Math.Min(minX, pt.X) : minY = Math.Min(minY, pt.Y)\n            maxX = Math.Max(maxX, pt.X) : maxY = Math.Max(maxY, pt.Y)\n        Next\n        selectionRect = Rectangle.FromLTRB(minX, minY, maxX + 1, maxY + 1)\n        selectionRect.Intersect(New Rectangle(0, 0, workingBitmap.Width, workingBitmap.Height))\n        If selectionRect.Width < 1 OrElse selectionRect.Height < 1 Then Return\n\n        selectionBitmap = New Bitmap(selectionRect.Width, selectionRect.Height, PixelFormat.Format32bppArgb)\n        Using g As Graphics = Graphics.FromImage(selectionBitmap)\n            g.Clear(Color.Transparent)\n            Dim local() As Point = freeSelectionPoints.ToArray()\n            For i As Integer = 0 To local.Length - 1\n                local(i) = New Point(local(i).X - selectionRect.X, local(i).Y - selectionRect.Y)\n            Next\n            Using gp As New GraphicsPath()\n                gp.AddPolygon(local)\n                g.SetClip(gp)\n                g.DrawImage(workingBitmap, New Rectangle(0, 0, selectionRect.Width, selectionRect.Height), selectionRect, GraphicsUnit.Pixel)\n            End Using\n        End Using\n\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            Dim absolute() As Point = freeSelectionPoints.ToArray()\n            Using gp As New GraphicsPath()\n                gp.AddPolygon(absolute)\n                g.SetClip(gp)\n                g.Clear(secondaryColor)\n            End Using\n        End Using\n\n        selectionSource = selectionRect\n        selectionFloating = True\n        dirty = True\n        UpdateTitle()\n    End Sub\n\n    Private Sub DrawSelectionFrame(g As Graphics, r As Rectangle)\n        If r.Width < 1 OrElse r.Height < 1 Then Return\n        Using p As New Pen(Color.Black, 1)\n            p.DashStyle = DashStyle.Dot\n            g.DrawRectangle(p, r)\n        End Using\n        Dim resizePoints() As Point = {\n            New Point(r.Left, r.Top), New Point(r.Right, r.Top),\n            New Point(r.Left, r.Bottom), New Point(r.Right, r.Bottom)\n        }\n        For Each pt As Point In resizePoints\n            g.FillRectangle(Brushes.White, pt.X - 2, pt.Y - 2, 5, 5)\n            g.DrawRectangle(Pens.Black, pt.X - 2, pt.Y - 2, 5, 5)\n        Next\n    End Sub\n\n    Private Sub CommitSelection()\n        If Not selectionFloating OrElse selectionBitmap Is Nothing Then Return\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            If transparentSelection Then\n                Dim attrs As New ImageAttributes()\n                attrs.SetColorKey(secondaryColor, secondaryColor)\n                g.DrawImage(selectionBitmap, selectionRect, 0, 0, selectionBitmap.Width, selectionBitmap.Height, GraphicsUnit.Pixel, attrs)\n                attrs.Dispose()\n            Else\n                g.DrawImage(selectionBitmap, selectionRect)\n            End If\n        End Using\n        selectionBitmap.Dispose()\n        selectionBitmap = Nothing\n        selectionFloating = False\n        selectionRect = Rectangle.Empty\n        freeSelectionPoints.Clear()\n        dirty = True\n        canvas.Invalidate()\n        UpdateTitle()\n    End Sub\n\n    Private Sub CopySelection(sender As Object, e As EventArgs)\n        If selectionBitmap Is Nothing Then Return\n        Clipboard.SetImage(DirectCast(selectionBitmap.Clone(), Bitmap))\n    End Sub\n\n    Private Sub CutSelection(sender As Object, e As EventArgs)\n        If selectionBitmap Is Nothing Then Return\n        Clipboard.SetImage(DirectCast(selectionBitmap.Clone(), Bitmap))\n        selectionBitmap.Dispose()\n        selectionBitmap = Nothing\n        selectionFloating = False\n        selectionRect = Rectangle.Empty\n        dirty = True\n        canvas.Invalidate()\n        UpdateTitle()\n    End Sub\n\n    Private Function NormalizeRect(a As Point, b As Point) As Rectangle\n        Return Rectangle.FromLTRB(Math.Min(a.X,b.X), Math.Min(a.Y,b.Y), Math.Max(a.X,b.X), Math.Max(a.Y,b.Y))\n    End Function\n\n    Private Sub FloodFill(pt As Point, oldColor As Color, newColor As Color)\n        If oldColor.ToArgb() = newColor.ToArgb() Then Return\n        Dim q As New System.Collections.Generic.Queue(Of Point)()\n        q.Enqueue(pt)\n        While q.Count > 0\n            Dim p As Point = q.Dequeue()\n            If p.X < 0 OrElse p.Y < 0 OrElse p.X >= workingBitmap.Width OrElse p.Y >= workingBitmap.Height Then Continue While\n            If workingBitmap.GetPixel(p.X,p.Y).ToArgb() <> oldColor.ToArgb() Then Continue While\n            workingBitmap.SetPixel(p.X,p.Y,newColor)\n            q.Enqueue(New Point(p.X+1,p.Y))\n            q.Enqueue(New Point(p.X-1,p.Y))\n            q.Enqueue(New Point(p.X,p.Y+1))\n            q.Enqueue(New Point(p.X,p.Y-1))\n        End While\n    End Sub\n\n    Private Sub AddTextAt(pt As Point, c As Color)\n        Dim text As String = Microsoft.VisualBasic.Interaction.InputBox(\"Digite o texto:\", \"Texto\")\n        If text = \"\" Then Return\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            Using ff As New Font(\"Arial\", 14.0F)\n                g.DrawString(text, ff, New SolidBrush(c), pt)\n            End Using\n        End Using\n        dirty = True\n        canvas.Invalidate()\n        UpdateTitle()\n    End Sub\n\n    ' ---------------- ARQUIVOS ----------------\n    Private Sub NewImage(sender As Object, e As EventArgs)\n        If Not ConfirmDiscard() Then Return\n        CreateNewBitmap(800,500)\n    End Sub\n\n    Private Sub OpenImage(sender As Object, e As EventArgs)\n        If Not ConfirmDiscard() Then Return\n        Using dlg As New OpenFileDialog()\n            dlg.Filter = \"Imagens|*.bmp;*.png;*.jpg;*.jpeg;*.gif|Bitmap (*.bmp)|*.bmp|PNG (*.png)|*.png|JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|GIF (*.gif)|*.gif\"\n            If dlg.ShowDialog() <> DialogResult.OK Then Return\n            Using loaded As Image = Image.FromFile(dlg.FileName)\n                If workingBitmap IsNot Nothing Then workingBitmap.Dispose()\n                workingBitmap = New Bitmap(loaded)\n            End Using\n            canvas.Size = workingBitmap.Size\n            canvas.Image = workingBitmap\n            currentFile = dlg.FileName\n            dirty = False\n            UpdateTitle()\n        End Using\n    End Sub\n\n    Private Sub SaveImage(sender As Object, e As EventArgs)\n        If currentFile = \"\" Then\n            SaveImageAs(sender,e)\n            Return\n        End If\n        SaveBitmap(currentFile)\n    End Sub\n\n    Private Sub SaveImageAs(sender As Object, e As EventArgs)\n        Using dlg As New SaveFileDialog()\n            dlg.Filter = \"Bitmap (*.bmp)|*.bmp|PNG (*.png)|*.png|JPEG (*.jpg)|*.jpg|GIF (*.gif)|*.gif\"\n            dlg.DefaultExt = \"bmp\"\n            If dlg.ShowDialog() <> DialogResult.OK Then Return\n            currentFile = dlg.FileName\n            SaveBitmap(currentFile)\n        End Using\n    End Sub\n\n    Private Sub SaveBitmap(path As String)\n        CommitSelection()\n        Dim ext As String = System.IO.Path.GetExtension(path).ToLowerInvariant()\n        If ext = \".png\" Then\n            workingBitmap.Save(path, ImageFormat.Png)\n        ElseIf ext = \".jpg\" OrElse ext = \".jpeg\" Then\n            workingBitmap.Save(path, ImageFormat.Jpeg)\n        ElseIf ext = \".gif\" Then\n            workingBitmap.Save(path, ImageFormat.Gif)\n        Else\n            workingBitmap.Save(path, ImageFormat.Bmp)\n        End If\n        dirty = False\n        UpdateTitle()\n    End Sub\n\n    ' ---------------- EDIÇÃO / IMAGEM ----------------\n    Private Sub PasteSelection(sender As Object, e As EventArgs)\n        If Not Clipboard.ContainsImage() Then Return\n        CommitSelection()\n        Dim img As Image = Clipboard.GetImage()\n        If img Is Nothing Then Return\n        selectionBitmap = New Bitmap(img)\n        selectionRect = New Rectangle(0, 0, selectionBitmap.Width, selectionBitmap.Height)\n        selectionFloating = True\n        currentTool = PaintTool.SelectTool\n        UpdateToolButtons()\n        RefreshToolOptions()\n        canvas.Invalidate()\n    End Sub\n\n    Private Sub ClearImage(sender As Object, e As EventArgs)\n        Using g As Graphics = Graphics.FromImage(workingBitmap)\n            g.Clear(secondaryColor)\n        End Using\n        dirty = True\n        canvas.Invalidate()\n        UpdateTitle()\n    End Sub\n\n    Private Sub InvertColors(sender As Object, e As EventArgs)\n        For y As Integer = 0 To workingBitmap.Height - 1\n            For x As Integer = 0 To workingBitmap.Width - 1\n                Dim c As Color = workingBitmap.GetPixel(x,y)\n                workingBitmap.SetPixel(x,y,Color.FromArgb(c.A,255-c.R,255-c.G,255-c.B))\n            Next\n        Next\n        dirty = True\n        canvas.Invalidate()\n        UpdateTitle()\n    End Sub\n\n    Private Sub ResizeImage(sender As Object, e As EventArgs)\n        Dim value As String = Microsoft.VisualBasic.Interaction.InputBox(\"Novo tamanho (largura x altura):\", \"Redimensionar\", workingBitmap.Width.ToString() & \"x\" & workingBitmap.Height.ToString())\n        Dim parts() As String = value.ToLowerInvariant().Split(\"x\"c)\n        If parts.Length <> 2 Then Return\n        Dim w As Integer, h As Integer\n        If Not Integer.TryParse(parts(0).Trim(),w) OrElse Not Integer.TryParse(parts(1).Trim(),h) Then Return\n        If w < 1 OrElse h < 1 Then Return\n        Dim nb As New Bitmap(w,h)\n        Using g As Graphics = Graphics.FromImage(nb)\n            g.Clear(Color.White)\n            g.DrawImage(workingBitmap, New Rectangle(0,0,w,h))\n        End Using\n        workingBitmap.Dispose()\n        workingBitmap = nb\n        canvas.Image = workingBitmap\n        canvas.Size = workingBitmap.Size\n        dirty = True\n        UpdateTitle()\n    End Sub\n\n    Private Sub FlipHorizontal(sender As Object, e As EventArgs)\n        workingBitmap.RotateFlip(RotateFlipType.RotateNoneFlipX)\n        dirty = True : canvas.Invalidate() : UpdateTitle()\n    End Sub\n\n    Private Sub FlipVertical(sender As Object, e As EventArgs)\n        workingBitmap.RotateFlip(RotateFlipType.RotateNoneFlipY)\n        dirty = True : canvas.Invalidate() : UpdateTitle()\n    End Sub\n\n    Private Sub ShowAbout(sender As Object, e As EventArgs)\n        MessageBox.Show(\"Paint 1.0\" & Environment.NewLine & \"Exemplo FlowForge inspirado no Paint do Windows 9x.\", \"Sobre\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n    End Sub\n\n    Private Sub ExitApp(sender As Object, e As EventArgs)\n        Me.Close()\n    End Sub\n\n    Private Function ConfirmDiscard() As Boolean\n        If Not dirty Then Return True\n        Dim r As DialogResult = MessageBox.Show(\"Salvar alterações?\", \"Paint\", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)\n        If r = DialogResult.Cancel Then Return False\n        If r = DialogResult.Yes Then\n            SaveImage(Me, EventArgs.Empty)\n            If dirty Then Return False\n        End If\n        Return True\n    End Function\n\n    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs)\n        If Not ConfirmDiscard() Then e.Cancel = True\n    End Sub\n\n    Private Sub UpdateTitle()\n        Dim name As String = If(currentFile = \"\", \"Sem título\", System.IO.Path.GetFileName(currentFile))\n        Me.Text = name & If(dirty, \" *\", \"\") & \" - Paint\"\n    End Sub\n\nEnd Class\n"
    }
  ],
  "Classes": [],
  "Modules": [],
