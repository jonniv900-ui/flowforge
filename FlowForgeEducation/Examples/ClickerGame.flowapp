{"ApplicationIcon":"","AssemblyCompany":"Wtec","AssemblyCopyright":"Copyright © 2026","AssemblyDescription":"Jogo de reflexo e velocidade em Windows Forms","AssemblyProduct":"Desafio do Clique","AssemblyTitle":"Desafio do Clique","AssemblyTrademark":"","AssemblyVersion":"1.0.0.0","FileVersion":"1.0.0.0","Forms":[{"Code":"Imports System\nImports System.Drawing\nImports System.Windows.Forms\n\nPartial Public Class Form1\n\n    Private cliques As Integer = 0\n    Private tempoRestante As Integer = 10\n    Private jogoAtivo As Boolean = False\n\n    Private Sub Form1_Load() Handles MyBase.Load\n        ButtonClique.Enabled = False\n    End Sub\n\n    Private Sub ButtonIniciar_Click() Handles ButtonIniciar.Click\n        cliques = 0\n        tempoRestante = 10\n        jogoAtivo = True\n        \n        LabelPlacar.Text = \"Cliques: 0\"\n        LabelTempo.Text = \"Tempo: 10s\"\n        \n        ButtonIniciar.Enabled = False\n        ButtonClique.Enabled = True\n        ButtonClique.Text = \"CLIQUE RÁPIDO!\"\n        \n        GameTimer.Start()\n    End Sub\n\n    Private Sub ButtonClique_Click() Handles ButtonClique.Click\n        If jogoAtivo Then\n            cliques += 1\n            LabelPlacar.Text = \"Cliques: \" & cliques\n        End If\n    End Sub\n\n    Private Sub GameTimer_Tick() Handles GameTimer.Tick\n        tempoRestante -= 1\n        LabelTempo.Text = \"Tempo: \" & tempoRestante & \"s\"\n\n        If tempoRestante <= 0 Then\n            GameTimer.Stop()\n            jogoAtivo = False\n            ButtonClique.Enabled = False\n            ButtonIniciar.Enabled = True\n            ButtonIniciar.Text = \"Jogar Novamente\"\n            ButtonClique.Text = \"Fim de Jogo!\"\n            \n            MessageBox.Show(\"Fim de tempo! Você conseguiu \" & cliques & \" cliques em 10 segundos.\", \"Resultado\", MessageBoxButtons.OK, MessageBoxIcon.Information)\n        End If\n    End Sub\n\nEnd Class","Controls":[{"AssemblyPath":"","IsNonVisual":false,"Items":[